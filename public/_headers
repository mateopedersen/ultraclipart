/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), web-share=(self)
  Strict-Transport-Security: max-age=31536000
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' https://assets.ultraclipart.com data: blob:; font-src 'self'; connect-src 'self' https://assets.ultraclipart.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self' mailto:
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/og/*
  Cache-Control: public, max-age=31536000, immutable
/related-release.json
  Cache-Control: no-store
/surprise-picks.json
  Cache-Control: no-store
/collection-feed.json
  Cache-Control: no-store
/catalog-stats.json
  Cache-Control: no-store
/api/cookie-region.json
  Cache-Control: private, no-store, max-age=0
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store
/search-data/manifest.json
  Cache-Control: no-cache, must-revalidate
/previews/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/inter/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/source-sans-3/source-sans-3-latin-19143dca0759.woff2
  Cache-Control: public, max-age=31536000, immutable
/studio-catalog.json
  Cache-Control: no-cache, must-revalidate
/studio-featured.json
  Cache-Control: no-cache, must-revalidate
/studio-previews/*
  Cache-Control: public, max-age=31536000, immutable

/category-search/*
  Cache-Control: public, max-age=31536000, immutable
