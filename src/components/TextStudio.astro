---
import { textStyles, textStyleCategories } from '../editor/text-styles';
---

<label>
  Your text<textarea data-text rows="3" maxlength="500" placeholder="Enter your text"></textarea>
</label>
<details class="uc-control-details uc-text-style-library" data-text-style-picker>
  <summary>
    <span data-text-chosen-style>Choose a Text Style</span>
    <small>{textStyles.length} Styles</small>
  </summary>
  <p class="uc-hint">
    Choose a style for your text. You can edit the words, font and colors afterward.
  </p>
  <label>
    Find a Style
    <input data-text-style-search type="search" placeholder="Outline, retro, curved…" />
  </label>
  <label>
    Style Collection
    <select data-text-style-category>
      <option value="">All Styles</option>
      {textStyleCategories.map((name) => (
        <option value={name}>{name}</option>
      ))}
    </select>
  </label>
  <div class="uc-text-presets" data-text-style-grid></div>
  <div class="uc-library-pagination">
    <button data-text-style-previous type="button">
      Previous
    </button>
    <span data-text-style-count aria-live="polite"></span>
    <button data-text-style-next type="button">
      Next
    </button>
  </div>
</details>
<div class="uc-text-actions">
  <button class="uc-primary" data-action="text">
    Add / update text
  </button>
  <button data-action="new-text">Add as new layer</button>
</div>

<div class="uc-row">
  <label>
    Typeface
    <select data-text-font>
      <option value="sans">Modern sans</option>
      <option value="serif">Classic serif</option>
      <option value="mono">Typewriter</option>
    </select>
  </label>
  <label>
    Font size
    <input data-text-size type="number" min="8" max="300" value="48" />
  </label>
</div>
<div class="uc-text-toggles">
  <label class="uc-check">
    <input data-text-bold type="checkbox" />
    <b>Bold</b>
  </label>
  <label class="uc-check">
    <input data-text-italic type="checkbox" />
    <i>Italic</i>
  </label>
</div>
<div class="uc-row">
  <label>
    Text color
    <input data-text-color type="color" value="#17274f" />
  </label>
  <label>
    Decoration
    <select data-text-decoration>
      <option value="none">None</option>
      <option value="underline">Underline</option>
      <option value="strike">Strike through</option>
    </select>
  </label>
</div>
<div class="uc-row">
  <label>
    Alignment
    <select data-text-align>
      <option value="start">Left</option>
      <option value="middle">Center</option>
      <option value="end">Right</option>
    </select>
  </label>
  <label>
    Text path
    <select data-text-layout>
      <option value="straight">Straight</option>
      <option value="arc">Curve</option>
      <option value="circle">Full circle</option>
    </select>
  </label>
</div>
<div class="uc-row">
  <label>
    Letter spacing
    <input data-text-spacing type="number" min="-20" max="100" step="0.5" value="0" />
  </label>
  <label>
    Line height
    <input data-text-line-height type="number" min="0.5" max="3" step="0.1" value="1.2" />
  </label>
</div>
<label data-text-radius-label hidden>
  Curve radius
  <input data-text-radius type="number" min="20" max="4000" value="150" />
</label>
<details class="uc-control-details">
  <summary>Outline &amp; shadow</summary>
  <div class="uc-row">
    <label>
      Outline color
      <input data-text-stroke type="color" value="#ffffff" />
    </label>
    <label>
      Outline width
      <input data-text-stroke-width type="number" min="0" max="20" step="0.5" value="0" />
    </label>
  </div>
  <label class="uc-check">
    <input data-text-shadow type="checkbox" /> Soft offset shadow
  </label>
</details>

<p class="uc-hint">
  Text stays editable in your project. Image exports support your browser’s characters; PDF uses
  standard Latin print fonts. Check the print proof for font differences.
</p>
