---
interface Props {
  name:
    | 'transparent'
    | 'white'
    | 'blue'
    | 'dark'
    | 'palette'
    | 'subject'
    | 'style'
    | 'dimensions'
    | 'formats';
  id: string;
  size?: number;
}
const { name, id, size = 64 } = Astro.props;
const surface =
  name === 'blue'
    ? ['#d6ebff', '#8abcee', '#507daf']
    : name === 'dark'
      ? ['#425774', '#1f304a', '#111e32']
      : ['#ffffff', '#e6edf5', '#a8bacf'];
const tile = ['transparent', 'white', 'blue', 'dark'].includes(name);
---

<svg
  width={size}
  height={size}
  viewBox="0 0 80 80"
  fill="none"
  aria-hidden="true"
  focusable="false"
  class="artwork-symbol"
>
  <defs>
    <linearGradient
      id={`${id}-paper`}
      x1="18"
      y1="10"
      x2="64"
      y2="65"
      gradientUnits="userSpaceOnUse"
    >
      <stop stop-color={surface[0]} />
      <stop offset="1" stop-color={surface[1]} />
    </linearGradient>
    <linearGradient
      id={`${id}-blue`}
      x1="15"
      y1="22"
      x2="62"
      y2="69"
      gradientUnits="userSpaceOnUse"
    >
      <stop stop-color="#80baff" />
      <stop offset="1" stop-color="#2364b0" />
    </linearGradient>
    <linearGradient id={`${id}-wood`} x1="48" y1="8" x2="63" y2="16" gradientUnits="userSpaceOnUse">
      <stop stop-color="#ffdf8c" />
      <stop offset=".45" stop-color="#efb951" />
      <stop offset="1" stop-color="#c38b35" />
    </linearGradient>
    <pattern id={`${id}-check`} width="14" height="14" patternUnits="userSpaceOnUse">
      <path fill="#fff" d="M0 0h14v14H0z" />
      <path fill="#b7c7d8" d="M0 0h7v7H0zm7 7h7v7H7z" />
    </pattern>
    <filter id={`${id}-shadow`} x="-40%" y="-40%" width="190%" height="200%">
      <feDropShadow dx="0" dy="4" stdDeviation="3" flood-color="#233c5c" flood-opacity=".15" />
    </filter>
  </defs>
  {tile && (
    <>
      <ellipse cx="41" cy="69" rx="28" ry="5" fill="#263c55" opacity=".10" />
      <g transform="rotate(-11 40 39)" filter={`url(#${id}-shadow)`}>
        <rect x="15" y="20" width="51" height="45" rx="11" fill={surface[2]} />
        <rect
          x="14"
          y="14"
          width="52"
          height="46"
          rx="11"
          fill={`url(#${id}-paper)`}
          stroke={name === 'dark' ? '#24344e' : '#c6d5e5'}
          stroke-width="1.2"
        />
        {name === 'transparent' && (
          <rect x="15" y="15" width="50" height="44" rx="10" fill={`url(#${id}-check)`} />
        )}
        <path
          d="M24 17h31a8 8 0 0 1 8 8"
          stroke="white"
          stroke-width="2"
          stroke-linecap="round"
          opacity={name === 'dark' ? '.25' : '.9'}
        />
        <path
          d="M19 55a8 8 0 0 0 6 3h29"
          stroke={name === 'dark' ? '#6a80a1' : '#fff'}
          stroke-width="1.3"
          opacity=".6"
        />
      </g>
    </>
  )}
  {(name === 'palette' || name === 'style') && (
    <>
      <ellipse cx="40" cy="69" rx="29" ry="5" fill="#263c55" opacity=".10" />
      <g filter={`url(#${id}-shadow)`}>
        <path
          d="M13 33c2-15 25-24 41-14 17 11 16 29 6 37-7 5-12-1-15 1-4 3 2 8-6 10-14 2-29-18-26-34Z"
          fill="#b1bfd0"
        />
        <path
          d="M13 29c2-15 25-24 41-14 17 11 16 29 6 37-7 5-12-1-15 1-4 3 2 8-6 10-14 2-29-18-26-34Z"
          fill="#fffaf0"
          stroke="#d1c8b5"
        />
        <ellipse
          cx="34"
          cy="49"
          rx="5"
          ry="7"
          transform="rotate(-30 34 49)"
          fill="#e2e8ef"
          stroke="#b3c0d0"
        />
        <circle cx="24" cy="30" r="6.7" fill="#c34c48" />
        <circle cx="24" cy="28" r="5.8" fill="#ed8374" />
        <circle cx="40" cy="22" r="6.7" fill="#c39b39" />
        <circle cx="40" cy="20" r="5.8" fill="#f1c96b" />
        <circle cx="55" cy="33" r="6.7" fill="#348479" />
        <circle cx="55" cy="31" r="5.8" fill="#73bda7" />
        <circle cx="57" cy="47" r="5.8" fill="#376aab" />
        <circle cx="57" cy="45" r="5" fill="#82b3e9" />
        <path
          d="m53 13 7-8 5 4-6 9-19 31-5 2 1-6Z"
          fill={`url(#${id}-wood)`}
          stroke="#bc8c43"
          stroke-width=".7"
        />
        <path d="m36 44 6 4-7 7-6 2 2-7Z" fill="#34455b" />
        <path d="m31 51 4 3-6 3Z" fill="#11263a" />
        <path d="m55 12 5 4" stroke="#fff0c9" stroke-width="2" />
      </g>
    </>
  )}
  {name === 'subject' && (
    <>
      <ellipse cx="40" cy="68" rx="30" ry="5" fill="#304c6b" opacity=".10" />
      <path d="M10 27a6 6 0 0 1 6-6h14l6 6h28a5 5 0 0 1 5 5v28H10Z" fill="#b39a69" />
      <path
        d="M10 24a6 6 0 0 1 6-6h14l6 6h28a5 5 0 0 1 5 5v28H10Z"
        fill="#f2dba8"
        stroke="#d1b581"
      />
      <g transform="rotate(-12 37 36)">
        <rect x="20" y="12" width="34" height="44" rx="4" fill="#d5e2ef" />
        <rect x="20" y="9" width="34" height="44" rx="4" fill="white" stroke="#d4dfeb" />
        <rect x="25" y="14" width="24" height="21" rx="3" fill="#e9f3ed" />
        <path d="m27 32 7-9 5 6 4-4 5 7Z" fill="#74a99c" />
        <circle cx="43" cy="20" r="3" fill="#edc578" />
      </g>
      <path
        d="M9 35h61l-5 27a5 5 0 0 1-5 4H17a5 5 0 0 1-5-4Z"
        fill={`url(#${id}-blue)`}
        stroke="#5289c8"
      />
      <path d="M14 38h49" stroke="#b4d7ff" stroke-width="2" stroke-linecap="round" />
      <rect x="29" y="47" width="20" height="5" rx="2.5" fill="#e9f4ff" opacity=".9" />
    </>
  )}
  {name === 'dimensions' && (
    <>
      <ellipse cx="43" cy="68" rx="27" ry="5" fill="#304c6b" opacity=".1" />
      <g transform="rotate(-8 42 34)" filter={`url(#${id}-shadow)`}>
        <rect x="22" y="14" width="45" height="44" rx="7" fill="#9ab1c8" />
        <rect x="22" y="10" width="45" height="44" rx="7" fill="white" stroke="#c5d4e4" />
        <rect x="27" y="15" width="35" height="29" rx="4" fill="#deedf7" />
        <path d="m29 42 12-15 7 9 5-5 7 11Z" fill="#66a498" />
        <circle cx="54" cy="23" r="4" fill="#efc46b" />
      </g>
      <path
        d="M10 15v48h51"
        stroke="#8aa6c7"
        stroke-width="8"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <path
        d="M10 15v45h51"
        stroke="#d5e3f1"
        stroke-width="7"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <path
        d="M9 24h4m-4 10h4m-4 10h4m10 14v4m10-4v4m10-4v4m10-4v4"
        stroke="#5b7798"
        stroke-width="1.5"
      />
    </>
  )}
  {name === 'formats' && (
    <>
      <ellipse cx="39" cy="68" rx="29" ry="5" fill="#304c6b" opacity=".1" />
      <g transform="rotate(9 49 36)" filter={`url(#${id}-shadow)`}>
        <path
          d="M34 11h20l13 13v37a4 4 0 0 1-4 4H34a4 4 0 0 1-4-4V15a4 4 0 0 1 4-4Z"
          fill="#aebed1"
        />
        <path
          d="M34 8h20l13 13v37a4 4 0 0 1-4 4H34a4 4 0 0 1-4-4V12a4 4 0 0 1 4-4Z"
          fill="white"
          stroke="#d1deeb"
        />
        <path d="M54 8v10a3 3 0 0 0 3 3h10" fill="#dbe7f4" />
        <path d="M38 44h20m-20 6h14" stroke="#adbdcf" stroke-width="2.5" stroke-linecap="round" />
        <rect x="37" y="26" width="22" height="12" rx="3" fill="#d37a76" />
      </g>
      <g transform="rotate(-9 28 41)">
        <rect x="10" y="21" width="36" height="42" rx="5" fill="#8ca9ba" />
        <rect x="10" y="17" width="36" height="42" rx="5" fill="white" stroke="#c8d8e5" />
        <rect x="14" y="21" width="28" height="24" rx="3" fill={`url(#${id}-check)`} />
        <path d="m18 40 8-10 5 7 5-3 5 8Z" fill="#5eaa92" />
        <circle cx="35" cy="27" r="3" fill="#efc66e" />
        <path d="M17 51h20" stroke="#a8bdd0" stroke-width="2" stroke-linecap="round" />
      </g>
    </>
  )}
</svg>
