---
export type GuideSymbolKind =
  | 'slides'
  | 'steps'
  | 'book'
  | 'files'
  | 'help'
  | 'download'
  | 'edit'
  | 'print'
  | 'boards'
  | 'label'
  | 'botanical';
interface Props {
  kind: GuideSymbolKind;
  id: string;
  size?: number;
}
const { kind, id, size = 48 } = Astro.props;
const paint = (name: string) => `url(#${id}-${name})`;
---

<svg
  class="guide-symbol"
  width={size}
  height={Math.round(size * 0.92)}
  viewBox="0 0 96 88"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient
      id={`${id}-paper`}
      x1="27"
      y1="12"
      x2="74"
      y2="73"
      gradientUnits="userSpaceOnUse"
    >
      <stop stop-color="#fff" />
      <stop offset=".6" stop-color="#f7f9fc" />
      <stop offset="1" stop-color="#d4dee9" />
    </linearGradient>
    <linearGradient
      id={`${id}-metal`}
      x1="26"
      y1="15"
      x2="47"
      y2="57"
      gradientUnits="userSpaceOnUse"
    >
      <stop stop-color="#fff" />
      <stop offset=".2" stop-color="#c7d0dc" />
      <stop offset=".42" stop-color="#f6f8fb" />
      <stop offset=".65" stop-color="#9fabbc" />
      <stop offset=".82" stop-color="#dae2ec" />
      <stop offset="1" stop-color="#7d8b9f" />
    </linearGradient>
    <linearGradient
      id={`${id}-blue`}
      x1="25"
      y1="16"
      x2="75"
      y2="72"
      gradientUnits="userSpaceOnUse"
    >
      <stop stop-color="#6498d0" />
      <stop offset=".48" stop-color="#34699f" />
      <stop offset="1" stop-color="#173f6a" />
    </linearGradient>
    <linearGradient
      id={`${id}-edge`}
      x1="20"
      y1="18"
      x2="80"
      y2="77"
      gradientUnits="userSpaceOnUse"
    >
      <stop stop-color="#9aaec5" />
      <stop offset="1" stop-color="#53677f" />
    </linearGradient>
    <linearGradient
      id={`${id}-gold`}
      x1="40"
      y1="15"
      x2="66"
      y2="53"
      gradientUnits="userSpaceOnUse"
    >
      <stop stop-color="#f4ddaa" />
      <stop offset=".4" stop-color="#d1ae65" />
      <stop offset=".58" stop-color="#f6e5be" />
      <stop offset="1" stop-color="#a27b39" />
    </linearGradient>
    <linearGradient
      id={`${id}-leaf`}
      x1="31"
      y1="24"
      x2="67"
      y2="61"
      gradientUnits="userSpaceOnUse"
    >
      <stop stop-color="#8fae79" />
      <stop offset=".4" stop-color="#50764d" />
      <stop offset="1" stop-color="#294e36" />
    </linearGradient>
    <radialGradient id={`${id}-shadow`}>
      <stop stop-color="#1a2e47" stop-opacity=".23" />
      <stop offset="1" stop-color="#1a2e47" stop-opacity="0" />
    </radialGradient>
    <filter id={`${id}-lift`} x="-25%" y="-20%" width="160%" height="160%">
      <feDropShadow dx="1" dy="2" stdDeviation="1.2" flood-color="#1e3552" flood-opacity=".16" />
    </filter>
  </defs>
  <ellipse cx="49" cy="77" rx="36" ry="7" fill={paint('shadow')} />
  {kind === 'slides' && (
    <g filter={paint('lift')}>
      <path d="M41 60h15l2 12H39z" fill={paint('metal')} stroke="#8595a9" stroke-width=".7" />
      <path d="M34 72h29l8 4H27z" fill={paint('edge')} />
      <path d="M34 70h29l8 4H27z" fill={paint('metal')} stroke="#a4b2c4" stroke-width=".7" />
      <rect x="13" y="11" width="73" height="51" rx="5" fill="#55677e" />
      <rect x="10" y="8" width="73" height="51" rx="5" fill={paint('metal')} stroke="#8b9db4" />
      <rect x="14" y="12" width="65" height="40" rx="2" fill="#274e78" />
      <rect x="17" y="15" width="59" height="34" rx="1" fill={paint('paper')} />
      <rect x="22" y="21" width="26" height="3" rx="1" fill="#41688d" />
      <path
        d="M22 30h25m-25 5h19m-19 5h14"
        stroke="#acbbcb"
        stroke-width="2"
        stroke-linecap="round"
      />
      <rect x="53" y="26" width="17" height="17" rx="2" fill="#d9e8ed" />
      <path d="m55 40 5-8 4 5 3-3 2 6" fill="#7ca38a" />
      <circle cx="66" cy="30" r="2" fill={paint('gold')} />
      <path d="M13 10h67" stroke="white" stroke-width=".8" />
      <circle cx="47" cy="55" r="1.2" fill="#6f839c" />
    </g>
  )}
  {kind === 'steps' && (
    <g filter={paint('lift')}>
      <rect x="24" y="13" width="51" height="63" rx="5" fill={paint('edge')} />
      <rect x="21" y="10" width="51" height="63" rx="5" fill={paint('blue')} stroke="#42668e" />
      <rect x="26" y="16" width="40" height="51" rx="2" fill={paint('paper')} stroke="#d5dde8" />
      <path
        d="M38 8v-2a7 7 0 0 1 14 0v2h4v11H34V8z"
        fill={paint('metal')}
        stroke="#8b9aaf"
        stroke-width=".8"
      />
      <path d="M41 8V6a4 4 0 0 1 8 0v2" stroke="#8798ad" stroke-width="1.5" />
      <path d="M37 10h16" stroke="white" stroke-opacity=".9" />
      {[30, 43, 56].map((y) => (
        <>
          <rect
            x="31"
            y={y}
            width="7"
            height="7"
            rx="1"
            fill="#e1ebe7"
            stroke="#a1b7ac"
            stroke-width=".7"
          />
          <path
            d={`m32 ${y + 3} 2 2 4-5`}
            stroke="#45745d"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <path
            d={`M44 ${y + 2}h15m-15 3h11`}
            stroke="#92a3b7"
            stroke-width="1.2"
            stroke-linecap="round"
          />
        </>
      ))}
      <path d="M24 17v49" stroke="#a4bfdc" stroke-opacity=".7" />
    </g>
  )}
  {kind === 'book' && (
    <g filter={paint('lift')}>
      <path d="m12 23 33 3 38-6v49l-36 8-35-7z" fill="#213e60" />
      <path d="m12 20 34 4 37-7v48l-36 8-35-7z" fill={paint('blue')} stroke="#3d628a" />
      <path
        d="M17 16c10-3 22-1 29 5 11-7 22-9 32-9v48c-11-1-21 1-31 7-11-6-21-7-30-5z"
        fill="#b1becf"
      />
      <path
        d="M17 13c10-3 22-1 29 5 11-7 22-9 32-9v48c-11-1-21 1-31 7-11-6-21-7-30-5z"
        fill={paint('paper')}
        stroke="#cad4e0"
      />
      <path d="M46 18v46" stroke="#a8b7c9" stroke-width="1.4" />
      <path d="M44 20v39" stroke="white" stroke-width="1.5" />
      <path d="m55 16 10-3v29l-5-3-5 6z" fill={paint('gold')} stroke="#b49961" stroke-width=".5" />
      <path
        d="m22 24 17 2m-17 6 17 2m-17 6 17 2m-17 6 17 2m14-2 18-4m-18 11 18-4"
        stroke="#a5b4c6"
        stroke-width="1.1"
        stroke-linecap="round"
      />
      <path d="m20 64 25 6m6-1 25-6" stroke="#c7d3df" stroke-width=".8" />
    </g>
  )}
  {kind === 'files' && (
    <g filter={paint('lift')}>
      <g transform="rotate(10 58 43)">
        <path d="M38 10h27l13 13v45H38z" fill={paint('edge')} />
        <path d="M36 7h27l13 13v45H36z" fill={paint('paper')} stroke="#b2c0d1" />
        <path d="M63 7v14h13" fill="#d9e3ed" stroke="#bac8d8" />
      </g>
      <g transform="rotate(-8 40 47)">
        <path d="M20 21h30l12 12v42H20z" fill="#8ca2ba" />
        <path d="M18 18h30l12 12v42H18z" fill={paint('paper')} stroke="#b2c0d1" />
        <path d="M48 18v13h12" fill="#d6e1ed" stroke="#bac8d8" />
        <rect x="26" y="37" width="26" height="19" rx="2" fill={paint('blue')} />
        <circle cx="45" cy="43" r="3" fill="#e8c986" />
        <path d="m28 53 7-10 7 8 4-5 4 7" fill="#dce8f2" />
        <path d="M26 63h25" stroke="#a1b4c9" stroke-width="2" stroke-linecap="round" />
      </g>
    </g>
  )}
  {kind === 'help' && (
    <g filter={paint('lift')}>
      <path
        d="M18 17h55a7 7 0 0 1 7 7v37a7 7 0 0 1-7 7H42L27 78l3-10H18a7 7 0 0 1-7-7V24a7 7 0 0 1 7-7"
        fill={paint('edge')}
      />
      <path
        d="M17 13h54a7 7 0 0 1 7 7v36a7 7 0 0 1-7 7H40L25 73l3-10H17a7 7 0 0 1-7-7V20a7 7 0 0 1 7-7"
        fill={paint('metal')}
        stroke="#98aabd"
      />
      <path d="M18 16h51a5 5 0 0 1 5 5" stroke="white" stroke-width="1.8" stroke-linecap="round" />
      <circle cx="45" cy="38" r="19" fill={paint('blue')} stroke="#295783" />
      <path
        d="M39 32a6 6 0 0 1 12 0c0 4-6 4-6 9"
        stroke="#f5f8fc"
        stroke-width="3.4"
        stroke-linecap="round"
      />
      <circle cx="45" cy="48" r="1.9" fill="#f5f8fc" />
      <path
        d="M32 28a16 16 0 0 1 21-3"
        stroke="#bcd4ed"
        stroke-width="1.1"
        stroke-opacity=".55"
        stroke-linecap="round"
      />
    </g>
  )}
  {kind === 'download' && (
    <g filter={paint('lift')}>
      <path d="m16 53 12-15h41l12 16v19H16z" fill="#8095ad" />
      <path d="m14 50 13-14h41l12 15v19H14z" fill={paint('metal')} stroke="#96a9bf" />
      <path d="M27 41h40l5 10H22z" fill="#264866" />
      <path d="M21 51h14l4 7h17l4-7h13v14H21z" fill={paint('paper')} stroke="#b8c6d5" />
      <path d="M41 9h14v25h12L48 53 29 34h12z" fill="#1e4a77" />
      <path d="M39 6h14v25h12L46 50 27 31h12z" fill={paint('blue')} />
      <path d="M40 7h10v25h11" stroke="#a6c8ea" stroke-width="1.4" stroke-linejoin="round" />
      <path d="m65 31 2 3-19 19-2-3z" fill="#183d64" />
      <path d="M18 67h56" stroke="#edf3f9" stroke-width="1.2" />
      <circle cx="69" cy="59" r="1.6" fill="#6c9b82" />
    </g>
  )}
  {kind === 'edit' && (
    <g filter={paint('lift')}>
      <path d="M18 20h46l10 10v44H18z" fill="#a7b6c9" />
      <path d="M16 17h46l10 10v44H16z" fill={paint('paper')} stroke="#b7c5d7" />
      <path d="M62 17v11h10" fill="#d6e1ed" />
      <path
        d="M25 33h25m-25 9h18m-18 9h14"
        stroke="#a0b3ca"
        stroke-width="1.6"
        stroke-linecap="round"
      />
      <g transform="rotate(39 62 39)">
        <rect x="58" y="9" width="12" height="45" rx="2" fill="#8795a6" />
        <rect
          x="55"
          y="7"
          width="12"
          height="45"
          rx="2"
          fill={paint('metal')}
          stroke="#879aaf"
          stroke-width=".6"
        />
        <rect x="55" y="12" width="12" height="13" fill={paint('blue')} />
        <path d="M55 52h12l-6 16z" fill={paint('gold')} stroke="#ad8a4d" stroke-width=".6" />
        <path d="m61 68-2-6h4z" fill="#263b55" />
        <path d="M58 27v22" stroke="#f8fbff" stroke-width="1.5" />
        <path d="M61 55v8" stroke="#735e3d" stroke-width=".6" />
      </g>
      <path d="M26 62c9-10 10 5 21-1" stroke="#476d95" stroke-width="1.4" stroke-linecap="round" />
    </g>
  )}
  {kind === 'print' && (
    <g filter={paint('lift')}>
      <path d="m15 34 12-9h44l11 10-12 10H26z" fill={paint('metal')} stroke="#a4b4c7" />
      <path d="M30 7h35l4 33H26z" fill="#a2b1c3" />
      <path d="M28 5h35l4 32H24z" fill={paint('paper')} stroke="#b8c7d8" />
      <path d="M35 14h21m-20 5h20" stroke="#aebed0" stroke-width="1.4" stroke-linecap="round" />
      <path d="m14 34 12 8h44l12-7v29l-12 8H26l-12-8z" fill={paint('metal')} stroke="#97aabf" />
      <path d="m70 42 12-7v29l-12 8z" fill="#8e9fb5" />
      <path d="M26 43h44v25H26z" fill={paint('blue')} />
      <path d="M32 51h34v7H32z" fill="#18334e" />
      <path d="M34 54h29l5 22H29z" fill="#a3b3c5" />
      <path d="M33 52h29l5 21H28z" fill={paint('paper')} stroke="#b8c7d8" />
      <path d="M36 59h21m-22 5h24" stroke="#a6bbd0" stroke-width="1.5" stroke-linecap="round" />
      <rect x="67" y="34" width="6" height="2" rx="1" fill="#5c8b73" />
      <path d="m17 36 10 7h40" stroke="white" stroke-width="1.1" stroke-opacity=".8" />
    </g>
  )}
  {kind === 'boards' && (
    <g filter={paint('lift')}>
      <path d="M17 22h26l7 7h29v44H17z" fill="#a78a52" />
      <path d="M15 19h26l7 7h29v44H15z" fill={paint('gold')} stroke="#b79f70" />
      <g transform="rotate(8 59 40)">
        <rect x="43" y="12" width="29" height="39" rx="2" fill={paint('paper')} stroke="#b4c4d7" />
        <rect x="48" y="18" width="19" height="23" rx="1" fill="#d6e3d9" />
        <path d="m51 37 6-13 7 13" stroke="#6a8d68" stroke-width="2" stroke-linecap="round" />
      </g>
      <g transform="rotate(-8 35 42)">
        <rect x="21" y="21" width="29" height="37" rx="2" fill={paint('paper')} stroke="#b4c4d7" />
        <rect x="26" y="27" width="19" height="22" rx="1" fill="#c4d9ec" />
        <circle cx="40" cy="32" r="3" fill="#ead6a8" />
        <path d="m28 46 7-11 7 11" fill="#6d92b5" />
      </g>
      <path d="M12 46h69l-5 28H17z" fill="#183d63" />
      <path d="M11 43h69l-5 28H16z" fill={paint('blue')} stroke="#315d8c" />
      <path d="M14 45h63" stroke="#9cbfe1" stroke-width="1.2" />
      <rect x="33" y="52" width="24" height="6" rx="3" fill="#dbe7f3" />
      <path d="M18 67h54" stroke="#173c64" stroke-opacity=".4" />
    </g>
  )}
  {kind === 'label' && (
    <g filter={paint('lift')}>
      <g transform="rotate(-7 46 45)">
        <rect x="10" y="23" width="69" height="44" rx="5" fill="#91a5bf" />
        <rect x="8" y="20" width="69" height="44" rx="5" fill={paint('metal')} stroke="#9aaec5" />
        <rect x="14" y="26" width="57" height="32" rx="2" fill={paint('paper')} stroke="#c2cede" />
        <rect x="20" y="32" width="7" height="7" rx="1" fill={paint('blue')} />
        <path
          d="M33 35h28M20 45h41m-41 6h29"
          stroke="#819ab5"
          stroke-width="1.8"
          stroke-linecap="round"
        />
        <path d="M12 23h59" stroke="white" stroke-width="1.2" />
      </g>
      <g transform="rotate(21 76 46)">
        <path d="M71 16h8v47l-4 12-4-12z" fill={paint('gold')} stroke="#ae8c50" stroke-width=".7" />
        <path d="M75 19v43" stroke="#f8e9c8" stroke-width="1.4" />
        <path d="m72 63 3 10 3-10" fill="#e4d2ad" />
        <path d="m74 70 1 4 1-4" fill="#33445a" />
      </g>
    </g>
  )}
  {kind === 'botanical' && (
    <g filter={paint('lift')}>
      <path d="M19 9h44l13 13v53H19z" fill="#a6b4c5" />
      <path d="M17 7h44l13 13v52H17z" fill={paint('paper')} stroke="#b8c6d6" />
      <path d="M61 7v14h13" fill="#d7e1ed" stroke="#b8c6d6" />
      <path
        d="M37 61c3-12 10-22 19-34"
        stroke="#597453"
        stroke-width="1.4"
        stroke-linecap="round"
      />
      <path
        d="M43 48c-12-1-16-7-16-14 9 0 16 3 16 14"
        fill={paint('leaf')}
        stroke="#54724f"
        stroke-width=".5"
      />
      <path
        d="M49 39c0-11 6-16 15-17-1 10-6 15-15 17"
        fill={paint('leaf')}
        stroke="#54724f"
        stroke-width=".5"
      />
      <path
        d="M39 55c10 0 16-5 20-13-10-1-17 3-20 13"
        fill={paint('leaf')}
        stroke="#54724f"
        stroke-width=".5"
      />
      <path
        d="m29 36 14 12m8-12 10-11m-19 28 14-9"
        stroke="#c3d1a8"
        stroke-width=".8"
        stroke-linecap="round"
      />
      <path d="M30 67h28" stroke="#c1cddb" stroke-width="1.5" stroke-linecap="round" />
      <g transform="rotate(27 73 52)">
        <path d="M69 28h8v36l-4 13-4-13z" fill={paint('gold')} stroke="#ab8b4f" stroke-width=".6" />
        <path d="M69 28h8v8h-8z" fill={paint('metal')} />
        <path d="M72 39v23" stroke="#f3e4bf" stroke-width="1.3" />
        <path d="m70 64 3 11 3-11" fill="#e9d7b0" />
        <path d="m72 72 1 4 1-4" fill="#2f4932" />
      </g>
    </g>
  )}
</svg>
<style>
  .guide-symbol {
    display: block;
    flex-shrink: 0;
    overflow: visible;
  }
</style>
