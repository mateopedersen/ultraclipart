---
interface Props {
  light?: boolean;
  size?: number;
}
const { size = 29, light = false } = Astro.props;
---

<svg
  class="teacher-arrow"
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <path
    d="M5 17h21m-8-8 8 8-8 8"
    stroke={light ? '#0b2b49' : '#103454'}
    stroke-opacity={light ? '.3' : '.16'}
    stroke-width="3.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <path
    d="M5 15.5h21m-8-8 8 8-8 8"
    stroke="currentColor"
    stroke-width="2.7"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
</svg>
<style>
  .teacher-arrow {
    display: block;
    flex-shrink: 0;
    overflow: visible;
  }
</style>
