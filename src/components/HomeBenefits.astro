---
import HomeBenefitVisual from './HomeBenefitVisual.astro';
const benefits = [
  {
    kind: 'license' as const,
    title: 'Personal & Classroom Use',
    body: 'Catalog artwork is free for personal and educational projects. Read the license for usage limits.',
    href: '/license/',
    link: 'Read the License',
  },
  {
    kind: 'formats' as const,
    title: 'Image & PDF Downloads',
    body: 'Choose a WebP image for compatible apps or a PDF for printing. Check the file details before downloading.',
    href: '/guides/webp-pdf-and-editable-projects/',
    link: 'Compare File Formats',
  },
  {
    kind: 'studio' as const,
    title: 'Edit in Clipart Studio',
    body: 'Arrange illustrations, add text and adjust your layout in the browser. No account is needed.',
    href: '/create/',
    link: 'Open Clipart Studio',
  },
  {
    kind: 'privacy' as const,
    title: 'Projects & Privacy',
    body: 'Save an editable project to keep your layers. Creating a public share link is a separate, optional step.',
    href: '/privacy/',
    link: 'Read the Privacy Policy',
  },
];
---

<section class="home-benefits" aria-labelledby="home-benefits-title">
  <div class="home-benefits-heading">
    <h2 id="home-benefits-title">Using UltraClipart</h2>
    <p>A guide to downloads, editing and using the artwork in your projects.</p>
  </div>
  <div class="home-benefits-grid">
    {benefits.map((benefit) => (
      <a class={`home-benefit home-benefit-${benefit.kind}`} href={benefit.href}>
        <div class="home-benefit-art">
          <HomeBenefitVisual kind={benefit.kind} />
        </div>
        <div class="home-benefit-copy">
          <h3>{benefit.title}</h3>
          <p class="home-benefit-body">{benefit.body}</p>
          <span class="home-benefit-link">{benefit.link}</span>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .home-benefits {
    --benefit-gap: 24px;
    margin: 0;
    padding: var(--benefit-gap);
    padding-bottom: calc(var(--benefit-gap) + 5px);
    border: 1px solid #dce7f5;
    border-radius: 26px;
    background: #f5f7fa;
    box-shadow: inset 0 2px #fff;
  }
  .home-benefits-heading {
    display: grid;
    justify-items: center;
    gap: 12px;
    max-width: 640px;
    margin: 0 auto var(--benefit-gap);
    text-align: center;
  }
  .home-benefits-eyebrow {
    margin: 0 0 9px;
    color: var(--brand-accent);
    font-size: 14px;
    font-weight: 700;
  }
  .home-benefits h2 {
    margin: 0;
    font-family: 'UltraClipart Sans', Arial, sans-serif;
    font-weight: 750;
    font-size: clamp(25px, 2.5vw, 33px);
    line-height: 1.2;
    letter-spacing: -1px;
    color: #142f56;
  }
  .home-benefits-heading > p {
    max-width: 100%;
    margin: 0;
    color: #466282;
    font-size: 15px;
    line-height: 1.6;
  }
  .home-benefits-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--benefit-gap);
    align-items: stretch;
  }
  .home-benefit {
    min-width: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid #dae5f2;
    border-radius: 18px;
    background: #fff;
    text-decoration: none;
    box-shadow:
      0 5px 0 #dfe9f5,
      0 13px 24px #234b7b08;
    transition:
      box-shadow 0.2s,
      border-color 0.2s;
  }
  .home-benefit:hover {
    border-color: #90b6e6;
    box-shadow:
      0 5px 0 #d5e3f5,
      0 13px 24px #234b7b15;
  }
  .home-benefit:focus-visible {
    outline: 3px solid #2572d5;
    outline-offset: 5px;
  }
  .home-benefit-art {
    position: relative;
    display: grid;
    place-items: center;
    height: 220px;
    background: #f3ebe7;
    border-bottom: 1px solid #eef2f8;
  }
  .home-benefit-formats .home-benefit-art {
    background: #edf2f6;
  }
  .home-benefit-studio .home-benefit-art {
    background: #e9eef6;
  }
  .home-benefit-privacy .home-benefit-art {
    background: #edf3fb;
  }
  .home-benefit-art :global(svg) {
    width: 100%;
    max-width: 240px;
    height: 220px;
  }
  .home-benefit-copy {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 20px;
  }
  .home-benefit-label {
    margin: 0 0 9px;
    color: #46698e;
    font-size: 11px;
    font-weight: 700;
    line-height: 1.4;
  }
  .home-benefit h3 {
    margin: 0 0 12px;
    min-height: 2.6em;
    font:
      750 21px/1.3 'UltraClipart Sans',
      Arial,
      sans-serif;
    letter-spacing: -0.6px;
    color: #142f56;
  }
  .home-benefit-body {
    margin: 0 0 23px;
    color: #415d7e;
    font-size: 14px;
    line-height: 1.7;
  }
  .home-benefit-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-top: auto;
    color: #155cb6;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.5;
  }
  .home-benefit-link svg {
    flex-shrink: 0;
  }
  @media (max-width: 1100px) {
    .home-benefits {
      --benefit-gap: 22px;
    }
    .home-benefits-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .home-benefit-art {
      height: 220px;
    }
    .home-benefit-art :global(svg) {
      height: 220px;
      max-width: 255px;
    }
  }
  @media (max-width: 600px) {
    .home-benefits {
      --benefit-gap: 16px;
      border-radius: 20px;
    }
    .home-benefits-heading > p {
      max-width: none;
    }
    .home-benefits-grid {
      grid-template-columns: 1fr;
    }
    .home-benefit {
      display: flex;
    }
    .home-benefit-art {
      height: 230px;
    }
    .home-benefit-art :global(svg) {
      width: 225px;
      max-width: 100%;
      height: 230px;
    }
    .home-benefit-copy {
      padding: 20px;
    }
    .home-benefit h3 {
      font-size: 20px;
      min-height: 0;
    }
    .home-benefit-body {
      font-size: 14px;
      margin-bottom: 17px;
    }
  }
  @media (max-width: 359px) {
    .home-benefit-art :global(svg) {
      width: 210px;
    }
    .home-benefit-copy {
      padding: 20px;
    }
    .home-benefit h3 {
      font-size: 18px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .home-benefit,
    .home-benefit-art :global(svg) {
      transition: none;
    }
  }

  .home-benefit-body {
    font-size: 15px;
  }
  .home-benefit h3 {
    font-weight: 600;
  }
  .home-benefits-heading > p {
    font-size: 16px;
  }
</style>
