---
interface Props {
  kind: string;
}
const { kind } = Astro.props;
const id = `header-art-${kind}`;
const fill = (name: string) => `url(#${id}-${name})`;
---

<svg
  class="header-illustration"
  width="48"
  height="48"
  viewBox="0 0 64 64"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id={`${id}-blue`} x1="16" y1="8" x2="45" y2="58" gradientUnits="userSpaceOnUse">
      <stop stop-color="#89C6FF" />
      <stop offset=".48" stop-color="#3E93EC" />
      <stop offset="1" stop-color="#2260B4" />
    </linearGradient>
    <linearGradient
      id={`${id}-paper`}
      x1="18"
      y1="10"
      x2="49"
      y2="55"
      gradientUnits="userSpaceOnUse"
    >
      <stop stop-color="#FFFFFF" />
      <stop offset=".64" stop-color="#F5FAFF" />
      <stop offset="1" stop-color="#C9DDF2" />
    </linearGradient>
    <linearGradient
      id={`${id}-gold`}
      x1="22"
      y1="10"
      x2="47"
      y2="54"
      gradientUnits="userSpaceOnUse"
    >
      <stop stop-color="#FFF0A9" />
      <stop offset=".48" stop-color="#FFC95A" />
      <stop offset="1" stop-color="#EA9A2E" />
    </linearGradient>
    <linearGradient
      id={`${id}-teal`}
      x1="18"
      y1="18"
      x2="47"
      y2="54"
      gradientUnits="userSpaceOnUse"
    >
      <stop stop-color="#A3E7D1" />
      <stop offset=".55" stop-color="#55BAA5" />
      <stop offset="1" stop-color="#2C8D83" />
    </linearGradient>
    <linearGradient
      id={`${id}-violet`}
      x1="14"
      y1="7"
      x2="50"
      y2="57"
      gradientUnits="userSpaceOnUse"
    >
      <stop stop-color="#D0B7FF" />
      <stop offset=".5" stop-color="#A18AE4" />
      <stop offset="1" stop-color="#6F59AF" />
    </linearGradient>
    <linearGradient
      id={`${id}-rose`}
      x1="20"
      y1="10"
      x2="45"
      y2="56"
      gradientUnits="userSpaceOnUse"
    >
      <stop stop-color="#FFB3B8" />
      <stop offset=".5" stop-color="#F57E98" />
      <stop offset="1" stop-color="#CE4F78" />
    </linearGradient>
    <linearGradient id={`${id}-ink`} x1="13" y1="9" x2="48" y2="56" gradientUnits="userSpaceOnUse">
      <stop stop-color="#6B829E" />
      <stop offset="1" stop-color="#253D5B" />
    </linearGradient>
  </defs>
  <ellipse cx="33" cy="57" rx="23" ry="3.5" fill="#26496F" opacity=".1" />
  {kind === 'surprise' && (
    <>
      <g transform="rotate(-12 18 32)">
        <rect x="5" y="17" width="27" height="34" rx="5" fill="#BFD3EB" />
        <rect x="5" y="14" width="27" height="34" rx="5" fill={fill('paper')} stroke="#D6E4F4" />
        <path d="m9 38 6-9 5 5 4-5 5 11H9Z" fill={fill('teal')} />
        <circle cx="24" cy="22" r="3.5" fill={fill('gold')} />
      </g>
      <path d="m23 18 18-8 18 9-1 28-18 10-18-10 1-29Z" fill="#6B76B4" />
      <path d="m23 15 18-8 18 9-19 9-17-10Z" fill="#C2C9FF" />
      <path d="m23 15 17 10v29L22 44l1-29Z" fill={fill('violet')} />
      <path d="m40 25 19-9-1 28-18 10V25Z" fill={fill('blue')} />
      <ellipse cx="41" cy="16" rx="3" ry="1.6" fill="#F8FAFF" />
      <ellipse cx="28" cy="27" rx="2" ry="3" fill="#FFF" />
      <ellipse cx="34" cy="43" rx="2" ry="3" fill="#FFF" />
      <ellipse cx="47" cy="29" rx="2" ry="3" fill="#EFF7FF" />
      <ellipse cx="53" cy="26" rx="2" ry="3" fill="#EFF7FF" />
      <ellipse cx="47" cy="43" rx="2" ry="3" fill="#EFF7FF" />
      <ellipse cx="53" cy="40" rx="2" ry="3" fill="#EFF7FF" />
      <path d="m14 2 1.7 5.3L21 9l-5.3 1.7L14 16l-1.7-5.3L7 9l5.3-1.7L14 2Z" fill={fill('gold')} />
      <path d="m24 16 16 9 17-8" stroke="#E5E9FF" stroke-width="1.2" />
      <path
        d="m25 18 12 7v24"
        stroke="#DBCFFF"
        stroke-width="1.1"
        stroke-linecap="round"
        opacity=".8"
      />
      <path
        d="m43 26 12-6-1 20"
        stroke="#A3D2FF"
        stroke-width="1.2"
        stroke-linecap="round"
        opacity=".85"
      />
      <path d="m27 15 14-6 14 7" stroke="#F2F0FF" stroke-width="1.5" stroke-linecap="round" />
      <path d="m9 51 17-13 4 5-18 12-5 1 2-5Z" fill="#CE9142" />
      <path d="m9 49 17-13 4 5-18 12-5 1 2-5Z" fill={fill('gold')} />
      <path d="m26 36 3-2c2-1 5 2 3 4l-2 3-4-5Z" fill="#386AAB" />
      <path d="m9 49 3 4-5 1 2-5Z" fill="#F7E5CB" />
      <path d="m7 54 2-4 1.5 2L7 54Z" fill="#3D526A" />
      <path d="m13 48 12-9" stroke="#FFF0BA" stroke-width="1.3" stroke-linecap="round" />
    </>
  )}
  {kind === 'discover' && (
    <>
      <g transform="rotate(-11 21 26)">
        <rect x="7" y="9" width="28" height="34" rx="5" fill="#BCD7F4" />
        <rect x="9" y="7" width="28" height="34" rx="5" fill={fill('paper')} stroke="#C1D8F0" />
        <path d="m13 32 7-10 6 6 5-4 3 11H13Z" fill={fill('teal')} />
        <circle cx="29" cy="15" r="4" fill={fill('gold')} />
      </g>
      <circle cx="36" cy="34" r="20" fill="#2A65AA" />
      <circle cx="35" cy="32" r="20" fill={fill('blue')} />
      <circle cx="35" cy="32" r="15.5" fill={fill('paper')} stroke="#D9EBFA" stroke-width="1.5" />
      <path d="m43 22-5.2 13.2L26 43l5.2-13.2L43 22Z" fill={fill('rose')} />
      <path d="m43 22-5.2 13.2-6.6-5.4L43 22Z" fill="#DB567D" />
      <circle cx="35" cy="32" r="2.5" fill="#FFF" />
      <path
        d="M35 20v2m12 10h-2M35 44v-2M23 32h2"
        stroke="#86A5C9"
        stroke-width="1.5"
        stroke-linecap="round"
      />
      <path
        d="M22 20c4-6 12-8 18-5"
        stroke="#D8EFFF"
        stroke-width="2"
        stroke-linecap="round"
        opacity=".85"
      />
    </>
  )}
  {kind === 'grid' && (
    <>
      <rect x="6" y="8" width="25" height="25" rx="6" fill="#2866B4" />
      <rect x="6" y="6" width="25" height="25" rx="6" fill={fill('blue')} />
      <path d="m10 25 6-9 5 5 4-3 3 7H10Z" fill="#E9F7FF" />
      <circle cx="24" cy="12" r="3" fill="#FFDC7D" />
      <rect x="35" y="12" width="23" height="23" rx="6" fill="#BA793B" />
      <rect x="35" y="10" width="23" height="23" rx="6" fill={fill('gold')} />
      <path
        d="m47 14 1.8 4.6 5 .3-4 3.1 1.3 4.8-4.1-2.8-4.1 2.8 1.3-4.8-4-3.1 5-.3L47 14Z"
        fill="#FFF7DA"
      />
      <rect x="8" y="38" width="23" height="20" rx="6" fill="#8C5D9C" />
      <rect x="8" y="36" width="23" height="20" rx="6" fill={fill('rose')} />
      <path
        d="M19.5 51s-7-4.4-7-8a3.4 3.4 0 0 1 7-1 3.4 3.4 0 0 1 7 1c0 3.6-7 8-7 8Z"
        fill="#FFF0F4"
      />
      <rect x="35" y="39" width="23" height="20" rx="6" fill="#437C77" />
      <rect x="35" y="37" width="23" height="20" rx="6" fill={fill('teal')} />
      <path
        d="M46 53V41m0 6c-6 0-7-4-7-5 5 0 7 2 7 5Zm0 3c6 0 7-4 7-5-5 0-7 2-7 5Z"
        fill="#E2FFF2"
      />
    </>
  )}
  {kind === 'layers' && (
    <>
      <path d="m5 42 27 13 27-13v5L32 60 5 47v-5Z" fill="#426DAB" />
      <path d="m5 42 27-13 27 13-27 13L5 42Z" fill={fill('blue')} />
      <path d="m7 31 25 12 25-12v5L32 48 7 36v-5Z" fill="#7666AB" />
      <path d="m7 31 25-12 25 12-25 12L7 31Z" fill={fill('violet')} />
      <path d="m5 20 27 13 27-13v5L32 38 5 25v-5Z" fill="#BDD1E7" />
      <path d="m5 20 27-13 27 13-27 13L5 20Z" fill={fill('paper')} stroke="#D8E5F2" />
      <path d="m15 21 9-9 8 10 8-5 9 4-17 8-17-8Z" fill={fill('teal')} />
      <ellipse cx="37" cy="15" rx="4" ry="2.5" fill={fill('gold')} />
      <path d="m9 21 23 11 23-11" stroke="#FFF" stroke-opacity=".8" />
    </>
  )}
  {kind === 'spark' && (
    <>
      <g transform="rotate(-7 31 34)">
        <rect x="10" y="12" width="40" height="45" rx="6" fill="#DBA15C" />
        <rect x="10" y="9" width="40" height="45" rx="6" fill={fill('gold')} />
        <rect x="14" y="13" width="32" height="34" rx="3" fill={fill('paper')} />
        <path d="m17 40 9-13 7 8 5-5 5 12H17Z" fill={fill('teal')} />
        <circle cx="37" cy="21" r="4" fill={fill('rose')} />
        <path d="M24 50h12" stroke="#FFF0C5" stroke-width="2" stroke-linecap="round" />
      </g>
      <path d="m49 4 2.8 9.2L61 16l-9.2 2.8L49 28l-2.8-9.2L37 16l9.2-2.8L49 4Z" fill="#DF982C" />
      <path
        d="m49 2 2.8 9.2L61 14l-9.2 2.8L49 26l-2.8-9.2L37 14l9.2-2.8L49 2Z"
        fill={fill('gold')}
        stroke="#FFF2C8"
      />
      <path d="m9 2 1.3 4.7L15 8l-4.7 1.3L9 14 7.7 9.3 3 8l4.7-1.3L9 2Z" fill="#8DBBEE" />
    </>
  )}
  {kind === 'contrast' && (
    <>
      <g transform="rotate(-9 27 33)">
        <rect x="8" y="11" width="38" height="45" rx="5" fill="#ACC2D8" />
        <rect x="8" y="8" width="38" height="45" rx="5" fill={fill('paper')} stroke="#CCDCEB" />
      </g>
      <rect x="21" y="12" width="34" height="44" rx="5" fill={fill('ink')} />
      <path d="M26 12h12v44H26a5 5 0 0 1-5-5V17a5 5 0 0 1 5-5Z" fill={fill('paper')} />
      <path
        d="M37 49V24m0 7c-9-1-10-7-9-10 7 0 10 5 9 10Zm0 10c-8 0-10-6-9-9 7 0 10 4 9 9Z"
        fill="#3C5471"
        stroke="#3C5471"
        stroke-width="1.5"
      />
      <path
        d="M38 49V24m0 13c8-1 10-7 9-10-7 0-10 5-9 10Zm0 10c8 0 10-6 9-9-7 0-10 4-9 9Z"
        fill="#EEF6FF"
        stroke="#EEF6FF"
        stroke-width="1.5"
      />
      <path d="M26 17h7m10 0h7" stroke="#A5BED7" stroke-linecap="round" />
    </>
  )}
  {kind === 'book' && (
    <>
      <path
        d="M4 15c11-3 20-2 28 3 8-5 17-6 28-3v36c-11-3-20-2-28 3-8-5-17-6-28-3V15Z"
        fill="#3D6CA8"
      />
      <path
        d="M4 12c11-3 20-2 28 3 8-5 17-6 28-3v36c-11-3-20-2-28 3-8-5-17-6-28-3V12Z"
        fill={fill('blue')}
      />
      <path d="M8 8c9-2 17-1 24 4v34c-7-5-15-6-24-4V8Z" fill={fill('paper')} />
      <path d="M56 8c-9-2-17-1-24 4v34c7-5 15-6 24-4V8Z" fill="#FFF8E9" />
      <path d="M32 12v34" stroke="#A9BDD0" stroke-width="1.4" />
      <path
        d="M13 16c5 0 9 1 14 3m-14 4c5 0 9 1 14 3m-14 4c5 0 9 1 11 2m13-13c5-2 9-3 14-3m-14 10c5-2 9-3 14-3m-14 10c5-2 9-3 11-3"
        stroke="#9AAEC1"
        stroke-width="1.8"
        stroke-linecap="round"
      />
      <path d="M44 9v19l4-3 4 1V8l-8 1Z" fill={fill('rose')} />
      <path d="M10 46c8-1 15 0 21 4m23-4c-8-1-15 0-21 4" stroke="#A6CBF1" stroke-width="1.2" />
    </>
  )}
  {kind === 'school' && (
    <>
      <g transform="rotate(-11 20 27)">
        <path d="M15 10h10v34H15z" fill={fill('rose')} />
        <path d="M15 10h4v34h-4z" fill="#F9B1C5" />
        <path d="m15 10 5-9 5 9H15Z" fill="#FFE5C4" />
        <path d="m18 5 2-4 2 4h-4Z" fill="#48627A" />
        <rect x="15" y="38" width="10" height="5" fill="#D6E1EA" />
      </g>
      <g transform="rotate(8 39 28)">
        <rect x="34" y="5" width="12" height="41" rx="2" fill={fill('gold')} />
        <path d="M42 10h4m-4 5h4m-4 5h4m-4 5h4m-4 5h4m-4 5h4" stroke="#B9823E" stroke-width="1.2" />
        <circle cx="40" cy="9" r="1.5" fill="#FFF4C7" />
      </g>
      <path d="m26 31 2-23 5-5 4 6-2 23" fill={fill('teal')} />
      <path d="m28 8 5-5 4 6-9-1Z" fill="#FFE8CB" />
      <path d="m31 5 2-2 2 3-4-1Z" fill="#3D625D" />
      <path d="M11 29h42l-4 24a6 6 0 0 1-6 5H21a6 6 0 0 1-6-5l-4-24Z" fill="#2E69AD" />
      <path d="M11 27h42l-4 24a6 6 0 0 1-6 5H21a6 6 0 0 1-6-5l-4-24Z" fill={fill('blue')} />
      <path d="M15 29h34" stroke="#BFDEFF" stroke-width="2" stroke-linecap="round" />
      <path
        d="M20 34v14m6-14v17m6-17v17m6-17v17m6-17v14"
        stroke="#D4E9FF"
        stroke-opacity=".45"
        stroke-width="1.5"
        stroke-linecap="round"
      />
    </>
  )}
  {kind === 'print' && (
    <>
      <rect x="17" y="5" width="31" height="28" rx="3" fill="#B5CEE7" />
      <rect x="20" y="3" width="25" height="27" rx="2" fill={fill('paper')} stroke="#CEE0F0" />
      <path d="M25 10h15m-15 5h11" stroke="#93B4D4" stroke-width="1.6" stroke-linecap="round" />
      <rect x="6" y="24" width="52" height="26" rx="7" fill="#2F5B8E" />
      <rect x="6" y="20" width="52" height="26" rx="7" fill={fill('blue')} />
      <path d="M9 27c0-3 2-4 5-4h36" stroke="#BDE0FF" stroke-width="1.3" stroke-linecap="round" />
      <circle cx="48" cy="28" r="2.5" fill="#B6F1BD" />
      <circle cx="40" cy="28" r="1.5" fill="#D8ECFF" />
      <rect x="15" y="36" width="35" height="10" rx="2" fill="#244D79" />
      <path
        d="M19 38h27v19a2 2 0 0 1-2 2H21a2 2 0 0 1-2-2V38Z"
        fill={fill('paper')}
        stroke="#C9DDEC"
      />
      <path
        d="M24 44h17m-17 5h17m-17 5h11"
        stroke="#83A8CE"
        stroke-width="1.5"
        stroke-linecap="round"
      />
    </>
  )}
  {kind === 'info' && (
    <>
      <rect x="7" y="9" width="49" height="49" rx="13" fill="#B9D4F2" />
      <rect x="7" y="6" width="49" height="49" rx="13" fill={fill('paper')} stroke="#D7E6F4" />
      <path d="M14 16v18a15 15 0 0 0 30 0V16h-8v18a7 7 0 0 1-14 0V16h-8Z" fill="#1E5EA9" />
      <path d="M14 14v18a15 15 0 0 0 30 0V14h-8v18a7 7 0 0 1-14 0V14h-8Z" fill={fill('blue')} />
      <path d="M39 14h5v18c0 8-5 14-12 15 5-4 7-9 7-16V14Z" fill="#1F5EBB" />
      <path d="M17 17v14" stroke="#B2E1FF" stroke-width="2" stroke-linecap="round" />
      <path d="m52 1 1.6 5.4L59 8l-5.4 1.6L52 15l-1.6-5.4L45 8l5.4-1.6L52 1Z" fill={fill('gold')} />
    </>
  )}
</svg>
