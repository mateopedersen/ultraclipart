---
import CatalogCount from './CatalogCount.astro';
interface Props {
  topic: string;
}
const { topic } = Astro.props;
---

<div class="collection-gallery-heading">
  <div class="collection-gallery-title">
    <h2>Choose a design for your next idea</h2>
    <span class="collection-gallery-count">
      <svg
        class="collection-count-icon"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        width="24"
        height="24"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M8 5V3.5h11a2 2 0 0 1 2 2V17h-1.5"
          stroke="#92B2D5"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <rect
          x="3"
          y="6"
          width="14"
          height="15"
          rx="2.5"
          fill="#F2F7FF"
          stroke="#3973AE"
          stroke-width="1.5"
        />
        <circle cx="7.5" cy="10.5" r="1.5" fill="#E6B75A" />
        <path
          d="m5.5 18 3.3-4 2.6 2.8 2.1-2.3 1.5 3.5"
          fill="#D2E6F8"
          stroke="#3973AE"
          stroke-width="1.3"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
      <CatalogCount kind="topic" countKey={topic} unit="illustration" />
    </span>
  </div>
  <a href="/license/">Personal &amp; educational use</a>
</div>

<style>
  .collection-gallery-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px 24px;
    margin-block: 30px 20px;
  }
  .collection-gallery-title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
    min-width: 0;
  }
  h2 {
    margin: 0;
    color: #193858;
    font-size: clamp(22px, 2vw, 27px);
    line-height: 1.3;
    font-weight: 650;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .collection-gallery-count {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 9px 13px 9px 10px;
    border: 1px solid #cfdeed;
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 2px 0 #e7eff8;
    color: #244b74;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.4;
    white-space: nowrap;
    text-transform: capitalize;
  }
  .collection-count-icon {
    flex: 0 0 24px;
  }
  a {
    color: #245d92;
    font-size: 13px;
    font-weight: 600;
    text-underline-offset: 3px;
  }
  @media (max-width: 600px) {
    .collection-gallery-heading {
      align-items: flex-start;
      gap: 12px;
    }
    .collection-gallery-title {
      gap: 10px;
    }
  }
</style>
