---
const { item, compact = false } = Astro.props;
---

<button
  type="button"
  class:list={['share-trigger', compact ? 'share-trigger-card' : 'share-trigger-detail']}
  data-share-art
  data-share-title={item.title}
  data-share-url={`https://ultraclipart.com/art/${item.id}/`}
  data-share-image={item.webp}
  aria-label={compact ? `Share ${item.title}` : `Share this clipart: ${item.title}`}
  title="Share this clipart"
>
  <svg width="23" height="23" viewBox="0 0 28 28" fill="none" aria-hidden="true">
    <rect x="3" y="9" width="18" height="17" rx="5" fill="#e7f1ff" />
    <path d="M11 12 20 7M11 16l9 5" stroke="#2870c9" stroke-width="2" />
    <circle cx="7" cy="14" r="4" fill="#58a8ff" stroke="#1f68bb" stroke-width="1.3" />
    <circle cx="22" cy="5.5" r="4" fill="#9bcaff" stroke="#1f68bb" stroke-width="1.3" />
    <circle cx="22" cy="22" r="4" fill="#2b7ee0" stroke="#1f68bb" stroke-width="1.3" />
    <path
      d="M5.5 12.5h2M20.5 4h2M20.5 20.5h2"
      stroke="white"
      stroke-width="1.5"
      stroke-linecap="round"
    />
  </svg>
  {!compact && <span>Share this clipart</span>}
</button>
