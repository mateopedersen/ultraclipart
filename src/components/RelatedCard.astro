---
import CardFileActions from './CardFileActions.astro';
import type { RelatedCard } from '../lib/related/engine';
interface Props {
  card: RelatedCard;
}
const { card } = Astro.props;
---

<article
  class="related-card"
  data-related-id={card.id}
  data-related-group={card.group}
  data-related-reason={card.reasonCode}
>
  <a class="related-picture" href={card.href} data-related-detail>
    <img
      title={card.title}
      src={card.thumb}
      srcset={card.thumbSrcSet}
      sizes="(max-width: 540px) 45vw, (max-width: 1000px) 30vw, 240px"
      alt={card.alt}
      width="400"
      height="400"
      loading="lazy"
      decoding="async"
    />
    <span class="related-image-error" hidden>
      Preview unavailable · View artwork
    </span>
  </a>
  <div class="related-card-copy">
    <a class="related-card-title" href={card.href} data-related-detail>
      {card.title}
    </a>
    <p class="related-reason">{card.reason}</p>
    <CardFileActions id={card.id} title={card.title} webp={card.webp} pdf={card.pdf} related>
      <button
        type="button"
        class="related-favorite"
        data-related-favorite
        aria-pressed="false"
        aria-label={`Save ${card.title} to favorites`}
        hidden
      >
        <svg
          viewBox="0 0 24 24"
          width="20"
          height="20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          aria-hidden="true"
        >
          <path d="M20.8 4.7a5.5 5.5 0 0 0-7.8 0L12 5.8l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.5a5.5 5.5 0 0 0 0-7.8Z" />
        </svg>
      </button>
    </CardFileActions>
  </div>
</article>
