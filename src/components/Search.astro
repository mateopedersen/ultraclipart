<form class="searchbox" action="/search/" role="search">
  <span aria-hidden="true">⌕</span>
  <label class="sr-only" for="search-q">
    Search UltraClipart
  </label>
  <input
    id="search-q"
    name="q"
    type="search"
    placeholder="Describe the artwork, or find a guide or tool…"
    maxlength="320"
    list="suggestions"
    autocomplete="off"
  />
  <button class="primary">Search</button>
</form>
