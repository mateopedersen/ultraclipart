---
interface Props {
  kind: 'license' | 'formats' | 'studio' | 'privacy';
}
const { kind } = Astro.props;
const id = `home-benefit-${kind}`;
const fill = (name: string) => `url(#${id}-${name})`;
---

<svg
  viewBox="0 0 240 180"
  width="240"
  height="180"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient
      id={`${id}-paper`}
      x1="60"
      y1="25"
      x2="160"
      y2="145"
      gradientUnits="userSpaceOnUse"
    >
      <stop stop-color="#fff" />
      <stop offset="1" stop-color="#DCEBFC" />
    </linearGradient>
    <linearGradient
      id={`${id}-blue`}
      x1="85"
      y1="40"
      x2="165"
      y2="145"
      gradientUnits="userSpaceOnUse"
    >
      <stop stop-color="#A5D5FF" />
      <stop offset=".48" stop-color="#448FF0" />
      <stop offset="1" stop-color="#1455B5" />
    </linearGradient>
    <linearGradient
      id={`${id}-mint`}
      x1="90"
      y1="45"
      x2="155"
      y2="140"
      gradientUnits="userSpaceOnUse"
    >
      <stop stop-color="#BFEEDA" />
      <stop offset=".5" stop-color="#6BC3A5" />
      <stop offset="1" stop-color="#25887D" />
    </linearGradient>
    <linearGradient
      id={`${id}-rose`}
      x1="75"
      y1="40"
      x2="146"
      y2="126"
      gradientUnits="userSpaceOnUse"
    >
      <stop stop-color="#FFD6CD" />
      <stop offset=".52" stop-color="#F28FA0" />
      <stop offset="1" stop-color="#CF5C7C" />
    </linearGradient>
    <linearGradient
      id={`${id}-gold`}
      x1="100"
      y1="45"
      x2="180"
      y2="135"
      gradientUnits="userSpaceOnUse"
    >
      <stop stop-color="#FFF3BA" />
      <stop offset=".55" stop-color="#FBCB73" />
      <stop offset="1" stop-color="#D79841" />
    </linearGradient>
    <linearGradient
      id={`${id}-violet`}
      x1="70"
      y1="55"
      x2="170"
      y2="135"
      gradientUnits="userSpaceOnUse"
    >
      <stop stop-color="#DCD3FF" />
      <stop offset=".5" stop-color="#A398E8" />
      <stop offset="1" stop-color="#6F64B4" />
    </linearGradient>
    <linearGradient
      id={`${id}-floor`}
      x1="120"
      y1="132"
      x2="120"
      y2="163"
      gradientUnits="userSpaceOnUse"
    >
      <stop stop-color="#fff" />
      <stop offset="1" stop-color="#D6E4F6" />
    </linearGradient>
    <filter
      id={`${id}-shadow`}
      x="-40%"
      y="-30%"
      width="180%"
      height="180%"
      color-interpolation-filters="sRGB"
    >
      <feDropShadow dx="0" dy="7" stdDeviation="6" flood-color="#24476F" flood-opacity=".16" />
    </filter>
    <pattern id={`${id}-checker`} width="16" height="16" patternUnits="userSpaceOnUse">
      <rect width="16" height="16" fill="#fff" />
      <path d="M0 0h8v8H0zM8 8h8v8H8z" fill="#E3EDF7" />
    </pattern>
    <clipPath id={`${id}-preview`}>
      <rect x="55" y="37" width="91" height="99" rx="9" />
    </clipPath>
  </defs>
  <ellipse cx="120" cy="154" rx="88" ry="12" fill="#37619A" opacity=".08" />
  <path d="M32 143v6c0 12 39 21 88 21s88-9 88-21v-6" fill="#C6D9F1" />
  <ellipse cx="120" cy="143" rx="88" ry="21" fill={fill('floor')} stroke="#fff" stroke-width="2" />
  {kind === 'license' && (
    <>
      <g transform="rotate(-13 105 88)" filter={fill('shadow')}>
        <rect x="58" y="31" width="99" height="117" rx="13" fill="#BDCFEB" />
        <rect
          x="58"
          y="26"
          width="99"
          height="117"
          rx="13"
          fill={fill('paper')}
          stroke="#fff"
          stroke-width="2"
        />
        <path d="M78 109h58M78 118h37" stroke="#A1B7D4" stroke-width="4" stroke-linecap="round" />
        <path d="m106 95-25-23c-16-17 5-38 25-20 20-18 41 3 25 20l-25 23Z" fill="#C86B81" />
        <path
          d="m106 89-25-23c-16-17 5-38 25-20 20-18 41 3 25 20l-25 23Z"
          fill={fill('rose')}
          stroke="#FFE4E0"
          stroke-width="1.5"
        />
        <path d="M86 57c0-6 5-8 10-7" stroke="#FFF3EB" stroke-width="4" stroke-linecap="round" />
      </g>
      <path d="m151 108-8 37 15-6 10 11 6-38" fill="#3A80D5" />
      <path d="m160 109 8 37 10-10 14 3-16-34" fill="#81B4F1" />
      <circle cx="165" cy="104" r="25" fill="#B88C42" />
      <circle cx="165" cy="101" r="25" fill={fill('gold')} stroke="#FFF0C6" stroke-width="2" />
      <circle cx="165" cy="101" r="19" stroke="#C98F40" stroke-dasharray="2 3" />
      <path
        d="m155 101 7 7 13-15"
        stroke="#7E5C2A"
        stroke-width="4"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <path d="M42 125c-4-15-2-28 4-37 12 15 11 28-4 37Z" fill={fill('mint')} />
      <path d="M43 138c-14-6-20-15-20-26 15 1 23 10 20 26Z" fill="#88CDB4" />
      <path d="m42 139 5-35" stroke="#538B7A" stroke-width="1.5" />
    </>
  )}
  {kind === 'formats' && (
    <>
      <g transform="rotate(-10 101 87)" filter={fill('shadow')}>
        <rect x="49" y="33" width="103" height="117" rx="13" fill="#B7CCE6" />
        <rect
          x="49"
          y="27"
          width="103"
          height="117"
          rx="13"
          fill={fill('paper')}
          stroke="#fff"
          stroke-width="2"
        />
        <g clip-path={fill('preview')}>
          <rect x="55" y="37" width="91" height="99" fill={fill('checker')} />
          <path
            d="M101 124V72m0 30c-25 1-34-13-31-23 17 0 28 8 31 23Zm0-10c24 0 32-14 30-24-17 0-27 10-30 24Z"
            fill={fill('mint')}
            stroke="#478A78"
            stroke-width="1.5"
          />
          <g fill={fill('gold')} stroke="#EFBE67">
            <ellipse cx="100" cy="57" rx="10" ry="16" />
            <ellipse cx="100" cy="82" rx="10" ry="16" />
            <ellipse cx="87" cy="69" rx="16" ry="10" />
            <ellipse cx="113" cy="69" rx="16" ry="10" />
          </g>
          <circle cx="100" cy="69" r="11" fill="#DB9956" />
          <circle cx="97" cy="66" r="3" fill="#FFDF9E" />
        </g>
      </g>
      <g transform="rotate(11 165 102)" filter={fill('shadow')}>
        <path
          d="M139 54h39l18 20v65a8 8 0 0 1-8 8h-49a8 8 0 0 1-8-8V62a8 8 0 0 1 8-8Z"
          fill="#BDCEE5"
        />
        <path
          d="M139 49h39l18 20v65a8 8 0 0 1-8 8h-49a8 8 0 0 1-8-8V57a8 8 0 0 1 8-8Z"
          fill={fill('paper')}
          stroke="#fff"
          stroke-width="2"
        />
        <path d="M178 49v14a6 6 0 0 0 6 6h12" fill="#B6D7FD" />
        <rect x="143" y="81" width="40" height="28" rx="5" fill={fill('rose')} />
        <path d="M147 119h33m-33 9h23" stroke="#A6BBD7" stroke-width="3" stroke-linecap="round" />
        <path
          d="M162 86v16m-6-6 6 6 6-6"
          stroke="#fff"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </g>
      <path d="m197 32 3 8 8 3-8 3-3 8-3-8-8-3 8-3 3-8Z" fill="#F2C878" />
    </>
  )}
  {kind === 'studio' && (
    <>
      <g filter={fill('shadow')}>
        <path d="m53 120 65-29 68 29v8l-67 30-66-30v-8Z" fill="#6577BE" />
        <path d="m53 120 65-29 68 29-67 30-66-30Z" fill={fill('violet')} stroke="#E6E0FF" />
        <path d="m53 102 65-29 68 29v7l-67 30-66-30v-7Z" fill="#439E95" />
        <path d="m53 102 65-29 68 29-67 30-66-30Z" fill={fill('mint')} stroke="#DDFFF0" />
        <path d="m53 82 65-29 68 29v7l-67 30-66-30v-7Z" fill="#3780C9" />
        <path
          d="m53 82 65-29 68 29-67 30-66-30Z"
          fill={fill('paper')}
          stroke="#fff"
          stroke-width="2"
        />
        <path d="m82 83 24-26 15 24 13-9 24 15-39 17-37-21Z" fill={fill('mint')} />
        <ellipse cx="142" cy="70" rx="9" ry="5" fill={fill('gold')} />
      </g>
      <path d="m53 71 65-30 68 30v24l-67 30-66-30V71Z" stroke="#4384D3" stroke-dasharray="4 4" />
      <g fill="#fff" stroke="#3478CA" stroke-width="1.5">
        <rect x="48" y="66" width="9" height="9" rx="2" />
        <rect x="113" y="37" width="9" height="9" rx="2" />
        <rect x="182" y="66" width="9" height="9" rx="2" />
        <rect x="114" y="120" width="9" height="9" rx="2" />
      </g>
      <g transform="rotate(27 180 104)" filter={fill('shadow')}>
        <path d="M172 52h16v67l-8 18-8-18V52Z" fill={fill('gold')} stroke="#C99449" />
        <path d="M172 52v-9a8 8 0 0 1 16 0v9" fill={fill('rose')} />
        <path d="M172 52h16v8h-16Z" fill="#CFDCEA" />
        <path d="m175 127 5 10 5-10" fill="#344D68" />
        <path d="M176 63v50" stroke="#FFF0BA" stroke-width="3" stroke-linecap="round" />
      </g>
      <circle cx="48" cy="44" r="5" fill="#91CBB6" />
      <circle cx="39" cy="55" r="2" fill="#F3CE87" />
    </>
  )}
  {kind === 'privacy' && (
    <>
      <g transform="rotate(-7 116 90)" filter={fill('shadow')}>
        <rect x="45" y="34" width="143" height="108" rx="13" fill="#B2C9E5" />
        <rect
          x="45"
          y="28"
          width="143"
          height="108"
          rx="13"
          fill={fill('paper')}
          stroke="#fff"
          stroke-width="2"
        />
        <path d="M46 54h141" stroke="#C3D7EF" />
        <g fill="#90B0D7">
          <circle cx="58" cy="41" r="3" />
          <circle cx="69" cy="41" r="3" />
          <circle cx="80" cy="41" r="3" />
        </g>
        <rect x="57" y="66" width="31" height="50" rx="5" fill="#D3E4F7" />
        <path
          d="M65 78h15m-15 10h15m-15 10h11"
          stroke="#98B8DF"
          stroke-width="3"
          stroke-linecap="round"
        />
        <rect x="99" y="66" width="76" height="50" rx="5" fill="#F8FBFF" stroke="#D7E4F4" />
        <path d="m111 105 17-24 12 15 9-10 14 19h-52Z" fill={fill('mint')} />
        <circle cx="155" cy="78" r="6" fill={fill('gold')} />
      </g>
      <g filter={fill('shadow')}>
        <path d="m158 73 35 13v29c0 22-35 39-35 39s-35-17-35-39V86l35-13Z" fill="#32887D" />
        <path
          d="m155 68 35 13v29c0 22-35 39-35 39s-35-17-35-39V81l35-13Z"
          fill={fill('mint')}
          stroke="#D4F8E9"
          stroke-width="2"
        />
        <path
          d="m155 76 27 10v24c0 16-27 31-27 31s-27-15-27-31V86l27-10Z"
          stroke="#E4FFF3"
          opacity=".65"
        />
        <path d="M145 105v-9a10 10 0 0 1 20 0v9" stroke="#EFFFF8" stroke-width="5" />
        <rect x="139" y="101" width="32" height="25" rx="6" fill={fill('paper')} stroke="#fff" />
        <circle cx="155" cy="111" r="3" fill="#427E75" />
        <path d="M155 113v5" stroke="#427E75" stroke-width="3" stroke-linecap="round" />
      </g>
      <path d="m40 89 3 8 8 3-8 3-3 8-3-8-8-3 8-3 3-8Z" fill="#EBC878" />
    </>
  )}
</svg>
