---
import { uiPreview } from '../lib/ui-preview';
import uiImage0Source from '../../public/home-art/pineapple-print-preview.webp';
const uiImage0 = await uiPreview(uiImage0Source);
import uiImage1Source from '../../public/home-art/studio-real-workspace.webp';
const uiImage1 = await uiPreview(uiImage1Source);
import uiImage2Source from '../../public/home-art/kitchen-notes-project.webp';
const uiImage2 = await uiPreview(uiImage2Source);
import { art } from '../lib/catalog';
interface Props {
  kind: 'license' | 'formats' | 'studio' | 'privacy';
}
const { kind } = Astro.props;
const balloons = art.find((a) => a.id === 'heart-balloon-bouquet-watercolor-clipart')!;
const pineapple = art.find((a) => a.id === 'pineapple-whole-and-cut-fruit-realistic-clipart')!;
---

<div class={`benefit-visual benefit-visual-${kind}`} aria-hidden="true">
  {kind === 'license' && (
    <div class="benefit-greeting">
      <span>Thank You</span>
      <img
        title={balloons.title}
        src={balloons.thumb}
        srcset={balloons.thumbSrcSet}
        sizes="(max-width: 540px) 45vw, (max-width: 1000px) 30vw, 240px"
        alt={balloons.alt}
        width="440"
        height="440"
        loading="lazy"
        decoding="async"
      />
      <span class="greeting-signature">A card for you</span>
    </div>
  )}
  {kind === 'formats' && (
    <>
      <div class="benefit-image-file">
        <img
          title={pineapple.title}
          src={pineapple.thumb}
          srcset={pineapple.thumbSrcSet}
          sizes="(max-width: 540px) 45vw, (max-width: 1000px) 30vw, 240px"
          alt={pineapple.alt}
          width="440"
          height="440"
          loading="lazy"
          decoding="async"
        />
        <span>WebP</span>
      </div>
      <div class="benefit-print-file">
        <img
          src={uiImage0.src}
          srcset={uiImage0.srcset}
          sizes="(max-width: 600px) 80vw, (max-width: 1000px) 40vw, 280px"
          alt=""
          width="440"
          height="440"
          loading="lazy"
          decoding="async"
        />
        <span>PDF</span>
      </div>
    </>
  )}
  {kind === 'studio' && (
    <div class="benefit-real-workspace">
      <img
        src={uiImage1.src}
        srcset={uiImage1.srcset}
        sizes="(max-width: 600px) 80vw, (max-width: 1000px) 40vw, 280px"
        alt=""
        width="1100"
        height="914"
        loading="lazy"
        decoding="async"
      />
      <span>Arrange Images & Add Text</span>
    </div>
  )}
  {kind === 'privacy' && (
    <div class="benefit-saved-project">
      <img
        src={uiImage2.src}
        srcset={uiImage2.srcset}
        sizes="(max-width: 600px) 80vw, (max-width: 1000px) 40vw, 280px"
        alt=""
        width="1000"
        height="860"
        loading="lazy"
        decoding="async"
      />
      <span>
        kitchen-notes.json <span>Editable copy</span>
      </span>
    </div>
  )}
</div>
<style>
  .benefit-visual {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    display: grid;
    place-items: center;
    isolation: isolate;
  }
  .benefit-greeting {
    position: relative;
    width: 154px;
    height: 190px;
    display: flex;
    flex-direction: column;
    align-items: center;
    background: #fffefa;
    border: 1px solid #e3ddd2;
    border-radius: 3px;
    padding: 13px 10px 8px;
    transform: rotate(-7deg);
    box-shadow:
      4px 5px 0 #ddd6c9,
      8px 15px 20px #463e361e;
    font-family: Georgia, serif;
  }
  .benefit-greeting > span:first-child {
    font-size: 15px;
    font-weight: 700;
    color: #634a4b;
    line-height: 1.2;
  }
  .benefit-greeting img {
    width: 126px;
    height: 132px;
    object-fit: contain;
    margin: 5px 0;
    filter: drop-shadow(0 4px 3px #733b4810);
  }
  .greeting-signature {
    font-size: 7px;
    letter-spacing: 0.4px;
    color: #776665;
  }
  .benefit-image-file,
  .benefit-print-file {
    position: absolute;
    width: 137px;
    height: 159px;
    padding: 7px 7px 25px;
    border: 1px solid #d5e0e8;
    border-radius: 5px;
    box-shadow:
      3px 5px 0 #cbd6dd,
      8px 12px 16px #28415b16;
    background: #fff;
  }
  .benefit-image-file {
    left: calc(50% - 118px);
    top: 34px;
    transform: rotate(-9deg);
    background-color: #fff;
    background-image: conic-gradient(#dbe3e8 25%, #fff 0 50%, #dbe3e8 0 75%, #fff 0);
    background-size: 14px 14px;
  }
  .benefit-print-file {
    right: calc(50% - 118px);
    top: 22px;
    transform: rotate(8deg);
  }
  .benefit-image-file img,
  .benefit-print-file img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .benefit-image-file > span,
  .benefit-print-file > span {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: grid;
    place-items: center;
    height: 24px;
    border-top: 1px solid #e4e9ee;
    background: #fff;
    color: #304a65;
    font: 700 10px/1.3 var(--font-ui);
    letter-spacing: 0.2px;
  }
  .benefit-real-workspace {
    position: relative;
    width: calc(100% - 28px);
    border: 1px solid #bccbd9;
    border-radius: 7px;
    background: #fff;
    transform: rotate(-3deg);
    box-shadow:
      3px 5px 0 #cbd6e3,
      8px 13px 20px #23384f20;
    overflow: hidden;
  }
  .benefit-real-workspace img {
    display: block;
    width: 100%;
    height: 156px;
    object-fit: cover;
    object-position: center 10%;
  }
  .benefit-real-workspace > span {
    display: block;
    padding: 8px 5px;
    color: #344b65;
    background: #fff;
    font: 600 9px/1.4 var(--font-ui);
    text-align: center;
    border-top: 1px solid #dce5ef;
  }
  .benefit-saved-project {
    position: relative;
    width: 168px;
    height: 185px;
    border: 1px solid #deddd1;
    border-radius: 4px;
    background: #fffdf7;
    transform: rotate(6deg);
    box-shadow:
      4px 5px 0 #d8ddd5,
      8px 13px 20px #293c2f1e;
  }
  .benefit-saved-project img {
    display: block;
    width: 100%;
    height: 159px;
    object-fit: contain;
  }
  .benefit-saved-project > span {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 4px;
    padding: 8px 7px;
    background: #fff;
    border-top: 1px solid #e5e6df;
    color: #3e594c;
    font: 600 6.5px/1.2 var(--font-ui);
    letter-spacing: -0.1px;
  }
  .benefit-saved-project > span > span {
    font-size: 6px;
    font-weight: 400;
    color: #576a5e;
  }
  @media (max-width: 1100px) and (min-width: 601px) {
    .benefit-real-workspace {
      max-width: 290px;
    }
    .benefit-real-workspace img {
      height: 161px;
    }
  }
  @media (max-width: 600px) {
    .benefit-greeting {
      width: 165px;
      height: 195px;
    }
    .benefit-greeting img {
      height: 136px;
    }
    .benefit-real-workspace {
      width: 280px;
      max-width: calc(100% - 40px);
    }
    .benefit-real-workspace img {
      height: 160px;
    }
    .benefit-saved-project {
      width: 178px;
      height: 195px;
    }
    .benefit-saved-project img {
      height: 169px;
    }
  }
</style>
