---
interface Props {
  format: string;
}
const { format } = Astro.props;
const colors: Record<string, [string, string]> = {
  png: ['#54bdce', '#258597'],
  jpg: ['#f5bf59', '#cb8030'],
  webp: ['#66c797', '#2e906b'],
  pdf: ['#f46f82', '#bf3b58'],
  svg: ['#b39bea', '#7857b6'],
  docx: ['#5a9fe8', '#2362a9'],
};
const local = Astro.locals as { exportIconSequence?: number };
const id = `export-icon-${(local.exportIconSequence = (local.exportIconSequence || 0) + 1)}`;
const [light, dark] = colors[format] || colors.png;
---

<svg
  class="uc-export-format-icon"
  width="46"
  height="46"
  viewBox="0 0 56 56"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient
      id={`${id}-paper`}
      x1="15"
      y1="7"
      x2="45"
      y2="48"
      gradientUnits="userSpaceOnUse"
    >
      <stop stop-color="#fff" />
      <stop offset="1" stop-color="#e4effa" />
    </linearGradient>
    <linearGradient
      id={`${id}-color`}
      x1="9"
      y1="25"
      x2="45"
      y2="51"
      gradientUnits="userSpaceOnUse"
    >
      <stop stop-color={light} />
      <stop offset="1" stop-color={dark} />
    </linearGradient>
  </defs>
  <ellipse cx="29" cy="51" rx="20" ry="3" fill="#23456c" opacity=".12" />
  <path d="M16 5h20l11 11v31a3 3 0 0 1-3 3H16a3 3 0 0 1-3-3V8a3 3 0 0 1 3-3Z" fill="#93b3d3" />
  <path
    d="M16 3h20l11 11v31a3 3 0 0 1-3 3H16a3 3 0 0 1-3-3V6a3 3 0 0 1 3-3Z"
    fill={`url(#${id}-paper)`}
    stroke="#bad0e6"
  />
  <path d="M36 3v8a3 3 0 0 0 3 3h8" fill="#d5e6f7" stroke="#bad0e6" />
  {format === 'png' && (
    <>
      <rect x="19" y="20" width="22" height="17" rx="2" fill="#fff" stroke="#c5d7e4" />
      <path
        d="M20 21h5v5h-5Zm10 0h5v5h-5Zm-5 5h5v5h-5Zm10 0h5v5h-5Zm-15 5h5v5h-5Zm10 0h5v5h-5Z"
        fill="#cbdbe7"
      />
      <path d="m21 34 7-8 5 5 3-3 4 7H21Z" fill={`url(#${id}-color)`} />
      <circle cx="36" cy="24" r="2" fill="#f5c967" />
    </>
  )}
  {format === 'jpg' && (
    <>
      <rect x="19" y="20" width="22" height="17" rx="2" fill="#badef7" />
      <circle cx="35" cy="25" r="4" fill="#ffcf65" />
      <path d="m19 33 7-9 7 9 3-4 5 6v2H19v-4Z" fill="#638eb2" />
      <rect x="8" y="29" width="18" height="14" rx="3" fill={`url(#${id}-color)`} />
      <path d="M12 29v-2h6v2" stroke="#bd7c29" stroke-width="2" />
      <circle cx="17" cy="36" r="4" fill="#fff5de" />
      <circle cx="17" cy="36" r="2.5" fill="#986e35" />
    </>
  )}
  {format === 'webp' && (
    <>
      <rect x="17" y="21" width="21" height="17" rx="3" fill="#a3d8bc" />
      <rect x="20" y="18" width="23" height="18" rx="3" fill={`url(#${id}-color)`} />
      <path d="m22 32 6-7 5 5 3-4 5 6H22Z" fill="#edfdf5" />
      <circle cx="37" cy="23" r="2.5" fill="#e4f4ba" />
      <path d="M18 42h21M18 45h13" stroke="#5b9e7d" stroke-width="2" stroke-linecap="round" />
    </>
  )}
  {format === 'svg' && (
    <>
      <path d="M20 32C20 13 41 14 41 31" stroke={`url(#${id}-color)`} stroke-width="3" />
      <path d="m20 32 2-13m19 12-3-12M22 19h16" stroke="#b1a0d3" stroke-width="1.5" />
      <g fill="#fff" stroke="#7857b6" stroke-width="1.5">
        <rect x="17" y="29" width="6" height="6" rx="1" />
        <rect x="38" y="28" width="6" height="6" rx="1" />
        <circle cx="22" cy="19" r="2" />
        <circle cx="38" cy="19" r="2" />
      </g>
      <path
        d="m25 38-4 3 4 3m10-6 4 3-4 3m-5-7-2 9"
        stroke="#7857b6"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </>
  )}
  {format === 'pdf' && (
    <>
      <path d="M21 20h19M21 24h13" stroke="#c5d6e6" stroke-width="2" stroke-linecap="round" />
      <rect x="7" y="29" width="36" height="17" rx="4" fill={`url(#${id}-color)`} />
      <path
        d="M13 41v-7h3a2 2 0 0 1 0 4h-3m11-4h-3v7h3c4 0 4-7 0-7Zm7 7v-7h5m-5 3h4"
        stroke="#fff"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </>
  )}
  {format === 'docx' && (
    <>
      <rect x="25" y="19" width="22" height="25" rx="2" fill="#7cb1e7" />
      <path d="M30 24h12M30 29h12M30 34h12M30 39h12" stroke="#e7f3ff" stroke-width="1.5" />
      <rect x="6" y="24" width="27" height="25" rx="4" fill="#1d528b" />
      <rect x="6" y="21" width="27" height="25" rx="4" fill={`url(#${id}-color)`} />
      <path
        d="m11 28 3 11 4-9 4 9 3-11"
        stroke="#fff"
        stroke-width="2.3"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </>
  )}
</svg>
