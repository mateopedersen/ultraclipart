---
const { id = 'builder', size = 56 } = Astro.props;
const g = `uc-ai-${id}`;
---

<svg width={size} height={size} viewBox="0 0 80 80" fill="none" aria-hidden="true">
  <defs>
    <linearGradient id={`${g}-case`} x1="14" y1="8" x2="62" y2="69" gradientUnits="userSpaceOnUse">
      <stop stop-color="#E6F5FF" />
      <stop offset=".4" stop-color="#82BDFF" />
      <stop offset="1" stop-color="#2868D6" />
    </linearGradient>
    <linearGradient
      id={`${g}-glass`}
      x1="22"
      y1="16"
      x2="60"
      y2="61"
      gradientUnits="userSpaceOnUse"
    >
      <stop stop-color="#397FEA" />
      <stop offset="1" stop-color="#113A8C" />
    </linearGradient>
    <linearGradient id={`${g}-beam`} x1="50" y1="8" x2="67" y2="34" gradientUnits="userSpaceOnUse">
      <stop stop-color="#FFF8CD" />
      <stop offset="1" stop-color="#FFA92F" />
    </linearGradient>
    <radialGradient id={`${g}-light`}>
      <stop stop-color="#DBF7FF" stop-opacity=".9" />
      <stop offset="1" stop-color="#66B5FF" stop-opacity="0" />
    </radialGradient>
  </defs>
  <ellipse cx="41" cy="71" rx="28" ry="5" fill="#0B3B8C" opacity=".16" />
  <path d="m15 25 34-10 20 13v32L35 73 15 60V25Z" fill="#2055AA" />
  <path
    d="m12 20 34-11 23 14v33L35 68 12 54V20Z"
    fill={`url(#${g}-case)`}
    stroke="#A8D7FF"
    stroke-width="1.2"
  />
  <path d="m12 20 23 14 34-11M35 34v34" stroke="#D3EBFF" stroke-width="1.3" />
  <path d="m20 22 27-8 15 10-27 9-15-11Z" fill="#F5FCFF" opacity=".8" />
  <path d="m40 38 22-8v23l-22 8V38Z" fill={`url(#${g}-glass)`} stroke="#A7D5FF" />
  <path
    d="m45 51 2.8-11 3.2 9M46 46l4-1.4m5.5-8.4v11.2"
    stroke="#F5FCFF"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <path d="m18 30 10 6v19l-10-6V30Z" fill="#BCE4FF" />
  <path d="m19 45 3-5 3 5 3-1v7l-9-6Z" fill="#2C9CB6" />
  <circle cx="22" cy="36" r="2" fill="#FFF1A0" />
  <ellipse cx="55" cy="23" rx="23" ry="21" fill={`url(#${g}-light)`} />
  <path
    d="m61 2 3.2 10.5L75 16l-10.8 3.5L61 30l-3.3-10.5L47 16l10.7-3.5L61 2Z"
    fill={`url(#${g}-beam)`}
    stroke="#FFF5CD"
  />
  <path d="m38 3 1.5 4.5L44 9l-4.5 1.5L38 15l-1.5-4.5L32 9l4.5-1.5L38 3Z" fill="#91D8FF" />
  <path d="m68 39 1 3 3 1-3 1-1 3-1-3-3-1 3-1 1-3Z" fill="#D5F5FF" />
</svg>
