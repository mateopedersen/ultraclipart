---
import type { art } from '../lib/catalog';
import { artworkDetails, formatFileSize } from '../lib/artwork-details';
import FileGuideIllustration from './FileGuideIllustration.astro';
import '../styles/artwork-facts.css';
interface Props {
  item: (typeof art)[number];
  layers: string[];
}
const { item, layers } = Astro.props;
const facts = artworkDetails(item);
---

<section class="artwork-facts" aria-labelledby="artwork-facts-title">
  <div class="artwork-facts-heading">
    <div>
      <p>Your creative toolkit</p>
      <h2 id="artwork-facts-title">Know your files.</h2>
    </div>
    <a href="/guides/webp-pdf-and-editable-projects/">A guide to your files</a>
  </div>
  <div class="artwork-facts-grid">
    <article class="file-fact file-fact-image">
      <div class="file-fact-top">
        <FileGuideIllustration kind="image" thumb={item.thumb} />
        <span class="file-fact-format">WebP</span>
      </div>
      <h3>Ready for your screen</h3>
      <p class="file-fact-primary">
        {item.width.toLocaleString('en-US')} × {item.height.toLocaleString('en-US')} px
      </p>
      <p class="file-fact-description">
        {item.alpha
          ? 'Transparent background. Just drop it into your design.'
          : 'A crisp image for your digital layouts.'}
      </p>
      <details class="file-fact-details">
        <summary>
          Image details <span aria-hidden="true">＋</span>
        </summary>
        <dl>
          <div>
            <dt>Size</dt>
            <dd>{formatFileSize(item.files.webp.bytes)}</dd>
          </div>
          <div>
            <dt>Canvas</dt>
            <dd>{facts.orientation}</dd>
          </div>
          <div>
            <dt>Background</dt>
            <dd>
              {item.alpha ? 'Transparent — no background to remove' : 'Included in the image'}
            </dd>
          </div>
        </dl>
        <p>
          Choose WebP for digital layouts, presentations and placing the artwork over your own
          background.
        </p>
      </details>
    </article>
    {item.pdf && (
      <article class="file-fact file-fact-print">
        <div class="file-fact-top">
          <FileGuideIllustration kind="print" thumb={item.thumb} />
          <span class="file-fact-format">PDF</span>
        </div>
        <h3>Made for the page</h3>
        <p class="file-fact-primary">
          {item.pdfColorSpace.includes('CMYK') ? 'CMYK print file' : 'Printable document'}
        </p>
        <p class="file-fact-description">
          A separate, fixed-size PDF. Open, check your scale, print.
        </p>
        <details class="file-fact-details">
          <summary>
            Print details <span aria-hidden="true">＋</span>
          </summary>
          <dl>
            <div>
              <dt>Size</dt>
              <dd>{formatFileSize(item.files.pdf.bytes)}</dd>
            </div>
            <div>
              <dt>PDF page</dt>
              <dd>{item.pdfPage}</dd>
            </div>
            <div>
              <dt>At 300 pixels/inch</dt>
              <dd>
                {facts.printInches}
                <small>{facts.printCentimeters} · full image canvas</small>
              </dd>
            </div>
          </dl>
          <a href={`/print-size/?width=${item.width}&height=${item.height}`}>
            Check your print size <span aria-hidden="true">→</span>
          </a>
        </details>
      </article>
    )}
    <article class="file-fact file-fact-edit">
      <div class="file-fact-top">
        <FileGuideIllustration kind="edit" thumb={item.thumb} />
        <span class="file-fact-format">Studio</span>
      </div>
      <h3>Edit This Illustration</h3>
      <p class="file-fact-primary">
        {item.layered ? `${layers.length} editable layers` : 'One image layer'}
      </p>
      <p class="file-fact-description">Resize, recolor and add your own words in Clipart Studio.</p>
      <details class="file-fact-details">
        <summary>
          Editing options <span aria-hidden="true">＋</span>
        </summary>
        <p>{facts.editing}</p>
        <p>
          Preview colors help you see the edges. They don’t change the original download; export
          from Studio to save your edits.
        </p>
        <a href={`/edit/${item.id}/`}>
          Edit this artwork <span aria-hidden="true">→</span>
        </a>
      </details>
    </article>
    <article class="file-fact file-fact-license">
      <div class="file-fact-top">
        <FileGuideIllustration kind="license" thumb={item.thumb} />
        <span class="file-fact-format">Use</span>
      </div>
      <h3>Create with confidence</h3>
      <p class="file-fact-primary">Personal &amp; educational</p>
      <p class="file-fact-description">
        For your own projects and classroom. No commercial use or resale.
      </p>
      <details class="file-fact-details">
        <summary>
          License essentials <span aria-hidden="true">＋</span>
        </summary>
        <p>
          {item.pdf ? 'WebP image and PDF document included.' : 'WebP image included.'} Use it in
          your personal and classroom projects. Commercial use and resale as clipart are not
          permitted.
        </p>
        <a href="/license/">
          Read the full license <span aria-hidden="true">→</span>
        </a>
      </details>
    </article>
  </div>
  <details class="artwork-technical">
    <summary>
      <span>Full file information</span> <span aria-hidden="true">＋</span>
    </summary>
    <dl>
      <div>
        <dt>Artwork ID</dt>
        <dd>{item.id}</dd>
      </div>
      <div>
        <dt>WebP file size</dt>
        <dd>{item.files.webp.bytes.toLocaleString('en-US')} bytes</dd>
      </div>
      {item.pdf && (
        <>
          <div>
            <dt>PDF file size</dt>
            <dd>{item.files.pdf.bytes.toLocaleString('en-US')} bytes</dd>
          </div>
          <div>
            <dt>PDF color space</dt>
            <dd>{item.pdfColorSpace}</dd>
          </div>
          <div>
            <dt>Print profile</dt>
            <dd>{item.printProfile}</dd>
          </div>
        </>
      )}
      <div>
        <dt>Source type</dt>
        <dd>{item.layered ? 'Layered vector artwork' : 'Raster artwork; one image layer'}</dd>
      </div>
    </dl>
    {item.layered && (
      <>
        <h3>Editable source layers</h3>
        <ul>
          {layers.map((layer) => (
            <li>{layer}</li>
          ))}
        </ul>
      </>
    )}
  </details>
</section>
