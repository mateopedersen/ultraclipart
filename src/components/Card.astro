---
import Icon from './Icon.astro';
import ShareButton from './ShareButton.astro';
const { item } = Astro.props;
---

<article class="art-card" data-id={item.id}>
  <ShareButton item={item} compact />
  <a class="art-picture" href={`/art/${item.id}/`}>
    <img src={item.thumb} alt={item.alt} width="400" height="400" loading="lazy" />
  </a>
  <div class="card-body">
    <a class="card-title" href={`/art/${item.id}/`}>
      {item.title}
    </a>
    <div class="formats">
      <a
        href={item.webp}
        download={`${item.id}.webp`}
        class="webp"
        aria-label={`Download Image: ${item.title}`}
      >
        <Icon name="image" size={20} />
        <span>Image</span>
      </a>
      {item.pdf && (
        <a
          href={item.pdf}
          download={`${item.id}.pdf`}
          class="pdf"
          aria-label={`Download PDF: ${item.title}`}
        >
          <Icon name="document" size={20} />
          <span>PDF</span>
        </a>
      )}
    </div>
    <div class="card-actions">
      <a class="button" href={item.editable === false ? `/art/${item.id}/` : `/edit/${item.id}/`}>
        <Icon name={item.editable === false ? 'view' : 'edit'} size={20} />
        <span>{item.editable === false ? 'View' : 'Edit'}</span>
      </a>
    </div>
  </div>
</article>
