---
import Icon from './Icon.astro';
import StudioIcon from './StudioIcon.astro';
import ElementLibrary from './ElementLibrary.astro';
import TextStudio from './TextStudio.astro';
import '../styles/studio-workspace.css';
import '../styles/studio-inspector.css';
import StudioPanels from './StudioPanels.astro';
import { shapeMarkup, shapeNames } from '../editor/creation';
interface Props {
  creator?: boolean;
  art: {
    id: string;
    title: string;
    svg?: string | null;
    sourceType?: string;
    width?: number;
    height?: number;
    webp?: string;
    pdf?: string;
    files?: { webp: { bytes: number; sha256: string }; pdf: { bytes: number; sha256: string } };
    [key: string]: unknown;
  };
}
const { art, creator = false } = Astro.props;
const raster = art.sourceType === 'raster';
const compositionTools = creator || raster;
const rasterSource = raster
  ? {
      id: art.id,
      width: art.width,
      height: art.height,
      webp: { url: art.webp, ...art.files!.webp },
      pdf: { url: art.pdf, ...art.files!.pdf },
    }
  : undefined;
const toolItems = [
  ...(compositionTools
    ? [
        ['create', 'image', 'Draw'],
        ['elements', 'image', 'Elements'],
        ['canvas', 'crop', 'Canvas'],
      ]
    : []),
  ['region', 'select', 'Smart Select'],
  ['studio', 'image', 'Studio Pro'],
  ['transform', 'select', 'Transform'],
  ['color', 'color', 'Recolor'],
  ['background', 'background', 'Background'],
  ['print', 'print', 'Print / B&W'],
  ['crop', 'crop', 'Crop'],
  ['layers', 'layers', 'Layers'],
  ['text', 'text', 'Text'],
];
---

<section
  class="uc-editor"
  data-art-id={art.id}
  data-source={art.svg ?? undefined}
  data-raster-source={rasterSource ? JSON.stringify(rasterSource) : undefined}
  data-composition={compositionTools ? 'true' : undefined}
  data-creator={creator ? 'true' : undefined}
  aria-label={creator ? 'Clipart creation studio' : 'Clipart editor'}
  aria-busy="true"
>
  <div class="uc-command">
    <div>
      {creator ? (
        <>
          <h2 id="studio-workspace-title">{art.title}</h2>
          <a class="uc-project-help" href="#studio-privacy">
            Saving &amp; privacy
          </a>
        </>
      ) : (
        <>
          <a href={`/art/${art.id}/`}>← Back to artwork</a>
          <h1>{art.title}</h1>
        </>
      )}
    </div>
    <div class="uc-command-buttons" inert>
      <button data-action="undo" disabled>
        <Icon name="undo" size={18} /> Undo
      </button>
      <button data-action="redo" disabled>
        <Icon name="redo" size={18} /> Redo
      </button>
      <button data-action="reset">Reset</button>
      <button data-action="save">
        <StudioIcon name="save" size={22} /> Save project
      </button>
      <button data-action="share" disabled aria-label="Share your edited artwork">
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
          focusable="false"
        >
          <path
            d="m8.5 10.5 7-4m-7 7 7 4"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
          />
          <circle cx="6" cy="12" r="3.2" fill="#d7e9ff" stroke="#2160b4" stroke-width="1.5" />
          <circle cx="18" cy="5" r="3.2" fill="#a5dfce" stroke="#237768" stroke-width="1.5" />
          <circle cx="18" cy="19" r="3.2" fill="#ffdc9c" stroke="#9b651a" stroke-width="1.5" />
        </svg>{' '}
        Share
      </button>
      <button class="uc-primary" data-action="export">
        <Icon name="download" size={18} /> Export
      </button>
    </div>
  </div>
  <div class="uc-modes" role="group" aria-label="Studio work mode">
    <button data-work-mode="quick" aria-pressed="true">
      Quick Edit
    </button>
    <button data-work-mode="advanced" aria-pressed="false">
      Advanced Edit
    </button>
    <button data-work-mode="print" aria-pressed="false">
      Print &amp; Create
    </button>
  </div>
  <div class="uc-notice" role="status" aria-live="polite" data-status>
    {creator
      ? 'Your blank canvas is ready. Add a shape, draw, or choose a starter. Changes are saved on this device.'
      : raster
        ? 'Loading your image workspace…'
        : 'Loading editable vector artwork…'}
  </div>
  <div class="uc-workspace" inert>
    <nav class="uc-tools" aria-label="Editing tools">
      {toolItems.map(([panel, , label]) => (
        <button
          id={`uc-tool-${panel}`}
          data-panel={panel}
          aria-pressed={panel === (creator ? 'create' : 'transform')}
          aria-controls={`uc-pane-${panel}`}
        >
          <StudioIcon name={panel} />
          <span>{label}</span>
        </button>
      ))}
    </nav>
    <div class="uc-canvas-column">
      <div
        class="uc-stage"
        tabindex="0"
        role="application"
        aria-label="Artwork canvas. Select layers with the Layers tool. Arrow keys move the selection. Shift plus arrow moves ten units. Delete removes selection. Control or Command Z undoes changes."
      >
        <div class="uc-canvas"></div>
        {creator && (
          <div class="uc-empty-canvas" data-empty-canvas>
            <strong>Your next great idea starts here.</strong>
            <span>Build with elements, draw freely, or start with a template.</span>
          </div>
        )}
      </div>
      <div class="uc-stage-toolbar">
        <button data-action="zoom-out" aria-label="Zoom out">
          −
        </button>
        <output data-zoom>100%</output>
        <button data-action="zoom-in" aria-label="Zoom in">
          +
        </button>
        <button data-action="fit">Fit view</button>
        <button data-action="pan" aria-pressed="false">
          Pan
        </button>
        <button data-action="center">Center</button>
        <button data-action="duplicate">Duplicate</button>
      </div>
      <p class="uc-hint">
        Select a shape or layer. Shift-click adds to your selection. Drag the corner handles to
        resize. Use Pan to move around a zoomed canvas.
      </p>
    </div>
    <aside class="uc-properties" aria-label="Artwork properties">
      <header class="uc-inspector-header">
        <div class="uc-inspector-heading">
          <StudioIcon name="create" size={30} />
          <div>
            <span class="uc-inspector-caption">Editing Tools</span>
            <h2 data-panel-title>{creator ? 'Build Your Design' : 'Edit Clipart'}</h2>
          </div>
          <button
            data-smart-action="collapse-properties"
            class="uc-inspector-toggle"
            aria-expanded="true"
            aria-controls={`uc-inspector-body-${art.id}`}
          >
            <span>Hide</span>
          </button>
        </div>
        <label class="uc-inspector-switch">
          Tool
          <select data-inspector-panel aria-label="Choose an editing tool">
            {toolItems.map(([name, , label]) => (
              <option value={name}>{label}</option>
            ))}
          </select>
        </label>
        <p class="uc-selection" data-selection>
          Select a layer to begin
        </p>
      </header>
      <div class="uc-inspector-body" id={`uc-inspector-body-${art.id}`}>
        <StudioPanels />
        {compositionTools && <ElementLibrary />}
        {compositionTools && (
          <>
            <div
              id="uc-pane-create"
              role="region"
              aria-labelledby="uc-tool-create"
              data-pane="create"
              hidden={!creator}
            >
              <div class="uc-place-card">
                <h3>Compose with real artwork</h3>
                <p class="uc-hint">
                  Select an image, then place copies exactly where you want them. Its texture,
                  transparent edges and edits stay intact.
                </p>
                <div class="uc-row">
                  <label>
                    Copy width
                    <input type="number" data-place-width min="16" max="4096" value="300" />
                  </label>
                  <label>
                    Rotation °
                    <input type="number" data-place-angle min="-360" max="360" value="0" />
                  </label>
                </div>
                <button data-action="place-image" aria-pressed="false">
                  Place image copies
                </button>
                <button data-action="browse-artwork">Browse artwork</button>
              </div>
              <details class="uc-control-details" open>
                <summary>Shapes &amp; vector drawing</summary>
                <p class="uc-hint">
                  Use precise geometric shapes as frames, labels or accents. Set their size, fill
                  and outline before adding.
                </p>
                <div class="uc-shape-grid">
                  {Object.entries(shapeNames).map(([kind, label]) => (
                    <button data-shape={kind} aria-label={`Add ${label.toLowerCase()}`}>
                      <svg
                        viewBox="-5 -5 80 60"
                        width="62"
                        height="46"
                        aria-hidden="true"
                        set:html={shapeMarkup(kind as keyof typeof shapeNames, {
                          width: 70,
                          height: 50,
                          sides: 5,
                          rounding: 20,
                          fill: [
                            '#91bfff',
                            '#ffb1ce',
                            '#ffce62',
                            '#baa3ef',
                            '#80d4b7',
                            '#f6ad80',
                            '#91bfff',
                            '#ffb1ce',
                          ][Object.keys(shapeNames).indexOf(kind)],
                          stroke: '#314e7a',
                          strokeWidth: 2,
                        })}
                      />
                      <span>{label}</span>
                    </button>
                  ))}
                </div>
                <div class="uc-row">
                  <label>
                    Shape width
                    <input data-shape-width type="number" min="4" max="4096" value="240" />
                  </label>
                  <label>
                    Shape height
                    <input data-shape-height type="number" min="4" max="4096" value="180" />
                  </label>
                </div>
                <div class="uc-row">
                  <label>
                    Points / sides
                    <input data-shape-sides type="number" min="3" max="12" value="5" />
                  </label>
                  <label>
                    Corner roundness %
                    <input data-shape-rounding type="number" min="0" max="50" value="20" />
                  </label>
                </div>
                <div class="uc-row">
                  <label>
                    Fill
                    <input type="color" data-create-fill value="#b7cba5" />
                  </label>
                  <label>
                    Stroke
                    <input type="color" data-create-stroke value="#1b293c" />
                  </label>
                </div>
                <div class="uc-row">
                  <label class="uc-check">
                    <input data-create-no-fill type="checkbox" /> No fill
                  </label>
                  <label class="uc-check">
                    <input data-create-no-stroke type="checkbox" /> No stroke
                  </label>
                </div>
                <label>
                  Stroke width
                  <input data-create-width type="number" min="0" max="100" value="5" step="0.5" />
                </label>
                <button data-action="paint-selection">Apply fill &amp; stroke to selection</button>
                <h3>Draw by hand</h3>
                <p class="uc-hint">
                  Draw with a mouse, pen or touch. Uses the stroke color and width above. Each
                  stroke stays a separate vector layer.
                </p>
                <button data-action="draw" aria-pressed="false">
                  Start drawing
                </button>
                <button data-action="cancel-draw" hidden>
                  Cancel current stroke
                </button>
                <p data-draw-hint class="uc-hint" hidden>
                  Drawing is on. Drag on the canvas. Escape cancels a stroke and returns to
                  selection.
                </p>
              </details>
            </div>
            <div
              id="uc-pane-canvas"
              role="region"
              aria-labelledby="uc-tool-canvas"
              data-pane="canvas"
              hidden
            >
              <h3>Canvas size</h3>
              <div class="uc-row">
                <label>
                  Width (px)
                  <input data-canvas-width type="number" min="64" max="4096" value="800" />
                </label>
                <label>
                  Height (px)
                  <input data-canvas-height type="number" min="64" max="4096" value="800" />
                </label>
              </div>
              <button data-action="resize-canvas">Resize canvas</button>
              <p class="uc-hint">
                64–4,096 pixels per side. Resizing keeps your shapes at their current size and
                clears the crop. Undo restores the previous canvas.
              </p>
              <h3>Bring your own vectors</h3>
              <button data-action="import-svg">Import SVG</button>
              <input hidden data-import-svg type="file" accept=".svg,image/svg+xml" />
              <p class="uc-hint">
                Opens an SVG as editable layers, replacing this canvas. Undo brings it back. Maximum
                1 MB and 500 layers. Supports solid colors and basic vector paths; images, fonts,
                effects, scripts and external resources are rejected.
              </p>
              <button data-action="load">Open saved project</button>
              <button data-action="blank">New blank canvas</button>
              <p class="uc-hint">
                Save a project to keep an editable copy on your device. Your SVG or project is read
                in this browser and is not uploaded.
              </p>
            </div>
          </>
        )}
        <div
          id="uc-pane-transform"
          role="region"
          aria-labelledby="uc-tool-transform"
          data-pane="transform"
          hidden={creator}
        >
          <div class="uc-row">
            <label>
              X position
              <input data-prop="x" type="number" step="1" />
            </label>
            <label>
              Y position
              <input data-prop="y" type="number" step="1" />
            </label>
          </div>
          <div class="uc-row">
            <label>
              Width scale %<input data-prop="scaleX" type="number" min="1" max="10000" />
            </label>
            <label>
              Height scale %<input data-prop="scaleY" type="number" min="1" max="10000" />
            </label>
          </div>
          <label>
            Rotation °<input data-prop="angle" type="number" min="-360" max="360" />
          </label>
          <label class="uc-check">
            <input type="checkbox" data-lock-ratio checked /> Keep proportions
          </label>
          <label class="uc-check">
            <input type="checkbox" data-snap checked /> Snap movement to 5-unit grid
          </label>
          <div class="uc-row">
            <button data-action="select-all">Select all</button>
            <button data-action="center">Center</button>
          </div>
          <div class="uc-row">
            <button data-action="duplicate">Duplicate</button>
            <button data-action="delete">Delete</button>
          </div>
        </div>
        <div
          id="uc-pane-color"
          role="region"
          aria-labelledby="uc-tool-color"
          data-pane="color"
          hidden
        >
          <label>
            Selected layer<select data-layer-picker aria-label="Selected layer"></select>
          </label>
          <div data-raster-color-hint hidden>
            <p class="uc-hint">
              Select &amp; Recolor changes an area within an image. Text and vector shapes use the
              color controls below.
            </p>
            <button data-open-panel="region" aria-controls="uc-pane-region">
              Open Select &amp; Recolor
            </button>
          </div>
          <div data-colors class="uc-swatches" aria-label="Layer colors"></div>
          <label>
            Color
            <input type="color" value="#2865d2" data-color />
          </label>
          <label>
            Hex value
            <input data-hex value="#2865d2" pattern="#[a-fA-F0-9]{6}" maxlength="7" />
          </label>
          <label class="uc-check">
            <input type="checkbox" data-matching checked /> Change only the selected color
          </label>
          <button data-action="apply-color">Apply color</button>
          <label>
            Shape opacity <output data-opacity-output>100%</output>
            <input data-prop="opacity" type="range" min="0" max="100" value="100" />
          </label>
          <label>
            Stroke width
            <input data-stroke type="number" min="0" max="40" step=".5" value="3" />
          </label>
          <h3>Style presets</h3>
          <div class="uc-presets">
            {!creator && <button data-preset="original">Original</button>}
            <button data-preset="pastel">Pastel</button>
            <button data-preset="grayscale">Grayscale</button>
            <button data-preset="vintage">Vintage</button>
            <button data-preset="bright">Bright</button>
          </div>
          <p class="uc-hint">
            Presets change unlocked, visible text and shape layers. Preserve the traditional colors
            of cultural symbols when appropriate.
          </p>
        </div>
        <div
          id="uc-pane-background"
          role="region"
          aria-labelledby="uc-tool-background"
          data-pane="background"
          hidden
        >
          <h3>Canvas background</h3>
          <div class="uc-backgrounds">
            <button data-bg="transparent" class="uc-checker">
              Transparent
            </button>
            <button data-bg="#ffffff">White</button>
            <button data-bg="#e8f1fa" style="background:#e8f1fa">
              Soft blue
            </button>
            <button data-bg="#edf1e7" style="background:#edf1e7">
              Sage
            </button>
          </div>
          <label>
            Custom color
            <input data-bg-color type="color" value="#f4f6f8" />
          </label>
          <p class="uc-hint">
            The checkerboard shows transparency. It is never included in your download. PDF paper is
            white wherever artwork is transparent.
          </p>
          <button data-action="remove-bg">Remove background</button>
        </div>
        <div
          id="uc-pane-print"
          role="region"
          aria-labelledby="uc-tool-print"
          data-pane="print"
          hidden
        >
          <h3>Black &amp; white</h3>
          <div class="uc-row">
            <button data-preset="outline">Outline only</button>
            <button data-preset="grayscale">Grayscale</button>
          </div>
          {!creator && <button data-preset="original">Restore original colors</button>}
          <label>
            Outline width
            <input data-outline-width type="number" value="3" min=".5" max="40" step=".5" />
          </label>
          <label>
            Grayscale contrast
            <input data-contrast type="range" min="50" max="200" value="100" />
          </label>
          <button data-action="contrast">Apply grayscale contrast</button>
          <h3>Print setup</h3>
          <label>
            Paper size
            <select data-print="paper">
              <option value="letter">US Letter (8.5 × 11 in)</option>
              <option value="a4">A4 (210 × 297 mm)</option>
            </select>
          </label>
          <label>
            Orientation
            <select data-print="orientation">
              <option value="portrait">Portrait</option>
              <option value="landscape">Landscape</option>
            </select>
          </label>
          <label>
            Safe margins (inches)
            <input data-print="margin" type="number" value="0.5" min="0" max="2" step="0.1" />
          </label>
          <label>
            Placement
            <select data-print="scale">
              <option value="fit">Fit entire artwork</option>
              <option value="fill">Fill page (may crop edges)</option>
              <option value="actual">Actual size (96 px per inch)</option>
              <option value="native">Native print (600 pixels per inch)</option>
            </select>
          </label>
          <label class="uc-check">
            <input type="checkbox" data-print-preview /> Show paper preview
          </label>
          <p class="uc-hint">
            {raster
              ? `The original image is ${art.width?.toLocaleString('en-US')} × ${art.height?.toLocaleString('en-US')} pixels. Unchanged images preserve their source CMYK data. Region edits are converted to the GRACoL print condition without reducing resolution.`
              : 'Vector artwork stays sharp at any size.'}{' '}
            CMYK colors may differ slightly from the screen; request a proof for color-critical
            printing.
          </p>
        </div>
        <div id="uc-pane-crop" role="region" aria-labelledby="uc-tool-crop" data-pane="crop" hidden>
          <p>
            Set a precise crop in artwork units. Cropping is non-destructive and applies to both
            download formats.
          </p>
          <div class="uc-row">
            <label>
              Left
              <input data-crop="x" type="number" value="0" />
            </label>
            <label>
              Top
              <input data-crop="y" type="number" value="0" />
            </label>
          </div>
          <div class="uc-row">
            <label>
              Width
              <input data-crop="width" type="number" min="1" />
            </label>
            <label>
              Height
              <input data-crop="height" type="number" min="1" />
            </label>
          </div>
          <button data-action="crop">Apply crop</button>
          <button data-action="uncrop">Reset crop</button>
        </div>
        <div
          id="uc-pane-layers"
          role="region"
          aria-labelledby="uc-tool-layers"
          data-pane="layers"
          hidden
        >
          <p class="uc-hint">
            Top rows appear in front. Select multiple with Shift. Locked layers cannot be edited.
          </p>
          <div class="uc-arrange-tools" aria-label="Arrange selected layers">
            <label>
              Align to
              <select data-align-to>
                <option value="selection">Selection bounds</option>
                <option value="canvas">Canvas</option>
              </select>
            </label>
            <div class="uc-align-grid">
              {[
                ['left', 'Left'],
                ['center-x', 'Horizontal center'],
                ['right', 'Right'],
                ['top', 'Top'],
                ['center-y', 'Vertical center'],
                ['bottom', 'Bottom'],
              ].map(([value, label]) => (
                <button
                  data-arrange={value}
                  title={`Align ${label.toLowerCase()}`}
                  aria-label={`Align ${label.toLowerCase()}`}
                >
                  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                    <path
                      d={
                        value === 'left'
                          ? 'M4 3v18M8 7h12M8 12h8M8 17h12'
                          : value === 'right'
                            ? 'M20 3v18M4 7h12M8 12h8M4 17h12'
                            : value === 'center-x'
                              ? 'M12 3v18M4 7h16M7 12h10M4 17h16'
                              : value === 'top'
                                ? 'M3 4h18M7 8v12M12 8v8M17 8v12'
                                : value === 'bottom'
                                  ? 'M3 20h18M7 4v12M12 8v8M17 4v12'
                                  : 'M3 12h18M7 4v16M12 7v10M17 4v16'
                      }
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                    />
                  </svg>
                </button>
              ))}
            </div>
            <div class="uc-row">
              <button data-arrange="distribute-x">Space evenly ↔</button>
              <button data-arrange="distribute-y">Space evenly ↕</button>
            </div>
            <div class="uc-row">
              <button data-action="front">Bring to front</button>
              <button data-action="back">Send to back</button>
            </div>
            <button data-action="separate-parts">Separate vector parts</button>
          </div>
          <details class="uc-control-details uc-repeat-controls">
            <summary>Repeat a selection</summary>
            <p class="uc-hint">
              Create evenly spaced rows and columns from selected images, shapes or groups. Copies
              remain editable.
            </p>
            <div class="uc-row">
              <label>
                Rows
                <input data-repeat-rows type="number" min="1" max="10" value="2" />
              </label>
              <label>
                Columns
                <input data-repeat-columns type="number" min="1" max="10" value="2" />
              </label>
            </div>
            <div class="uc-row">
              <label>
                Horizontal gap
                <input data-repeat-gap-x type="number" min="0" max="1000" value="24" />
              </label>
              <label>
                Vertical gap
                <input data-repeat-gap-y type="number" min="0" max="1000" value="24" />
              </label>
            </div>
            <label class="uc-check">
              <input data-repeat-stagger type="checkbox" /> Offset alternate rows
            </label>
            <label class="uc-check">
              <input data-repeat-expand type="checkbox" checked /> Expand canvas to fit
            </label>
            <button data-action="repeat-selection">Create repeated layout</button>
          </details>
          <div data-layers class="uc-layer-list"></div>
          <label>
            Layer name
            <input data-layer-name maxlength="80" />
          </label>
          <div class="uc-row">
            <button data-action="layer-up">Bring forward</button>
            <button data-action="layer-down">Send backward</button>
          </div>
          <div class="uc-row">
            <button data-action="group">Link selection</button>
            <button data-action="ungroup">Unlink</button>
          </div>
          <div class="uc-row">
            <button data-action="duplicate">Duplicate</button>
