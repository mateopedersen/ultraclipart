---
import { uiPreview } from '../lib/ui-preview';
import uiImage0Source from '../../public/ai-examples/garden-robot-1024.webp';
const uiImage0 = await uiPreview(uiImage0Source);
import uiImage1Source from '../../public/ai-examples/baby-rabbit-1024.webp';
const uiImage1 = await uiPreview(uiImage1Source);
import uiImage2Source from '../../public/ai-examples/floral-teacup-1024.webp';
const uiImage2 = await uiPreview(uiImage2Source);
import { invitationExamples as examples } from '../ai/presets';
import AiBuilderMark from './AiBuilderMark.astro';
---

<section class="ai-invitation" aria-labelledby="ai-invitation-title">
  <div class="ai-invitation-copy">
    <div class="ai-invitation-eyebrow">
      <span class="ai-invitation-mark" aria-hidden="true">
        <AiBuilderMark id="home" size={60} />
      </span>
      <span>AI Clipart Builder</span>
      <span class="ai-new-label">AI</span>
    </div>
    <h2 id="ai-invitation-title">
      Create an Image
      <br />
      <span>From Your Description</span>
    </h2>
    <p class="ai-invitation-description">
      Describe the subject and choose an illustration style. You can edit the generated image in
      Clipart Studio afterward.
    </p>
    <form id="home-ai-form" action="/ai-clipart-generator/" method="get">
      <label for="home-ai-prompt">Your Description</label>
      <textarea
        id="home-ai-prompt"
        maxlength="1200"
        rows="3"
        placeholder="Describe the image you want to create"
        autocomplete="off"
      >{examples[1].prompt}</textarea>
      <div class="ai-invitation-form-bottom">
        <span>Choose a style in the builder.</span>
        <button type="submit">
          <svg width="21" height="21" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="m14 3 1.9 5.1L21 10l-5.1 1.9L14 17l-1.9-5.1L7 10l5.1-1.9L14 3Z" fill="#FFF" />
            <path
              d="m5 14 1.2 3.3L9.5 18.5l-3.3 1.2L5 23l-1.2-3.3L.5 18.5l3.3-1.2L5 14Z"
              fill="#A8D3FF"
            />
          </svg>
          Open AI Clipart Builder
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true"
          >
            <path d="M4 12h15m-6-6 6 6-6 6" />
          </svg>
        </button>
      </div>
    </form>
    <div class="ai-invitation-prompts" aria-label="Try an example idea">
      <span>Try an Example:</span>
      {examples.slice(0, 3).map((e, i) => (
        <button type="button" data-home-ai-example={i}>
          {'image' in e && (
            <img
              src={e.image}
              alt={e.label}
              title={e.label}
              width="32"
              height="32"
              loading="lazy"
            />
          )}
          <span>{e.label}</span>
        </button>
      ))}
    </div>
    <div class="ai-invitation-notes">
      <span>
        <svg
          width="16"
          height="16"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          aria-hidden="true"
        >
          <path d="m4 10 4 4 8-8" />
        </svg>
        Free daily capacity
      </span>
      <span>
        <svg
          width="16"
          height="16"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          aria-hidden="true"
        >
          <path d="m4 10 4 4 8-8" />
        </svg>
        No account needed
      </span>
    </div>
    <p class="ai-invitation-fine">
      Use an example to fill in your description, then choose a style in the builder. No account
      needed. Current availability and daily limits are shown in the builder.
    </p>
    <a class="ai-restored-ideas" href="/ai-clipart-generator/#ai-idea-library">
      Browse All Example Ideas
    </a>
  </div>
  <div class="ai-invitation-art" aria-label="Example image ideas">
    <div class="ai-invitation-art-orbit" aria-hidden="true"></div>
    <div class="ai-artboard-label">
      <span></span> EXAMPLE IDEAS
    </div>
    <a
      class="ai-example-card ai-example-robot"
      href="/ai-clipart-generator/"
      data-home-ai-example="1"
      aria-label="Try the friendly robot idea"
    >
      <div class="ai-example-card-top">
        <span>PROMPT → CLIPART</span>
        <svg
          width="17"
          height="17"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          aria-hidden="true"
        >
          <path d="M7 17 17 7M7 7h10v10" />
        </svg>
      </div>
      <p>
        “A friendly robot
        <br />
        with a love for plants.”
      </p>
      <img
        title="Silver and orange robot holding a potted plant"
        src={uiImage0.src}
        srcset={uiImage0.srcset}
        sizes="(max-width: 600px) 80vw, (max-width: 1000px) 40vw, 280px"
        alt="Silver and orange robot holding a potted plant"
        width="640"
        height="640"
        loading="lazy"
        decoding="async"
      />
      <span class="ai-example-card-bottom">
        A Gardening Robot
        <span>
          Use This Example
          <svg
            width="14"
            height="14"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <path d="M3 10h13m-5-5 5 5-5 5" />
          </svg>
        </span>
      </span>
    </a>
    <a
      class="ai-example-card ai-example-rabbit"
      href="/ai-clipart-generator/"
      data-home-ai-example="0"
      aria-label="Try the baby rabbit idea"
    >
      <img
        title="Baby rabbit holding a yellow daisy"
        src={uiImage1.src}
        srcset={uiImage1.srcset}
        sizes="(max-width: 600px) 80vw, (max-width: 1000px) 40vw, 280px"
        alt="Baby rabbit holding a yellow daisy"
        width="320"
        height="320"
        loading="lazy"
        decoding="async"
      />
      <span>A Rabbit With a Daisy</span>
    </a>
    <a
      class="ai-example-card ai-example-floral"
      href="/ai-clipart-generator/"
      data-home-ai-example="2"
      aria-label="Try the floral teacup idea"
    >
      <img
        title="Flowers arranged in a pale green teacup"
        src={uiImage2.src}
        srcset={uiImage2.srcset}
        sizes="(max-width: 600px) 80vw, (max-width: 1000px) 40vw, 280px"
        alt="Flowers arranged in a pale green teacup"
        width="320"
        height="320"
        loading="lazy"
        decoding="async"
      />
      <span>Flowers in a Teacup</span>
    </a>
  </div>
</section>
<script>
  import { invitationExamples as examples } from '../ai/presets';
  const form = document.querySelector<HTMLFormElement>('#home-ai-form');
  const input = document.querySelector<HTMLTextAreaElement>('#home-ai-prompt');
  let selectedStyle = 'realistic';
  const go = () => {
    if (!input?.value.trim()) {
      try {
        sessionStorage.removeItem('ultraclipart-ai-prompt');
      } catch {
        /* Optional local storage. */
      }
      location.assign('/ai-clipart-generator/');
      return;
    }
    try {
      sessionStorage.setItem(
        'ultraclipart-ai-prompt',
        JSON.stringify({ prompt: input.value.trim(), style: selectedStyle, createdAt: Date.now() }),
      );
      location.assign('/ai-clipart-generator/');
    } catch {
      location.assign(
        '/ai-clipart-generator/#' +
          new URLSearchParams({ idea: input.value.trim(), style: selectedStyle }),
      );
    }
  };
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    go();
  });
  document.querySelectorAll<HTMLElement>('[data-home-ai-example]').forEach((button) =>
    button.addEventListener('click', (event) => {
      event.preventDefault();
      if (!input) return;
      const example = examples[Number(button.dataset.homeAiExample)];
      input.value = example.prompt;
      selectedStyle = example.style;
      if (button.tagName === 'A') go();
      else input.focus();
    }),
  );
</script>
<style>
  .ai-invitation {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: 0;
    align-items: stretch;
    margin: 28px 0 55px;
    border: 1px solid #cedff5;
    border-radius: 25px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 10px 35px #24487808;
    color: #152d50;
  }
  .ai-invitation-copy {
    grid-column: 2;
    grid-row: 1;
    padding: 39px 36px 32px;
  }
  .ai-invitation-eyebrow {
    display: flex;
    align-items: center;
    gap: 11px;
    margin: 0 0 22px;
    color: var(--brand-accent);
    font:
      650 16px/1.4 'UltraClipart Sans',
      Arial,
      sans-serif;
  }
  .ai-invitation-mark {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    background: #ecf5ff;
    border: 1px solid #ccdef5;
    border-radius: 13px;
    flex-shrink: 0;
  }
  .ai-new-label {
    display: inline-block;
    margin-left: 0;
    padding: 4px 7px;
    border: 1px solid #b8d2f5;
    border-radius: 5px;
    background: #e8f2ff;
    color: #1a559f;
    font:
      700 11px/1.4 'UltraClipart Sans',
      Arial,
      sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .ai-invitation h2 {
    margin: 0 0 19px;
    color: #14294b;
    font-family: 'UltraClipart Sans', Arial, sans-serif;
    font-size: clamp(32px, 3.2vw, 43px);
    font-weight: 750;
    letter-spacing: -1.6px;
    line-height: 1.14;
  }
  .ai-invitation h2 > span {
    color: var(--brand-accent);
  }
  .ai-invitation-description {
    max-width: 500px;
    margin: 0 0 24px;
    color: #304e75;
    font:
      400 17px/1.7 'UltraClipart Sans',
      Arial,
      sans-serif;
  }
  .ai-invitation form {
    margin: 0;
    padding: 15px;
    background: #fff;
    border: 1.5px solid #a7c5ed;
    border-radius: 14px;
    box-shadow: 0 5px 0 #f0f5fd;
  }
  .ai-invitation form:focus-within {
    border-color: #3478d4;
    box-shadow:
      0 0 0 3px #e1edff,
      0 5px 0 #f0f5fd;
  }
  .ai-invitation form > label {
    display: block;
    color: #26486f;
    font:
      650 14px/1.4 'UltraClipart Sans',
      Arial,
      sans-serif;
    margin: 0 0 9px;
  }
  .ai-invitation textarea {
    display: block;
    resize: vertical;
    min-height: 82px;
    max-height: 250px;
    width: 100%;
    padding: 5px 0 12px;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: #233f63;
    box-shadow: none;
    font:
      400 16px/1.6 'UltraClipart Sans',
      Arial,
      sans-serif;
  }
  .ai-invitation textarea::placeholder {
    color: #456589;
    opacity: 1;
  }
  .ai-invitation textarea:focus {
    outline: 0;
  }
  .ai-invitation-form-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding-top: 11px;
    border-top: 1px solid #e6eef9;
  }
  .ai-invitation-form-bottom > span {
    max-width: 160px;
    color: #546d8b;
    font-size: 12px;
    line-height: 1.5;
  }
  .ai-invitation form button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 48px;
    padding: 11px 13px;
    white-space: nowrap;
    border: 1px solid #0e5ed0;
    border-radius: 9px;
    background: linear-gradient(120deg, #1b77ee, #075bd4);
    box-shadow:
      inset 0 1px #ffffff30,
      0 3px 6px #1461bd12;
    color: #fff;
    font:
      650 15px/1.4 'UltraClipart Sans',
      Arial,
      sans-serif;
  }
  .ai-invitation form button:hover {
    background: #074faf;
  }
  .ai-invitation-prompts {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin: 22px 0 16px;
  }
  .ai-invitation-prompts > span {
    flex-basis: 100%;
    font-size: 12px;
    font-weight: 550;
    color: #506b8e;
    margin-bottom: 1px;
  }
  .ai-invitation-prompts button {
    display: flex;
    align-items: center;
    gap: 5px;
    min-height: 40px;
    padding: 3px 8px 3px 3px;
    border: 1px solid #d9e5f4;
    border-radius: 8px;
    background: #f8faff;
    color: #345680;
    font:
      600 14px/1.4 'UltraClipart Sans',
      Arial,
      sans-serif;
    box-shadow: none;
  }
  .ai-invitation-prompts button:hover {
    background: #edf5ff;
    border-color: #b1cef3;
  }
  .ai-invitation-prompts img {
    width: 30px;
    height: 30px;
    object-fit: contain;
    border-radius: 5px;
    background: #fff;
  }
  .ai-invitation-notes {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin: 0 0 8px;
    color: #42638a;
    font-size: 12px;
    line-height: 1.5;
  }
  .ai-invitation-notes > span {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .ai-invitation-notes svg {
    color: #2d87a2;
    flex-shrink: 0;
  }
  .ai-invitation-fine {
    margin: 0;
    color: #59718e;
    font-size: 11px;
    line-height: 1.6;
  }
  .ai-invitation-art {
    grid-column: 1;
    grid-row: 1;
    display: grid;
    grid-template-columns: minmax(0, 0.64fr) minmax(0, 1fr);
    grid-template-rows: 1fr 1fr;
    align-content: center;
    align-items: center;
    gap: 24px 18px;
    position: relative;
    min-width: 0;
    padding: 88px 24px 38px;
    min-height: 650px;
    isolation: isolate;
    overflow: hidden;
    background: linear-gradient(140deg, #2076e4 5%, #0e5bc8 80%);
    border-radius: 24px 0 0 24px;
  }
  .ai-invitation-art-orbit {
    position: absolute;
    z-index: -1;
    left: -60px;
    top: 56px;
    width: 550px;
    height: 550px;
    border: 1px solid #69a5f0;
    border-radius: 50%;
    background: #347fdf;
  }
  .ai-invitation-art-orbit:before {
    content: '';
    position: absolute;
    inset: 45px;
    border-radius: 50%;
    border: 1px solid #ffffff26;
    background: #ffffff09;
  }
  .ai-artboard-label {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 8px;
    top: 31px;
    left: 27px;
    right: 20px;
    color: #fff;
    font:
      600 14px/1.5 'UltraClipart Sans',
      Arial,
      sans-serif;
  }
  .ai-artboard-label > span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #c3e0ff;
    box-shadow: 0 0 0 4px #ffffff16;
    flex-shrink: 0;
  }
  .ai-example-card {
    position: relative;
    display: block;
    min-width: 0;
    width: 100%;
    background: white;
    border: 1px solid #e0e9f4;
    border-radius: 14px;
    text-decoration: none;
    color: #27456d;
    box-shadow: 0 15px 30px #0b376b40;
    transition:
      transform 0.2s,
      box-shadow 0.2s;
    overflow: hidden;
  }
  .ai-example-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 35px #0b376b55;
  }
  .ai-example-card img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
    background: white;
  }
  .ai-example-robot {
    grid-column: 2;
    grid-row: 1/3;
  }
  .ai-example-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 18px 0;
    color: #48688c;
    font-size: 11px;
    font-weight: 650;
    letter-spacing: 0.08em;
  }
  .ai-example-robot > p {
    margin: 8px 18px 0;
    color: #29466c;
    font:
      650 16px/1.5 'UltraClipart Sans',
      Arial,
      sans-serif;
    letter-spacing: -0.2px;
  }
  .ai-example-robot img {
    padding: 4px 8px 0;
  }
  .ai-example-card-bottom {
    display: block;
    padding: 0 18px 18px;
    font:
      650 14px/1.4 'UltraClipart Sans',
      Arial,
      sans-serif;
  }
  .ai-example-card-bottom > span {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 8px;
    color: #2d69b2;
    font-size: 12px;
    font-weight: 550;
  }
  .ai-example-rabbit {
    grid-column: 1;
    grid-row: 1;
    align-self: end;
    padding: 7px 7px 0;
  }
  .ai-example-floral {
    grid-column: 1;
    grid-row: 2;
    align-self: start;
    padding: 7px 7px 0;
  }
  .ai-example-rabbit img,
  .ai-example-floral img {
    border-radius: 8px;
  }
  .ai-example-rabbit > span,
  .ai-example-floral > span {
    display: block;
    padding: 8px 5px 14px;
    text-align: center;
    font:
      650 13px/1.4 'UltraClipart Sans',
      Arial,
      sans-serif;
  }
  .ai-invitation :focus-visible {
    outline: 3px solid #296ed1;
    outline-offset: 4px;
  }
  .ai-invitation-art :focus-visible {
    outline-color: #fff;
  }
  @media (max-width: 1100px) {
    .ai-invitation-copy {
      padding: 30px 25px;
    }
    .ai-invitation h2 {
      font-size: 35px;
      letter-spacing: -1.1px;
    }
    .ai-invitation-description {
      font-size: 16px;
    }
    .ai-invitation-eyebrow {
      font-size: 14px;
      gap: 9px;
    }
    .ai-invitation-form-bottom > span {
      display: none;
    }
    .ai-invitation form button {
      width: 100%;
      font-size: 16px;
    }
    .ai-invitation-prompts {
      gap: 6px;
    }
    .ai-invitation-prompts button {
      font-size: 14px;
    }
  }
  @media (max-width: 800px) {
    .ai-invitation {
      grid-template-columns: 1fr;
      margin-top: 12px;
      border-radius: 21px;
    }
    .ai-invitation-copy {
      grid-column: 1;
      grid-row: 1;
      padding: 30px;
    }
    .ai-invitation-eyebrow {
      font-size: 16px;
      margin-bottom: 18px;
    }
    .ai-invitation h2 {
      font-size: 41px;
    }
    .ai-invitation-description {
      max-width: none;
      font-size: 17px;
    }
    .ai-invitation-form-bottom > span {
      display: block;
    }
    .ai-invitation form button {
      width: auto;
    }
    .ai-invitation-prompts button {
      font-size: 14px;
    }
    .ai-invitation-notes {
      font-size: 13px;
    }
    .ai-invitation-fine {
      font-size: 12px;
    }
  }
  @media (max-width: 520px) {
    .ai-invitation {
      margin-bottom: 40px;
    }
    .ai-invitation-copy {
      padding: 25px 20px;
    }
    .ai-invitation-eyebrow {
      font-size: 14px;
      gap: 8px;
    }
    .ai-invitation-mark {
      width: 43px;
      height: 43px;
      border-radius: 11px;
    }
    .ai-new-label {
      font-size: 10px;
    }
    .ai-invitation h2 {
      font-size: 34px;
      letter-spacing: -1.2px;
    }
    .ai-invitation-description {
      font-size: 16px;
      line-height: 1.65;
      margin-bottom: 21px;
    }
    .ai-invitation form {
      padding: 12px;
    }
    .ai-invitation form > label {
      font-size: 13px;
    }
    .ai-invitation textarea {
      font-size: 16px;
      min-height: 104px;
    }
    .ai-invitation-form-bottom > span {
      display: none;
    }
    .ai-invitation form button {
      width: 100%;
      font-size: 16px;
      padding: 12px;
    }
    .ai-invitation-prompts {
      gap: 7px;
      margin-top: 21px;
    }
    .ai-invitation-prompts button {
      font-size: 14px;
      min-height: 40px;
    }
    .ai-invitation-prompts > span {
      font-size: 12px;
    }
    .ai-invitation-notes {
      gap: 6px 14px;
      font-size: 12px;
    }
    .ai-invitation-fine {
      font-size: 11px;
    }
    .ai-example-rabbit > span,
    .ai-example-floral > span {
      font-size: 10px;
      padding-bottom: 10px;
    }
  }
  @media (max-width: 359px) {
    .ai-invitation-copy {
      padding: 22px 16px;
    }
    .ai-invitation h2 {
      font-size: 30px;
      letter-spacing: -0.9px;
    }
    .ai-invitation-eyebrow {
      font-size: 13px;
      gap: 6px;
    }
    .ai-example-rabbit > span,
    .ai-example-floral > span {
      font-size: 9px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ai-invitation * {
      transition: none !important;
    }
  }

  @media (max-width: 1100px) {
    .ai-invitation-art {
      grid-template-columns: minmax(0, 0.7fr) minmax(0, 1fr);
      padding: 82px 18px 32px;
      gap: 20px 12px;
      min-height: 690px;
    }
    .ai-example-robot > p {
      font-size: 14px;
      margin: 8px 12px 0;
    }
    .ai-example-card-top {
      padding: 13px 12px 0;
      font-size: 10px;
    }
    .ai-example-card-bottom {
      padding: 0 12px 15px;
      font-size: 13px;
    }
    .ai-example-rabbit > span,
    .ai-example-floral > span {
      font-size: 12px;
      padding: 7px 2px 12px;
