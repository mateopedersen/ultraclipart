---
import '../styles/site-footer.css';
import NavigationArrow from './NavigationArrow.astro';
import { art } from '../lib/catalog';
const links = [
  {
    id: 'explore',
    title: 'Browse Clipart',
    subtitle: 'Topics & Collections',
    icon: 'explore',
    items: [
      ['All Topics', '/categories/'],
      ['Collections', '/collections/'],
      ['Library Index', '/library-index/'],
      ['New Clipart', '/new/'],
      ['Black & White', '/black-and-white/'],
      ['Your Boards', '/favorites/'],
    ],
  },
  {
    id: 'create',
    title: 'Tools & Guides',
    subtitle: 'Editing & Tutorials',
    icon: 'studio',
    items: [
      ['Clipart Studio', '/create/'],
      ['AI Clipart Builder', '/ai-clipart-generator/'],
      ['Project Guides', '/guides/'],
      ['Print Size Calculator', '/print-size/'],
      ['For Teachers', '/for-teachers/'],
    ],
  },
  {
    id: 'help',
    title: 'Help & Policies',
    subtitle: 'Answers & Permissions',
    icon: 'help',
    items: [
      ['FAQ', '/faq/'],
      ['License', '/license/'],
      ['Terms Of Use', '/terms/'],
      ['Privacy', '/privacy/'],
      ['Cookie Policy', '/cookies/'],
      ['Accessibility', '/accessibility/'],
    ],
  },
  {
    id: 'about',
    title: 'About Us',
    subtitle: 'Team & Contact',
    icon: 'boards',
    items: [
      ['About UltraClipart', '/about/'],
      ['Contact Us', '/contact/'],
      ['Copyright & Corrections', '/copyright/'],
      ['Our Editorial Process', '/editorial-process/'],
    ],
  },
];
const showcase = [
  'apple-and-dried-rings-crayon-clipart',
  'baby-fennec-fox-watercolor-clipart',
  'floral-heart-roses-wreath-clipart',
].flatMap((id) => {
  const item = art.find((item) => item.id === id);
  return item ? [item] : [];
});
const showInvitation = Astro.url.pathname !== '/';
const sculpture = (name: string) =>
  name === 'studio' ? '/illustrations/studio-compose-v3.svg' : `/illustrations/footer/${name}.svg`;
---

<footer class="site-footer" aria-label="Site footer">
  <div class="site-footer-inner">
    {showInvitation && (
      <section
        class="footer-invitation footer-dimensional-display"
        aria-labelledby="footer-invitation-title"
      >
        <div class="footer-invitation-copy">
          <h2 id="footer-invitation-title">
            Clipart for <span>Your Projects</span>
          </h2>
          <p>
            Download an image or printable PDF, or open Clipart Studio to add text and arrange your
            own layout.
          </p>
          <div class="footer-invitation-actions">
            <a class="footer-explore-button" href="/categories/">
              <img
                class="footer-action-object"
                src={sculpture('explore')}
                alt=""
                width="36"
                height="36"
                loading="lazy"
              />
              <span>Browse Clipart</span>
            </a>
            <a class="footer-studio-button" href="/create/">
              <img
                class="footer-action-object"
                src={sculpture('studio')}
                alt=""
                width="36"
                height="36"
                loading="lazy"
              />
              <span>Open Clipart Studio</span>
            </a>
          </div>
        </div>
        <div class="footer-creative-stage" aria-hidden="true">
          <div class="footer-stage-light"></div>
          <div class="footer-stage-floor"></div>
          {showcase.map((item, i) => (
            <div class={`footer-art-card footer-art-card-${i}`}>
              <div class="footer-art-paper">
                <img
                  title={item.title}
                  src={item.thumb}
                  srcset={item.thumbSrcSet}
                  sizes="(max-width: 950px) 120px, (max-width: 1200px) 135px, 150px"
                  alt={item.alt}
                  width="200"
                  height="200"
                  loading="lazy"
                />
              </div>
              <span>{['Fruit Illustrations', 'Animal Clipart', 'Hearts & Flowers'][i]}</span>
            </div>
          ))}
          <img
            class="footer-stage-palette"
            src={sculpture('studio')}
            alt=""
            width="128"
            height="128"
            loading="lazy"
          />
          <img
            class="footer-stage-heart"
            src={sculpture('boards')}
            alt=""
            width="108"
            height="108"
            loading="lazy"
          />
          <span class="footer-stage-spark footer-stage-spark-one"></span>
          <span class="footer-stage-spark footer-stage-spark-two"></span>
        </div>
      </section>
    )}

    <div class="footer-link-grid">
      {links.map((group) => (
        <details class={`footer-nav-card footer-nav-${group.id}`} data-footer-group open>
          <summary>
            <h3>
              <img
                class="footer-nav-object"
                src={sculpture(group.icon)}
                alt=""
                width="64"
                height="64"
                loading="lazy"
              />
              <span>
                <strong id={`footer-${group.id}-title`}>{group.title}</strong>
                <small>{group.subtitle}</small>
              </span>
              <span class="footer-group-toggle" aria-hidden="true">
                <span></span>
                <span></span>
              </span>
            </h3>
          </summary>
          <nav aria-labelledby={`footer-${group.id}-title`}>
            <ul>
              {group.items.map(([label, href]) => (
                <li>
                  <a href={href}>
                    <span>{label}</span>
                    <NavigationArrow size={24} />
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </details>
      ))}
    </div>
    <div class="footer-brand-row">
      <div class="footer-brand-lockup">
        <a class="brand footer-brand" href="/">
          <img src="/logo.svg" width="40" height="44" alt="" />
          <span>UltraClipart</span>
        </a>
        <p class="footer-copyright">© {new Date().getFullYear()}</p>
      </div>
      <p class="footer-message">
        <strong>
          <span aria-hidden="true">🎨</span> Discover clipart for your next creative project.
        </strong>
      </p>
      <a class="footer-back-top" href="#page-top">
        Back To Top <NavigationArrow size={25} direction="up" light />
      </a>
    </div>
  </div>
</footer>
<script>
  const footer = document.querySelector<HTMLElement>('.site-footer');
  if (footer) {
    const groups = [...footer.querySelectorAll<HTMLDetailsElement>('[data-footer-group]')];
    const compact = matchMedia('(max-width: 600px)');
    const arrange = () => {
      for (const group of groups) group.open = !compact.matches;
      footer.dataset.ready = 'true';
    };
    arrange();
    compact.addEventListener('change', arrange);
  }
</script>
