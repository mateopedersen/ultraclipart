---
import '../styles/site-footer.css';
const links = [
  {
    id: 'explore',
    title: 'Explore the library',
    icon: 'grid',
    items: [
      ['All topics', '/categories/'],
      ['Collections', '/collections/'],
      ['New clipart', '/new/'],
      ['Black & White', '/black-and-white/'],
      ['Your boards', '/favorites/'],
    ],
  },
  {
    id: 'create',
    title: 'Make something yours',
    icon: 'edit',
    items: [
      ['Clipart Studio', '/create/'],
      ['AI Clipart Builder', '/ai-clipart-generator/'],
      ['Project guides', '/guides/'],
      ['Print size calculator', '/print-size/'],
      ['For teachers', '/for-teachers/'],
    ],
  },
  {
    id: 'help',
    title: 'A little help',
    icon: 'help',
    items: [
      ['FAQ', '/faq/'],
      ['License', '/license/'],
      ['Terms of use', '/terms/'],
      ['Privacy', '/privacy/'],
      ['Accessibility', '/accessibility/'],
    ],
  },
  {
    id: 'about',
    title: 'Behind the artwork',
    icon: 'heart',
    items: [
      ['About UltraClipart', '/about/'],
      ['Contact us', '/contact/'],
      ['Copyright & corrections', '/copyright/'],
      ['Our creative process', '/editorial-process/'],
    ],
  },
];
---

<footer class="site-footer" aria-label="Site footer">
  <div class="site-footer-inner">
    <section class="footer-invitation" aria-labelledby="footer-invitation-title">
      <div class="footer-invitation-copy">
        <p class="footer-eyebrow">A little inspiration. A world of possibilities.</p>
        <h2 id="footer-invitation-title">
          Your next idea
          <br />
          starts with a <span>little spark.</span>
        </h2>
        <p>
          Find an illustration you love. Give it your own twist. Make something that feels like you.
        </p>
        <div class="footer-invitation-actions">
          <a class="footer-explore-button" href="/categories/">
            Explore clipart{' '}
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14m-6-6 6 6-6 6" />
            </svg>
          </a>
          <a class="footer-studio-button" href="/create/">
            Open Clipart Studio <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
      <img
        class="footer-creative-art"
        src="/illustrations/creative-desk.svg"
        width="380"
        height="250"
        alt=""
        loading="lazy"
      />
    </section>
    <div class="footer-brand-row">
      <a class="brand footer-brand" href="/">
        <img src="/logo.svg" width="40" height="44" alt="" />
        <span>UltraClipart</span>
      </a>
      <p>
        Little details.
        <br />
        <strong>Endless ways to create.</strong>
      </p>
      <a class="footer-board-link" href="/favorites/">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M20.5 5a5 5 0 0 0-7.1 0L12 6.4 10.6 5a5 5 0 0 0-7.1 7.1L12 21l8.5-8.9a5 5 0 0 0 0-7.1Z" />
        </svg>
        <span>Keep your ideas together</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
    <div class="footer-link-grid">
      {links.map((group) => (
        <nav aria-labelledby={`footer-${group.id}-title`}>
          <h3 id={`footer-${group.id}-title`}>
            <span class="footer-group-symbol" aria-hidden="true">
              <svg
                width="19"
                height="19"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                {group.icon === 'grid' ? (
                  <>
                    <rect x="3" y="3" width="7" height="7" rx="2" />
                    <rect x="14" y="3" width="7" height="7" rx="2" />
                    <rect x="3" y="14" width="7" height="7" rx="2" />
                    <rect x="14" y="14" width="7" height="7" rx="2" />
                  </>
                ) : group.icon === 'edit' ? (
                  <>
                    <path d="m14 5 4 4M4 20l5-1L21 7a2.8 2.8 0 0 0-4-4L5 15l-1 5Z" />
                  </>
                ) : group.icon === 'help' ? (
                  <>
                    <circle cx="12" cy="12" r="9" />
                    <path d="M9 9a3 3 0 0 1 6 0c0 2-3 2-3 4m0 3h.01" />
                  </>
                ) : (
                  <path d="M20.5 5a5 5 0 0 0-7.1 0L12 6.4 10.6 5a5 5 0 0 0-7.1 7.1L12 21l8.5-8.9a5 5 0 0 0 0-7.1Z" />
                )}
              </svg>
            </span>
            {group.title}
          </h3>
          <ul>
            {group.items.map(([label, href]) => (
              <li>
                <a href={href}>
                  <span>{label}</span>
                  <span class="footer-link-chevron" aria-hidden="true">
                    ›
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
    <div class="footer-bottom">
      <p>© {new Date().getFullYear()} UltraClipart</p>
      <span class="footer-license-note">
        <span aria-hidden="true">✓</span> Personal &amp; educational creativity
      </span>
      <a href="#page-top">
        Back to top{' '}
        <svg
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 19V5m-6 6 6-6 6 6" />
        </svg>
      </a>
    </div>
  </div>
</footer>
