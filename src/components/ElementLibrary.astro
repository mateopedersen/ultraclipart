---
import { featuredStudioArt } from '../lib/studio-artwork';
import { studioElements } from '../editor/elements';
---

<div
  id="uc-pane-elements"
  role="region"
  aria-labelledby="uc-tool-elements"
  data-pane="elements"
  hidden
>
  <div class="uc-library-tabs" role="group" aria-label="Element library">
    <button data-library-kind="artwork" aria-pressed="true">
      Artwork
    </button>
    <button data-library-kind="vector" aria-pressed="false">
      Vector shapes
    </button>
  </div>
  <div data-library-view="artwork">
    <nav class="wb-library-path" aria-label="Artwork category path">
      <button data-library-home>Categories</button>
      <button data-library-parent hidden></button>
      <span data-library-current></span>
    </nav>
    <p class="uc-hint">Choose artwork to add to your canvas.</p>
    <label>
      Search artwork
      <input
        data-artwork-search
        type="search"
        placeholder="Rabbit, strawberry, flowers…"
        autocomplete="off"
      />
    </label>
    <div class="uc-library-scope" role="group" aria-label="Artwork collection">
      <button data-artwork-scope="featured" aria-pressed="true">
        Featured <span data-featured-count>{featuredStudioArt.length.toLocaleString('en-US')}</span>
      </button>
      <button data-artwork-scope="all" aria-pressed="false">
        All Artwork
      </button>
    </div>
    <details class="wb-library-filters">
      <summary>Filter &amp; Sort Artwork</summary>
      <div class="uc-row">
        <label>
          Visual style
          <select data-artwork-style>
            <option value="">All styles</option>
            <option value="realistic">Realistic</option>
            <option value="Watercolor">Watercolor</option>
            <option value="Color">Color illustration</option>
            <option value="Outline">Line art</option>
            <option value="Black &amp; White">Black &amp; white</option>
          </select>
        </label>
        <label>
          Subject
          <select data-artwork-topic>
            <option value="">All subjects</option>
          </select>
        </label>
      </div>
      <div class="uc-library-options">
        <label>
          Sort By
          <select data-artwork-sort>
            <option value="featured">Recommended</option>
            <option value="title">Name A–Z</option>
            <option value="newest">Newest</option>
          </select>
        </label>
        <button data-artwork-clear>Clear Filters</button>
      </div>
    </details>
    <p class="uc-hint" data-artwork-count aria-live="polite">
      Loading the artwork library…
    </p>
    <div class="uc-artwork-grid" data-artwork-grid></div>
    <div class="uc-library-pagination">
      <button data-artwork-previous disabled>
        Previous
      </button>
      <span data-artwork-page></span>

      <button data-artwork-more hidden>
        Next
      </button>
      <label class="wb-page-jump">
        Go to
        <input data-artwork-jump type="number" min="1" value="1" aria-label="Artwork page number" />
      </label>
    </div>
    <button class="uc-upload-art" data-action="open-import">
      Import your own PNG / WebP
    </button>
    <p class="uc-hint">
      Images remain raster artwork. Smart Select creates editable masks; it does not invent hidden
      vector layers. Personal &amp; educational use.
    </p>
  </div>
  <div data-library-view="vector" hidden>
    <div class="uc-library-intro">
      <span class="uc-library-count">
        {studioElements.length.toLocaleString('en-US')} Editable Vectors
      </span>
      <p>
        Illustrations, shapes and icons. Add an element, then change its colors, size and position.
      </p>
    </div>
    <div class="uc-library-options">
      <label>
        Sort By
        <select data-element-sort>
          <option value="featured">Recommended</option>
          <option value="title">Name A–Z</option>
        </select>
      </label>
      <button data-element-clear>Clear Filters</button>
    </div>
    <label class="uc-search-field">
      Find an element
      <input
        data-element-search
        type="search"
        placeholder="Try flower, rainbow, cat…"
        autocomplete="off"
      />
    </label>
    <div class="uc-library-filters">
      <label>
        Collection
        <select data-element-category>
          <option value="">All collections</option>
        </select>
      </label>
      <button
        data-element-favorites
        aria-pressed="false"
        aria-label="Favorites: show favorite elements"
      >
        Favorites
      </button>
    </div>
    <p class="uc-hint" data-element-count aria-live="polite">
      Open the library to load elements.
    </p>
    <div class="uc-element-grid" data-element-grid></div>
    <div class="uc-library-pagination">
      <button data-element-previous disabled>
        Previous
      </button>
      <span data-element-page></span>

      <button data-element-more hidden>
        Next
      </button>
      <label class="wb-page-jump">
        Go to
        <input data-element-jump type="number" min="1" value="1" aria-label="Vector page number" />
      </label>
    </div>
    <p class="uc-hint">
      Each element becomes an editable vector layer. Use Recolor for individual colors, or Separate
      parts in Layers.
    </p>
    <p class="uc-hint uc-library-license">
      Includes Tabler Icons.{' '}
      <a href="/licenses/tabler-icons-MIT.txt" target="_blank" rel="noopener">
        MIT License
      </a>
    </p>
  </div>
</div>
