---
import '../styles/global.css';
import SiteFooter from '../components/SiteFooter.astro';
import AiBuilderMark from '../components/AiBuilderMark.astro';
import '../styles/site-header.css';
import HeaderIllustration from '../components/HeaderIllustration.astro';
import { cuteSurpriseIndex } from '../lib/surprise-catalog';
import { structuredData } from '../lib/structured-data';
import regularFont from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import boldFont from '@fontsource/inter/files/inter-latin-700-normal.woff2?url';
const {
  title = 'Clipart made simple.',
  description = 'Explore original seasonal clipart. Edit colors and layers, then download WebP and printable PDF files.',
  noindex = false,
  wide = false,
  image = '',
  imageAlt = title,
} = Astro.props;
const surprisePicks = cuteSurpriseIndex.slice(0, 48);
const browseLinks = [
  {
    label: 'Explore clipart',
    href: '/',
    description: 'Find something for your next idea.',
    icon: 'discover',
  },
  {
    label: 'Categories',
    href: '/categories/',
    description: 'Browse every subject in the library.',
    icon: 'grid',
  },
  {
    label: 'Collections',
    href: '/collections/',
    description: 'Thoughtful sets, ready to go together.',
    icon: 'layers',
  },
  {
    label: 'New clipart',
    href: '/new/',
    description: 'The latest additions to the collection.',
    icon: 'spark',
  },
  {
    label: 'Black & White',
    href: '/black-and-white/',
    description: 'Simple outlines and printable artwork.',
    icon: 'contrast',
  },
];
const resourceLinks = [
  {
    label: 'Project guides',
    href: '/guides/',
    description: 'Make something, step by step.',
    icon: 'book',
  },
  {
    label: 'For Teachers',
    href: '/for-teachers/',
    description: 'Ideas for the classroom.',
    icon: 'school',
  },
  {
    label: 'Print size calculator',
    href: '/print-size/',
    description: 'Choose a size that prints clearly.',
    icon: 'print',
  },
  {
    label: 'About UltraClipart',
    href: '/about/',
    description: 'A little more about our collection.',
    icon: 'info',
  },
];
const current = (path: string) => (Astro.url.pathname === path ? 'page' : undefined);
const browseCurrent =
  browseLinks.some((link) => Astro.url.pathname === link.href) ||
  Astro.url.pathname.startsWith('/clipart/') ||
  Astro.url.pathname.startsWith('/art/');
const resourcesCurrent =
  resourceLinks.some((link) => Astro.url.pathname === link.href) ||
  Astro.url.pathname.startsWith('/guides/');
const canonical = new URL(Astro.url.pathname, 'https://ultraclipart.com').href;
const releaseRevision = /^[a-f0-9]{40}$/.test(import.meta.env.PUBLIC_RELEASE_REVISION ?? '')
  ? import.meta.env.PUBLIC_RELEASE_REVISION
  : 'local';
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <link rel="preload" href={regularFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={boldFont} as="font" type="font/woff2" crossorigin />
    <meta name="viewport" content="width=device-width" />
    <meta name="build-revision" content={releaseRevision} />
    <title>{title} | UltraClipart</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow'} />
    <meta property="og:title" content={title + ' | UltraClipart'} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    {image && (
      <>
        <meta property="og:image" content={new URL(image, 'https://ultraclipart.com').href} />
        <meta property="og:image:alt" content={imageAlt} />
        <meta name="twitter:image" content={new URL(image, 'https://ultraclipart.com').href} />
        <meta name="twitter:image:alt" content={imageAlt} />
      </>
    )}
    <meta name="theme-color" content="#2865D2" />
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    <script
      type="application/ld+json"
      set:html={structuredData({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: 'UltraClipart',
        url: 'https://ultraclipart.com/',
        inLanguage: 'en-US',
      })}
    />
    <slot name="head" />
  </head>
  <body id="page-top">
    <a class="skip" href="#main">
      Skip to content
    </a>
    <header class="site-header" data-site-header>
      <div class="site-header-inner">
        <a class="brand site-brand" href="/" aria-label="UltraClipart home">
          <img src="/logo.svg" width="36" height="40" alt="" />
          <span>UltraClipart</span>
        </a>
        <button
          class="menu-button site-menu-button"
          type="button"
          aria-expanded="false"
          aria-controls="navigation"
        >
          <svg
            width="21"
            height="21"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path class="site-menu-lines" d="M4 6h16M4 12h16M4 18h16" />
            <path class="site-menu-close" d="m6 6 12 12M6 18 18 6" />
          </svg>
          <span>Menu</span>
        </button>
        <nav id="navigation" class="site-navigation" aria-label="Main navigation">
          <div class="site-navigation-links">
            <div class="site-nav-disclosure" data-nav-disclosure>
              <button
                id="site-browse-toggle"
                type="button"
                class="site-nav-trigger"
                data-current={browseCurrent ? 'true' : undefined}
                aria-expanded="false"
                aria-controls="site-browse-panel"
              >
                Browse
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  aria-hidden="true"
                >
                  <path d="m5 8 5 5 5-5" />
                </svg>
              </button>
              <div id="site-browse-panel" class="site-dropdown site-browse-dropdown" hidden>
                <div class="site-dropdown-heading">
                  <span>The clipart collection</span>
                  <a href="/categories/">
                    View all <span aria-hidden="true">→</span>
                  </a>
                </div>
                <div class="site-browse-content">
                  <div class="site-dropdown-links">
                    {browseLinks.map((link) => (
                      <a
                        href={link.href}
                        class="site-dropdown-link"
                        aria-current={current(link.href)}
                        aria-label={link.label}
                      >
                        <span class="site-link-icon" data-icon={link.icon}>
                          <HeaderIllustration kind={link.icon} />
                        </span>
                        <span>
                          <strong>{link.label}</strong>
                          <small>{link.description}</small>
                        </span>
                        <svg
                          class="site-link-arrow"
                          width="17"
                          height="17"
                          viewBox="0 0 20 20"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          aria-hidden="true"
                        >
                          <path d="M4 10h12m-5-5 5 5-5 5" />
                        </svg>
                      </a>
                    ))}
                  </div>
                  <a class="site-browse-feature" href="/categories/">
                    <div>
                      <img
                        src="/ai-examples/reference-theme-animals.webp"
                        width="180"
                        height="180"
                        alt=""
                        loading="lazy"
                      />
                      <img
                        src="/ai-examples/reference-theme-florals.webp"
                        width="120"
                        height="120"
                        alt=""
                        loading="lazy"
                      />
                    </div>
                    <strong>A world of little details.</strong>
                    <span>
                      Find your next favorite{' '}
                      <svg
                        width="16"
                        height="16"
                        viewBox="0 0 20 20"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        aria-hidden="true"
                      >
                        <path d="M4 10h12m-5-5 5 5-5 5" />
                      </svg>
                    </span>
                  </a>
                </div>
              </div>
            </div>
            <div class="site-nav-disclosure" data-nav-disclosure>
              <button
                id="site-resources-toggle"
                type="button"
                class="site-nav-trigger"
                data-current={resourcesCurrent ? 'true' : undefined}
                aria-expanded="false"
                aria-controls="site-resources-panel"
              >
                Resources
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  aria-hidden="true"
                >
                  <path d="m5 8 5 5 5-5" />
                </svg>
              </button>
              <div id="site-resources-panel" class="site-dropdown site-resources-dropdown" hidden>
                <div class="site-dropdown-heading">
                  <span>A little help with your next idea</span>
                </div>
                <div class="site-dropdown-links">
                  {resourceLinks.map((link) => (
                    <a
                      href={link.href}
                      class="site-dropdown-link"
                      aria-current={current(link.href)}
                      aria-label={link.label}
                    >
                      <span class="site-link-icon" data-icon={link.icon}>
                        <HeaderIllustration kind={link.icon} />
                      </span>
                      <span>
                        <strong>{link.label}</strong>
                        <small>{link.description}</small>
                      </span>
                      <svg
                        class="site-link-arrow"
                        width="17"
                        height="17"
                        viewBox="0 0 20 20"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        aria-hidden="true"
                      >
                        <path d="M4 10h12m-5-5 5 5-5 5" />
                      </svg>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </div>
          <div class="site-navigation-actions">
            <a href="/create/" class="site-studio-link" aria-current={current('/create/')}>
              <svg width="23" height="23" viewBox="0 0 28 28" fill="none" aria-hidden="true">
                <rect x="4" y="5" width="20" height="19" rx="4" fill="#eaf3ff" />
                <path
                  d="M12 6H7a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h13a2 2 0 0 0 2-2v-5"
                  stroke="#255f9f"
                  stroke-width="1.6"
                />
                <path
                  d="m11 17 1-5L21 3a2 2 0 0 1 4 4l-9 9-5 1Z"
                  fill="#79b9ff"
                  stroke="#174b84"
                  stroke-width="1.45"
                />
                <path d="m19 5 4 4m-12 8 4-1-3-3-1 4Z" fill="#174b84" />
              </svg>
              <span>Clipart Studio</span>
            </a>
            <a
              href="/ai-clipart-generator/"
              class="site-ai-link"
              aria-current={current('/ai-clipart-generator/')}
            >
              <AiBuilderMark id="header" size={34} />
              <span>AI Clipart Builder</span>
              <span class="site-new-badge">New</span>
            </a>
            <a
              href="/favorites/"
              class="favorites-link site-favorites-link"
              aria-label="Favorites"
              aria-current={current('/favorites/')}
            >
              <svg
                width="23"
                height="23"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M20.2 4.8a5.2 5.2 0 0 0-7.4 0l-.8.8-.8-.8a5.2 5.2 0 0 0-7.4 7.4L12 21l8.2-8.8a5.2 5.2 0 0 0 0-7.4Z" />
              </svg>
              <span>Favorites</span>
            </a>
          </div>
        </nav>
        <a
          class="site-surprise-link"
          href={`/art/${surprisePicks[0].id}/`}
          data-surprise-art={JSON.stringify(surprisePicks)}
          data-surprise-source={`/surprise-picks.json?v=${import.meta.env.PUBLIC_RELEASE_REVISION || 'local'}`}
        >
          <HeaderIllustration kind="surprise" />
          <span>
            <strong>Surprise me</strong>
            <span>A little reason to smile</span>
          </span>
        </a>
      </div>
    </header>
    <main id="main" class:list={['container', { wide }]}>
      <slot />
    </main>
    <SiteFooter />
    <script>
      import { initCuteSurprise } from '../scripts/cute-surprise';
      initCuteSurprise();
      import '../share/entry';
      const header = document.querySelector<HTMLElement>('[data-site-header]');
      if (header) {
        const menu = header.querySelector<HTMLButtonElement>('.menu-button')!;
        const navigation = header.querySelector<HTMLElement>('#navigation')!;
        const mobile = window.matchMedia('(max-width: 1100px)');
        const surprise = header.querySelector<HTMLAnchorElement>('.site-surprise-link')!;
        const placeSurprise = () => {
          if (mobile.matches) header.querySelector('.site-header-inner')!.append(surprise);
          else
            navigation.insertBefore(surprise, navigation.querySelector('.site-navigation-actions'));
        };
        placeSurprise();
        const disclosures = [...header.querySelectorAll<HTMLElement>('[data-nav-disclosure]')].map(
          (group) => ({
            group,
            trigger: group.querySelector<HTMLButtonElement>('.site-nav-trigger')!,
            panel: group.querySelector<HTMLElement>('.site-dropdown')!,
          }),
        );
        const setDisclosure = (item: (typeof disclosures)[number], open: boolean) => {
          item.trigger.setAttribute('aria-expanded', String(open));
          item.panel.hidden = !open;
        };
        const close = (restoreFocus = false) => {
          const active = disclosures.find(
            (item) => item.trigger.getAttribute('aria-expanded') === 'true',
          );
          disclosures.forEach((item) => setDisclosure(item, false));
          const wasMobileOpen = menu.getAttribute('aria-expanded') === 'true';
          menu.setAttribute('aria-expanded', 'false');
          header.classList.remove('menu-open');
          if (restoreFocus) (wasMobileOpen ? menu : active?.trigger)?.focus();
        };
        menu.addEventListener('click', () => {
          const open = menu.getAttribute('aria-expanded') !== 'true';
          menu.setAttribute('aria-expanded', String(open));
          header.classList.toggle('menu-open', open);
          disclosures.forEach((item) => setDisclosure(item, open));
        });
        disclosures.forEach((item) => {
          item.trigger.addEventListener('click', () => {
            const open = item.trigger.getAttribute('aria-expanded') !== 'true';
            if (!mobile.matches)
              disclosures
                .filter((other) => other !== item)
                .forEach((other) => setDisclosure(other, false));
            setDisclosure(item, open);
          });
          item.trigger.addEventListener('keydown', (event) => {
            if (event.key !== 'ArrowDown') return;
            event.preventDefault();
            if (!mobile.matches)
              disclosures
                .filter((other) => other !== item)
                .forEach((other) => setDisclosure(other, false));
            setDisclosure(item, true);
            item.panel.querySelector<HTMLAnchorElement>('a')?.focus();
          });
        });
        document.addEventListener('pointerdown', (event) => {
          if (!header.contains(event.target as Node)) close();
        });
        document.addEventListener('keydown', (event) => {
          if (
            event.key === 'Escape' &&
            (menu.getAttribute('aria-expanded') === 'true' ||
              disclosures.some((item) => !item.panel.hidden))
          ) {
            event.preventDefault();
            close(true);
          }
        });
        header.addEventListener('focusout', (event) => {
          if (
            !mobile.matches &&
            event.relatedTarget instanceof Node &&
            !header.contains(event.relatedTarget)
          )
            close();
        });
        navigation
          .querySelectorAll<HTMLAnchorElement>('a')
          .forEach((link) => link.addEventListener('click', () => close()));
        mobile.addEventListener('change', () => {
          close();
          placeSurprise();
        });
        window.addEventListener('pageshow', () => close());
      }
    </script>
    <p id="download-status" class="download-status" role="status" aria-live="polite" hidden></p>
    <script>
      import '../scripts/downloads';
    </script>
  </body>
</html>
<style>
  .download-status {
    position: fixed;
    inset: auto 18px 18px auto;
    z-index: 100;
    max-width: min(420px, calc(100vw - 36px));
    padding: 14px 18px;
    margin: 0;
    border: 1px solid #bacce5;
    border-radius: 12px;
    background: #fff;
    color: #142442;
    box-shadow: 0 5px 24px #14244224;
    font-size: 14px;
    line-height: 1.5;
  }
  .download-status[hidden] {
    display: none;
  }
  :global(a[download][aria-busy='true']) {
    cursor: progress;
    opacity: 0.7;
  }
</style>
