---
import Layout from '../../layouts/Layout.astro';
import CatalogCount from '../../components/CatalogCount.astro';
import Card from '../../components/Card.astro';
import {
  publishedArt as art,
  availableTopics,
  availableClusters,
  slugify,
  topicInCluster,
} from '../../lib/catalog';
export function getStaticPaths() {
  return availableClusters.map((c) => ({ params: { slug: slugify(c) }, props: { cluster: c } }));
}
const { cluster } = Astro.props;
const ts = availableTopics.filter((t) => topicInCluster(t, cluster));
const items = art.filter((a) => ts.some((t) => t.slug === a.topic));
---

<Layout
  title={cluster + ' Clipart Collection'}
  description={`Browse ${cluster.toLowerCase()} clipart subjects. Open an illustration to see its image, printable PDF and editing options.`}
  noindex={true}
  image={items[0]?.webp}
  imageAlt={items[0]?.alt}
  imageWidth={items[0]?.width}
  imageHeight={items[0]?.height}
>
  <section class="hero">
    <h1>{cluster}</h1>
    <p class="lead">
      Browse the subjects in this collection or open an illustration below to see its files.
    </p>
    <p>
      <CatalogCount kind="collection-artworks" countKey={slugify(cluster)} unit="illustration" />{' '}
      available ·{' '}
      <CatalogCount kind="collection-subjects" countKey={slugify(cluster)} unit="available topic" />
      .
    </p>
    <div class="chips" aria-label="Topics in this collection">
      {ts.map((t) => (
        <a href={`/clipart/${t.slug}/`}>{t.keyword}</a>
      ))}
    </div>
  </section>
  {items.length ? (
    <div class="gallery">
      {items.slice(0, 32).map((item) => (
        <Card item={item} />
      ))}
    </div>
  ) : (
    <div class="empty">
      <h2>In preparation</h2>
      <p>No illustrations are available in this collection yet.</p>
      <a href="/new/">Browse Available Artwork</a>
    </div>
  )}
  <div class="browse-more">
    <p>
      Explore{' '}
      <CatalogCount kind="collection-artworks" countKey={slugify(cluster)} unit="illustration" /> in
      this collection. Choose a topic above to see its artwork.
    </p>
    <a class="button primary" href="/search/">
      Search All Clipart
    </a>
  </div>
</Layout>
