---
import Layout from '../layouts/Layout.astro';
import { art } from '../lib/catalog';
const printable = [
  ...art.filter((a) => !a.editable && a.color === 'Black'),
  ...art.filter((a) => a.editable),
];
---

<Layout title="Black & White Clipart and Print Studio" noindex={true}>
  <section class="hero">
    <p class="eyebrow">The print studio</p>
    <h1>
      A fresh outline.
      <br />A blank page of possibilities.
    </h1>
    <p class="lead">
      Download a black-and-white drawing, or open layered artwork in the print studio.
    </p>
  </section>
  <div class="gallery print-gallery">
    {printable.slice(0, 32).map((a) => (
      <a class="art-card" href={a.editable ? `/edit/${a.id}/?mode=outline` : `/art/${a.id}/`}>
        <div class="art-picture">
          <img
            src={a.thumb}
            alt={a.alt}
            width="400"
            height="400"
            loading="lazy"
            style="filter:grayscale(1)"
          />
        </div>
        <div class="card-body">
          <h3 class="card-title">{a.title}</h3>
          <p>{a.editable ? 'Open print studio →' : 'View downloads →'}</p>
        </div>
      </a>
    ))}
  </div>
  <p class="notice">
    Layered artwork opens in the print studio for outline and grayscale adjustments. Black-and-white
    downloads open on their illustration page.
  </p>
  <div class="browse-more">
    <p>
      {printable.length > 32
        ? `Showing 32 of ${printable.length} illustrations for print projects.`
        : 'Choose a drawing for your next print project.'}
    </p>
    <a class="button primary" href="/search/">
      Browse all clipart →
    </a>
  </div>
</Layout>
