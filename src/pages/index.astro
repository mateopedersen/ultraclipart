---
import Layout from '../layouts/Layout.astro';
import Search from '../components/Search.astro';
import Card from '../components/Card.astro';
import CreateInvitation from '../components/CreateInvitation.astro';
import { art, topics, clusters, slugify } from '../lib/catalog';
const picks = ['pumpkin', 'ghost', 'bat', 'sunflower', 'apple', 'acorn', 'gift', 'heart'];
---

<Layout>
  <section class="hero home-hero">
    <div>
      <p class="eyebrow">A little art. Endless possibilities.</p>
      <h1>Clipart made simple.</h1>
      <p class="lead">For school, crafts and your next bright idea.</p>
      <Search />
      <div class="popular chips">
        <span>Popular searches:</span>
        {['pumpkin', 'ghost', 'fall', 'christmas'].map((t) => (
          <a href={`/search/?q=${t}`}>{t}</a>
        ))}
      </div>
    </div>
    <div class="hero-art">
      {art.slice(0, 3).map((a) => (
        <a href={`/art/${a.id}/`}>
          <img src={a.thumb} alt={a.alt} width="400" height="400" />
        </a>
      ))}
    </div>
  </section>
  <div class="section-head">
    <h2>Find your inspiration</h2>
    <a href="/categories/">Browse all 110 topics →</a>
  </div>
  <div class="topic-row">
    {picks.map((t) => {
      const a = art.find((a) => a.topic === t);
      return (
        <a class="topic-tile" href={`/clipart/${t}/`}>
          {a ? (
            <img src={a.thumb} alt="" width="100" height="90" loading="lazy" />
          ) : (
            <span class="topic-symbol">
              <svg
                viewBox="0 0 48 48"
                width="40"
                height="40"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="9" y="8" width="30" height="33" rx="5" />
                <path d="M17 8V5m14 3V5M9 17h30M18 29h12m-6-6v12" />
              </svg>
            </span>
          )}
          {t.charAt(0).toUpperCase() + t.slice(1)}
        </a>
      );
    })}
  </div>
  <div class="section-head">
    <h2>Fresh from the sketchbook</h2>
    <a href="/new/">Explore the pilot →</a>
  </div>
  <p class="notice">
    Our first collection is taking shape. Explore {art.length} original pilot illustrations, try the
    editor, and tell us what you think. More subjects are in preparation.
  </p>
  <div class="gallery">
    {art.slice(0, 12).map((item) => (
      <Card item={item} />
    ))}
  </div>
  <CreateInvitation />
  <section>
    <div class="section-head">
      <h2>Made for the season</h2>
      <a href="/collections/">All collections →</a>
    </div>
    <div class="collection-grid">
      {clusters
        .filter((c) =>
          ['Halloween', 'Thanksgiving & Autumn', 'Christmas & Winter', "Valentine's Day"].includes(
            c,
          ),
        )
        .map((c) => {
          const ts = topics.filter((t) => t.cluster === c);
          const a = art.find((a) => ts.some((t) => t.slug === a.topic));
          return (
            <a class="collection-card" href={`/collection/${slugify(c)}/`}>
              {a && <img src={a.thumb} alt="" width="90" height="90" />}
              <div>
                <strong>{c}</strong>
                <p>Little details for memorable projects.</p>
              </div>
            </a>
          );
        })}
    </div>
  </section>
  <div class="benefits">
    {[
      ['♡', 'Free to create', 'For personal and educational projects.'],
      ['↓', 'Two useful formats', 'Transparent WebP and printable PDF.'],
      ['✎', 'Make it your own', 'Edit colors, shapes and individual layers.'],
      ['⌂', 'Keep it private', 'Your edits stay in your browser.'],
    ].map(([icon, title, body]) => (
      <div>
        <div class="benefit-icon">{icon}</div>
        <strong>{title}</strong>
        <p>{body}</p>
      </div>
    ))}
  </div>
</Layout>
