---
import Layout from '../layouts/Layout.astro';
import HomeShowcase from '../components/HomeShowcase.astro';
import '../styles/home-alignment.css';
import Card from '../components/Card.astro';
import CreateInvitation from '../components/CreateInvitation.astro';
import HomeBenefits from '../components/HomeBenefits.astro';
import SeasonalShowcase from '../components/SeasonalShowcase.astro';
import { art, newestArt, topics } from '../lib/catalog';
import { diverseRecentArtwork } from '../lib/recent-artwork';
import collectionCopy from '../../data/collection-copy.json';
const categoryByTopic = new Map(topics.map((topic) => [topic.slug, topic.cluster]));
const artworkById = new Map(art.map((item) => [item.id, item]));
const recentPicks = diverseRecentArtwork(
  newestArt,
  (topic) => categoryByTopic.get(topic) ?? topic,
  15,
).map((item) => {
  const copy = collectionCopy[item.topic as keyof typeof collectionCopy];
  const featuredId = copy?.featured[0];
  const featured = featuredId ? artworkById.get(featuredId) : undefined;
  // A newly added package should introduce its subject, rather than repeat the
  // same alphabetically first character pose across every new fruit category.
  return featured?.published !== false &&
    featured?.indexable !== false &&
    featured?.createdAt === item.createdAt
    ? featured
    : item;
});
---

<Layout
  contentClass="home-page"
  title="Clipart for Personal & Classroom Projects"
  description="Browse clipart for cards, crafts and classrooms. Find flowers, food, school, sports, music and seasonal illustrations to download or edit in Clipart Studio."
>
  <HomeShowcase />
  <section class="home-recent" aria-labelledby="home-recent-title">
    <div class="section-head">
      <h2 id="home-recent-title">Recently Added</h2>
      <a class="home-section-link" href="/new/">
        View New Clipart
      </a>
    </div>
    <p>A selection from the latest additions to the catalog.</p>
    <div class="gallery home-recent-grid">
      {recentPicks.slice(0, 15).map((item) => (
        <Card item={item} />
      ))}
    </div>
  </section>
  <SeasonalShowcase />
  <CreateInvitation />
  <HomeBenefits />
</Layout>
