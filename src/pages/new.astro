---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import { art, newestArt } from '../lib/catalog';
---

<Layout title="New Clipart" noindex={true}>
  <section class="hero">
    <p class="eyebrow">The growing collection</p>
    <h1>Fresh from the sketchbook.</h1>
    <p>{art.length} illustrations for your next personal or classroom project.</p>
  </section>
  <div class="gallery">
    {newestArt.slice(0, 32).map((item) => (
      <Card item={item} />
    ))}
  </div>
  <div class="browse-more">
    <p>
      {art.length > 32
        ? `Showing 32 of ${art.length} illustrations. Use search to explore the full collection.`
        : 'Find the right subject, color or style for your next project.'}
    </p>
    <a class="button primary" href="/search/?sort=newest">
      Explore all clipart →
    </a>
  </div>
</Layout>
