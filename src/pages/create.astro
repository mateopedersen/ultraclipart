---
import Layout from '../layouts/Layout.astro';
import Editor from '../components/Editor.astro';
import StudioStarters from '../components/StudioStarters.astro';
import SceneStarters from '../components/SceneStarters.astro';
import { art as catalogue } from '../lib/catalog';

import { studioElements } from '../editor/elements';
import { structuredData, breadcrumbs } from '../lib/structured-data';
import '../styles/creator.css';

const heroArt = [
  'strawberry-fruit-trio-realistic-clipart',
  'holland-lop-rabbit-standing-realistic-clipart',
  'baby-elephant-standing-realistic-clipart',
].map((id) => catalogue.find((a) => a.id === id)!);
const workspace = { id: 'my-clipart', title: 'Let’s make something.', svg: '' };
---

<Layout
  title="Clipart Maker & Editor — Create, Customize & Print"
  description="Create your own clipart with high-resolution artwork, editable layers and curved text. Make stickers, coloring pages and printable designs. No account needed."
  wide={true}
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={structuredData(
        breadcrumbs([
          { name: 'Home', path: '/' },
          { name: 'Create your own clipart', path: '/create/' },
        ]),
      )}
    />
    <script
      type="application/ld+json"
      set:html={structuredData({
        '@context': 'https://schema.org',
        '@type': 'WebApplication',
        name: 'UltraClipart Creative Studio',
        url: 'https://ultraclipart.com/create/',
        applicationCategory: 'DesignApplication',
        operatingSystem: 'Web browser',
        browserRequirements: 'Requires JavaScript and a modern browser.',
        description:
          'A browser clipart maker with verified high-resolution artwork, editable vector elements, regional image editing, typography, and WebP or CMYK PDF export.',
        featureList: [
          'High-resolution clipart library',
          'Layered image and vector composition',
          'Regional recoloring and masks',
          'Curved text and typography',
          'Sticker and coloring page tools',
          'WebP and CMYK PDF export',
        ],
        inLanguage: 'en-US',
      })}
    />
  </Fragment>
  <div class="creator-page">
    <section class="studio-intro" aria-labelledby="studio-title">
      <div class="studio-intro-copy">
        <p class="studio-kicker">
          <span class="studio-live-dot" aria-hidden="true"></span> ULTRACLIPART CREATIVE STUDIO
        </p>
        <h1 id="studio-title">
          Create with
          <br />
          <span>every detail.</span>
        </h1>
        <p>
          Natural textures. Beautiful cutouts. Build your own composition with high-resolution
          artwork and precise editing tools.
        </p>
        <div class="studio-intro-meta">
          <span>{catalogue.length.toLocaleString()} artworks</span>
          <span>{studioElements.length} vector elements</span>
          <span>No account needed</span>
          <a href="#studio-starters">Explore templates</a>
        </div>
      </div>
      <div class="studio-intro-art studio-real-art" aria-hidden="true">
        <div class="studio-real-composition">
          <span class="studio-real-caption">Made with the artwork you can edit.</span>
          {heroArt.map((a, i) => (
            <img
              src={a.thumb}
              alt=""
              width={a.width}
              height={a.height}
              class={`studio-real-object studio-real-object-${i}`}
            />
          ))}
          <span class="studio-real-detail">Texture. Light. Every little detail.</span>
        </div>
      </div>
    </section>
    <nav class="studio-launch" aria-label="Start creating">
      <a href="#studio-workspace" data-studio-launch="elements">
        <img src={heroArt[0].thumb} alt="" width="70" height="70" />
        <span>
          <strong>Explore real details</strong>
          <small>High-resolution artwork library</small>
        </span>
      </a>
      <a href="#studio-workspace" data-studio-launch="create">
        <img src={heroArt[1].thumb} alt="" width="70" height="70" />
        <span>
          <strong>Build your composition</strong>
          <small>Image copies, drawing &amp; shapes</small>
        </span>
      </a>
      <a href="#studio-workspace" data-studio-launch="text">
        <span class="studio-type-preview" aria-hidden="true">
          Aa
        </span>
        <span>
          <strong>Make your words matter</strong>
          <small>Type styles, curves &amp; outlines</small>
        </span>
      </a>
      <a href="#studio-starters">
        <img src={heroArt[2].thumb} alt="" width="70" height="70" />
        <span>
          <strong>Start with a composition</strong>
          <small>Real artwork, editable layouts</small>
        </span>
      </a>
    </nav>
    <section id="studio-workspace" class="studio-workspace-shell" aria-label="Creative workspace">
      <div class="studio-workspace-label">
        <span>
          <span class="studio-live-dot" aria-hidden="true"></span> YOUR WORKSPACE
        </span>
        <a href="#studio-privacy">Saved locally · About your work</a>
      </div>
      <Editor creator art={workspace} />
    </section>

    <div id="studio-starters">
      <SceneStarters />
      <details class="studio-basic-starters">
        <summary>Explore simple vector starters</summary>
        <StudioStarters />
      </details>
    </div>
    <section id="studio-guide" class="studio-learning" aria-labelledby="guide-heading">
      <header class="studio-learning-heading">
        <p class="studio-kicker">FROM FIRST IDEA TO FINISHED CLIPART</p>
        <h2 id="guide-heading">
          Create it. Make it yours.
          <br />
          <span>Bring it to life.</span>
        </h2>
        <p>
          A clipart maker for thoughtful details: choose your artwork, customize every layer, then
          prepare a file for your next project.
        </p>
      </header>
      <ol class="studio-learning-grid">
        <li>
          <article class="studio-learning-card">
            <figure class="studio-learning-visual studio-learning-pieces">
              <img
                src={heroArt[0].thumb}
                alt="Detailed strawberries with green leaves, ready to add as a clipart image layer"
                width="440"
                height="440"
                loading="lazy"
              />
              <span class="studio-visual-tag">Your starting point</span>
            </figure>
            <div class="studio-learning-copy">
              <span class="studio-step">01 · CHOOSE &amp; COMPOSE</span>
              <h3>Build with beautiful artwork.</h3>
              <p>
                Explore {catalogue.length.toLocaleString()} artworks, add your own images, or start
                with {studioElements.length} editable vector elements. Combine individual pieces
                into something personal.
              </p>
              <a
                class="studio-learning-action"
                href="#studio-workspace"
                data-studio-launch="elements"
              >
                Explore the artwork library <span aria-hidden="true">↗</span>
              </a>
              <a class="studio-learning-secondary" href="/categories/">
                Browse clipart by subject
              </a>
            </div>
          </article>
        </li>
        <li>
          <article class="studio-learning-card">
            <figure class="studio-learning-visual studio-learning-edit">
              <div class="studio-selection-frame">
                <img
                  src={heroArt[1].thumb}
                  alt="Rabbit artwork inside a selection frame, illustrating independent image editing"
                  width="440"
                  height="440"
                  loading="lazy"
                />
                <i aria-hidden="true"></i>
                <i aria-hidden="true"></i>
                <i aria-hidden="true"></i>
                <i aria-hidden="true"></i>
              </div>
              <span class="studio-visual-tag">Every layer, your way</span>
            </figure>
            <div class="studio-learning-copy">
              <span class="studio-step">02 · REFINE &amp; PERSONALIZE</span>
              <h3>Give every detail a purpose.</h3>
              <p>
                Arrange layers, recolor selected regions and add editable text. Try curved
                lettering, outlines and shadows. Undo a change whenever you need to.
              </p>
              <a class="studio-learning-action" href="#studio-workspace" data-studio-launch="text">
                Open the text studio <span aria-hidden="true">↗</span>
              </a>
              <a class="studio-learning-secondary" href="/guides/make-a-classroom-label/">
                Follow the classroom label guide
              </a>
            </div>
          </article>
        </li>
        <li>
          <article class="studio-learning-card">
            <figure class="studio-learning-visual studio-learning-print">
              <div class="studio-paper-preview" aria-hidden="true">
                <b>A little adventure</b>
                <img src={heroArt[2].thumb} alt="" width="440" height="440" loading="lazy" />
                <span>Made by you</span>
              </div>
              <span class="studio-visual-tag">Ready for your project</span>
              <figcaption class="studio-sr-only">
                Example of a printable card made with elephant clipart and an editable caption
              </figcaption>
            </figure>
            <div class="studio-learning-copy">
              <span class="studio-step">03 · EXPORT &amp; CREATE</span>
              <h3>Take your idea off the screen.</h3>
              <p>
                Make stickers, coloring activities and printable layouts. Download a WebP image or
                CMYK PDF, and keep an editable project for your next visit.
              </p>
              <a
                class="studio-learning-action"
                href="#studio-workspace"
                data-studio-launch="studio"
              >
                Open print &amp; create <span aria-hidden="true">↗</span>
              </a>
              <a class="studio-learning-secondary" href="/guides/webp-pdf-and-editable-projects/">
                Compare image, PDF and project files
              </a>
            </div>
          </article>
        </li>
      </ol>
    </section>
    <section class="studio-answers" aria-labelledby="studio-answers-heading">
      <div>
        <p class="studio-kicker">A FEW USEFUL ANSWERS</p>
        <h2 id="studio-answers-heading">
          Your first project,
          <br />
          with confidence.
        </h2>
        <p>Clear choices for creating, saving and printing your clipart.</p>
        <a href="/guides/">
          See all project guides <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="studio-answer-list">
        <details open>
          <summary>How do I make my own clipart?</summary>
          <p>
            Choose an image in the artwork library, open a ready-made composition, or draw on a
            blank canvas. Add text and other elements, then use Layers to arrange your design. Use
            Smart Select for image regions and Recolor for vector colors.
          </p>
        </details>
        <details>
          <summary>Can I make stickers and coloring pages?</summary>
          <p>
            Yes. Print &amp; Create includes sticker borders, coloring-page controls and printable
            layouts. Complex images may need manual cleanup. Review your output before printing; the{' '}
            <a href="/print-size/">print size calculator</a> helps you choose a suitable size.
          </p>
        </details>
        <details>
          <summary>Which file should I download?</summary>
          <p>
            Choose Image for a WebP file, PDF for CMYK printing, and Save project to keep layers
            editable. PDF files over the standard 1 MB limit require an explicit larger-file choice.
            Read the <a href="/guides/webp-pdf-and-editable-projects/">download format guide</a> for
            details.
          </p>
        </details>
        <details>
          <summary>Do I need an account or a paid tool?</summary>
          <p>
            No account is needed for the studio. Editing runs in your browser. Your device's memory
            and the source image resolution determine the size and complexity of projects you can
            comfortably create.
          </p>
        </details>
      </div>
    </section>
    <section class="studio-trust" aria-label="Saving and artwork permissions">
      <article id="studio-privacy">
        <span class="studio-step">SAVE YOUR WORK</span>
        <h2>Private on your device.</h2>
        <p>
          Your imported files and edits are processed locally. Download an editable project to keep
          a reliable copy; clearing browser data removes local recovery.
        </p>
        <a href="/privacy/">How local editing works</a>
      </article>
      <article>
        <span class="studio-step">CREATE WITH CONFIDENCE</span>
        <h2>Know what you can use.</h2>
        <p>
          Your original work remains yours. UltraClipart artwork and templates are for personal and
          educational use. Import only artwork you have permission to use.
        </p>
        <a href="/license/">Read the artwork license</a>
      </article>
    </section>
    <noscript>
      <p class="notice">
        The creative studio needs JavaScript to draw, edit, and export. You can still{' '}
        <a href="/new/">browse and download the existing clipart</a>.
      </p>
    </noscript>
  </div>
</Layout>

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-studio-launch]').forEach((link) =>
    link.addEventListener('click', () => {
      if (['create', 'text'].includes(link.dataset.studioLaunch || ''))
        document.querySelector<HTMLButtonElement>('.uc-editor [data-work-mode=advanced]')?.click();
      if (link.dataset.studioLaunch === 'studio')
        document
          .querySelector<HTMLButtonElement>('.uc-editor button[data-work-mode=print]')
          ?.click();
      document
        .querySelector<HTMLButtonElement>(`.uc-editor [data-panel="${link.dataset.studioLaunch}"]`)
        ?.click();
    }),
  );
</script>
