---
import Layout from '../layouts/Layout.astro';
import Editor from '../components/Editor.astro';
import StudioStarters from '../components/StudioStarters.astro';
import SceneStarters from '../components/SceneStarters.astro';
import StudioWalkthrough from '../components/StudioWalkthrough.astro';
import StudioIcon from '../components/StudioIcon.astro';
import { proTools } from '../editor/smart/pro-catalog';
import { publishedArt as catalogue } from '../lib/catalog';
import { featuredStudioArt } from '../lib/studio-artwork';

import { studioElements } from '../editor/elements';
import { textStyles } from '../editor/text-styles';
import { structuredData, breadcrumbs } from '../lib/structured-data';
import '../styles/creator.css';

const heroArt = [
  'laptop-study-laptop-with-notebook-and-coffee',
  'robot-friendly-robot-reaching-out-to-say-hello',
  'music-acoustic-guitar-watercolor-clipart',
].map((id) => catalogue.find((a) => a.id === id)!);
const workspace = { id: 'my-clipart', title: 'My Clipart Project', svg: '' };
---

<Layout
  title="Clipart Maker & Editor — Create, Customize & Print"
  description="Create your own clipart with high-resolution artwork, editable layers and curved text. Make stickers, coloring pages and printable designs. No account needed."
  wide={true}
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={structuredData(
        breadcrumbs([
          { name: 'Home', path: '/' },
          { name: 'Create your own clipart', path: '/create/' },
        ]),
      )}
    />
    <script
      type="application/ld+json"
      set:html={structuredData({
        '@context': 'https://schema.org',
        '@type': 'WebApplication',
        name: 'UltraClipart Creative Studio',
        url: 'https://ultraclipart.com/create/',
        applicationCategory: 'DesignApplication',
        operatingSystem: 'Web browser',
        browserRequirements: 'Requires JavaScript and a modern browser.',
        description:
          'A browser clipart maker with verified high-resolution artwork, editable vector elements, regional image editing, typography, and WebP or CMYK PDF export.',
        featureList: [
          'High-resolution clipart library',
          'Layered image and vector composition',
          'Regional recoloring and masks',
          'Editable text style library',
          'Radial and spiral arrangements',
          'Automatic grid layouts and patterned backgrounds',
          'Canvas fitting and export boundary review',
          'Curved text and typography',
          'Sticker and coloring page tools',
          'WebP and CMYK PDF export',
        ],
        inLanguage: 'en-US',
      })}
    />
  </Fragment>
  <div class="creator-page">
    <section class="studio-intro studio-welcome" aria-labelledby="studio-title">
      <div class="studio-intro-copy">
        <h1 id="studio-title">
          Welcome to <span>Studio.</span>
        </h1>
        <p>
          A place to put your ideas together. Choose artwork, add your words and arrange every
          layer. Save a project to continue later, or download a finished design.
        </p>
        <div class="studio-intro-meta">
          <div>
            <strong>{featuredStudioArt.length.toLocaleString('en-US')}</strong>
            <span>Featured artworks</span>
          </div>
          <div>
            <strong>{studioElements.length.toLocaleString('en-US')}</strong>
            <span>Vector elements</span>
          </div>
          <div>
            <strong>{textStyles.length}</strong>
            <span>Text styles</span>
          </div>
        </div>
        <div class="studio-welcome-links">
          <a href="#studio-starters">Start with a ready-made design</a>
          <a href="#studio-guide">See how it works</a>
        </div>
      </div>
      <div class="studio-intro-art studio-real-art" aria-hidden="true">
        <div class="studio-real-composition">
          <div class="studio-artwork-samples">
            {heroArt.map((a, i) => (
              <figure>
                <div>
                  <img src={a.thumb} alt="" width={a.width} height={a.height} />
                </div>
                <figcaption>{['Everyday Life', 'Imagination', 'Music'][i]}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      </div>
    </section>
    <nav class="studio-launch" aria-label="Start creating">
      <a href="#studio-workspace" data-studio-launch="elements">
        <img src={heroArt[0].thumb} alt="" width="70" height="70" />
        <span>
          <strong>Choose Artwork</strong>
          <small>Search the library and add a picture</small>
        </span>
      </a>
      <a href="#studio-workspace" data-studio-launch="create">
        <img src={heroArt[1].thumb} alt="" width="70" height="70" />
        <span>
          <strong>Draw & Add Shapes</strong>
          <small>Make something from a blank canvas</small>
        </span>
      </a>
      <a href="#studio-workspace" data-studio-launch="text">
        <span class="studio-type-preview" aria-hidden="true">
          Aa
        </span>
        <span>
          <strong>Add Text</strong>
          <small>{textStyles.length} editable styles, curves &amp; outlines</small>
        </span>
      </a>
      <a href="#studio-workspace" data-studio-launch="studio">
        <StudioIcon name="studio" size={48} />
        <span>
          <strong>Open Studio Pro</strong>
          <small>{proTools.length} tools for layout, artwork &amp; print</small>
        </span>
      </a>
    </nav>
    <section
      id="studio-workspace"
      class="studio-workspace-shell"
      aria-labelledby="studio-workspace-title"
    >
      <Editor creator art={workspace} />
    </section>

    <div id="studio-starters">
      <SceneStarters />
      <details class="studio-basic-starters">
        <summary>Explore simple vector starters</summary>
        <StudioStarters />
      </details>
    </div>
    <StudioWalkthrough />
    <section class="studio-answers" aria-labelledby="studio-answers-heading">
      <div>
        <h2 id="studio-answers-heading">Studio Questions</h2>
        <p>Clear choices for creating, saving and printing your clipart.</p>
        <a href="/guides/">See All Project Guides</a>
      </div>
      <div class="studio-answer-list">
        <details open>
          <summary>How do I make my own clipart?</summary>
          <p>
            Choose an image in the artwork library, open a ready-made composition, or draw on a
            blank canvas. Add text and other elements, then use Layers to arrange your design. Use
            Smart Select for image regions and Recolor for vector colors.
          </p>
        </details>
        <details>
          <summary>Can I make stickers and coloring pages?</summary>
          <p>
            Yes. Studio Pro includes sticker borders, coloring-page controls and printable layouts.
            Complex images may need manual cleanup. Review your output before printing; the{' '}
            <a href="/print-size/">print size calculator</a> helps you choose a suitable size.
          </p>
        </details>
        <details>
          <summary>Which file should I download?</summary>
          <p>
            Choose Image for a WebP file, PDF for CMYK printing, and Save project to keep layers
            editable. PDF files over the standard 1 MB limit require an explicit larger-file choice.
            Read the <a href="/guides/webp-pdf-and-editable-projects/">download format guide</a> for
            details.
          </p>
        </details>
        <details>
          <summary>Do I need an account or a paid tool?</summary>
          <p>
            No account is needed for the studio. Editing runs in your browser. Your device's memory
            and the source image resolution determine the size and complexity of projects you can
            comfortably create.
          </p>
        </details>
      </div>
    </section>
    <section class="studio-trust" aria-label="Saving and artwork permissions">
      <article id="studio-privacy">
        <span class="studio-step">SAVE YOUR WORK</span>
        <h2>Private on your device.</h2>
        <p>
          Your imported files and edits are processed locally. Download an editable project to keep
          a reliable copy; clearing browser data removes local recovery. Sharing a file is your
          choice. Creating a public share link uploads only the finished image and its title, after
          you explicitly choose to publish it.
        </p>
        <a href="/privacy/">How local editing works</a>
      </article>
      <article>
        <span class="studio-step">Artwork Permissions</span>
        <h2>Know what you can use.</h2>
        <p>
          Your original work remains yours. UltraClipart artwork and templates are for personal and
          educational use. Import only artwork you have permission to use.
        </p>
        <a href="/license/">Read the artwork license</a>
      </article>
    </section>
    <noscript>
      <p class="notice">
        The creative studio needs JavaScript to draw, edit, and export. You can still{' '}
        <a href="/new/">browse and download the existing clipart</a>.
      </p>
    </noscript>
  </div>
</Layout>

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-studio-launch]').forEach((link) =>
    link.addEventListener('click', () => {
      if (['create', 'text'].includes(link.dataset.studioLaunch || ''))
        document.querySelector<HTMLButtonElement>('.uc-editor [data-work-mode=advanced]')?.click();
      if (link.dataset.studioLaunch === 'studio')
        document
          .querySelector<HTMLButtonElement>('.uc-editor button[data-work-mode=print]')
          ?.click();
      document
        .querySelector<HTMLButtonElement>(`.uc-editor [data-panel="${link.dataset.studioLaunch}"]`)
        ?.click();
    }),
  );
</script>
