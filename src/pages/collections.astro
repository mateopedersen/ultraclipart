---
import Layout from '../layouts/Layout.astro';
import CatalogCount from '../components/CatalogCount.astro';
import {
  availableClusters,
  availableTopics,
  publishedArt as art,
  slugify,
  topicInCluster,
} from '../lib/catalog';
---

<Layout
  title="Clipart Collections"
  description="Browse related clipart subjects together, from animals and food to holidays and classroom materials."
>
  <section class="hero">
    <h1>Clipart Collections</h1>
    <p class="lead">
      Browse related subjects together, from animals and food to holidays and classroom materials.
    </p>
  </section>
  <div class="category-grid">
    {availableClusters.map((c) => {
      const ts = availableTopics.filter((t) => topicInCluster(t, c));
      const items = art.filter((a) => ts.some((t) => t.slug === a.topic));
      return (
        <a class="category-card" href={`/collection/${slugify(c)}/`}>
          <div class="category-visual">
            {items[0] ? <img src={items[0].thumb} alt="" width="200" height="150" /> : c.charAt(0)}
          </div>
          <div>
            <h3>{c}</h3>
            <p>
              <CatalogCount kind="collection-artworks" countKey={slugify(c)} unit="illustration" />{' '}
              ·{' '}
              <CatalogCount
                kind="collection-subjects"
                countKey={slugify(c)}
                unit="available topic"
              />
            </p>
          </div>
        </a>
      );
    })}
  </div>
</Layout>
