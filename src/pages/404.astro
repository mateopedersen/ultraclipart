---
import Layout from '../layouts/Layout.astro';
import scene from '../../data/not-found-visual.json';
import TeacherSymbol from '../components/TeacherSymbol.astro';
import { publishedArt } from '../lib/catalog';
import '../styles/not-found.css';

const picture = (id: string, topic: string) =>
  publishedArt.find((item) => item.id === id) ??
  publishedArt.find((item) => item.topic === topic && item.alpha && !item.monochrome);
const subjects = [
  {
    title: 'Animals & Nature',
    detail: 'Animals, plants, and outdoor subjects',
    href: '/collection/animals-nature/',
    id: 'baby-elephant-standing-realistic-clipart',
    topic: 'baby-elephant',
  },
  {
    title: 'Hearts & Flowers',
    detail: 'Wreaths, flowers, and card illustrations',
    href: '/clipart/heart/',
    id: 'floral-heart-roses-wreath-clipart',
    topic: 'heart',
  },
  {
    title: 'Food & Fruit',
    detail: 'Ingredients, meals, and colorful fruit',
    href: '/collection/food-drink/',
    id: 'strawberry-fruit-trio-realistic-clipart',
    topic: 'strawberry',
  },
  {
    title: 'School & Learning',
    detail: 'Classroom objects and learning materials',
    href: '/collection/school-learning/',
    id: 'school-backpack-filled-with-pencils-classic-clipart',
    topic: 'school',
  },
].flatMap((subject) => {
  const image = picture(subject.id, subject.topic);
  return image ? [{ ...subject, image }] : [];
});
const routes = [
  {
    title: 'Your Favorites',
    copy: 'Find illustrations you have saved in this browser.',
    href: '/favorites/',
    icon: 'boards',
  },
  {
    title: 'Clipart Studio',
    copy: 'Combine artwork, arrange a layout, or add your own text.',
    href: '/create/',
    icon: 'edit',
  },
  {
    title: 'Download & Print Help',
    copy: 'Choose a file format and prepare your illustration for printing.',
    href: '/guides/webp-pdf-and-editable-projects/',
    icon: 'files',
  },
] as const;
---

<Layout
  title="Page Not Found"
  description="This page could not be found. Search UltraClipart, explore a subject, or return to the homepage to find an illustration."
  noindex={true}
  socialPage="/404/"
>
  <article class="not-found">
    <section class="nf-hero" aria-labelledby="nf-title">
      <div class="nf-copy">
        <p class="nf-error-code">
          <span>404</span> Page not found
        </p>
        <h1 id="nf-title">That page is missing.</h1>
        <p class="nf-description">
          This may be an old link or a mistyped address. Search the library, return home, or choose
          another place to start.
        </p>
      </div>
      <div class="nf-recovery">
        <form
          class="nf-search"
          action="/search/"
          method="get"
          role="search"
          aria-label="Search UltraClipart"
        >
          <label for="nf-query">Search for an illustration</label>
          <div class="nf-search-field">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="10.5" cy="10.5" r="6.5" />
              <path d="m16 16 5 5" />
            </svg>
            <input
              id="nf-query"
              name="q"
              type="search"
              maxlength="320"
              placeholder="A subject, style, or scene…"
              autocomplete="off"
            />
            <button type="submit">
              Find clipart<span aria-hidden="true"> →</span>
            </button>
          </div>
        </form>
        <div class="nf-actions">
          <a class="nf-home" href="/">
            <svg width="21" height="21" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="m3 10 9-7 9 7M5 9v12h5v-7h4v7h5V9" />
            </svg>
            Go to the homepage
          </a>
          <a class="nf-browse" href="/categories/">
            Browse all subjects<span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
      <figure class="nf-visual">
        <img
          class="nf-scene-image"
          src={scene.src}
          srcset={scene.srcset}
          sizes="(max-width: 420px) calc(100vw - 32px), (max-width: 760px) 420px, 540px"
          width={scene.width}
          height={scene.height}
          alt={scene.alt}
          title={scene.title}
          fetchpriority="high"
          decoding="async"
        />
      </figure>
    </section>

    <section class="nf-shortcuts" aria-labelledby="nf-shortcuts-title">
      <h2 id="nf-shortcuts-title">Choose where to go next</h2>
      <p class="nf-section-intro">
        Return to your saved illustrations, continue a design, or find help.
      </p>
      <div class="nf-shortcut-grid">
        {routes.map((route) => (
          <a href={route.href}>
            <TeacherSymbol kind={route.icon} size={68} />
            <span>
              <strong>{route.title}</strong>
              <span>{route.copy}</span>
            </span>
            <span class="nf-shortcut-arrow" aria-hidden="true">
              →
            </span>
          </a>
        ))}
      </div>
    </section>
    <section class="nf-subjects" aria-labelledby="nf-subjects-title">
      <header class="nf-section-heading">
        <div>
          <h2 id="nf-subjects-title">Explore a subject</h2>
          <p>Find an illustration for your next project.</p>
        </div>
        <a href="/categories/">
          View all subjects<span aria-hidden="true">→</span>
        </a>
      </header>
      <div class="nf-subject-grid">
        {subjects.map((subject) => (
          <a class="nf-subject" href={subject.href}>
            <span class="nf-subject-picture">
              <img
                src={subject.image.thumb}
                srcset={subject.image.thumbSrcSet}
                sizes="(max-width: 600px) 90px, 120px"
                alt={subject.image.alt}
                title={subject.image.title}
                width={subject.image.width}
                height={subject.image.height}
                loading="lazy"
                decoding="async"
              />
            </span>
            <span class="nf-subject-copy">
              <strong>{subject.title}</strong>
              <span>{subject.detail}</span>
            </span>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M4 12h15m-6-6 6 6-6 6" />
            </svg>
          </a>
        ))}
      </div>
    </section>

    <div class="nf-report">
      <img src="/illustrations/actions/contact.svg" width="46" height="46" alt="" loading="lazy" />
      <p>
        Found a broken link on UltraClipart?
        <br />
        <a href="/contact/">Send us the page address</a> so we can check it.
      </p>
    </div>
  </article>
</Layout>
