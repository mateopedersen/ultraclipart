---
import Layout from '../layouts/Layout.astro';
import { structuredData } from '../lib/structured-data';
import { styles } from '../ai/presets';
import '../styles/ai-builder.css';
const referenceAssets = {
  cabin: '/ai-examples/reference-ingredient-cabin.webp',
  trees: '/ai-examples/reference-ingredient-pine.webp',
  fox: '/ai-examples/reference-ingredient-fox.webp',
  paper: '/ai-examples/reference-style-paper.webp',
  ink: '/ai-examples/reference-style-ink.webp',
  flat: '/ai-examples/reference-style-flat.webp',
  paint: '/ai-examples/reference-style-paint.webp',
  concept0: '/ai-examples/reference-concept-cabin.webp',
  concept1: '/ai-examples/reference-concept-pond.webp',
  concept2: '/ai-examples/reference-concept-cottage.webp',
  concept3: '/ai-examples/reference-concept-woodland.webp',
  animals: '/ai-examples/reference-theme-animals.webp',
  florals: '/ai-examples/reference-theme-florals.webp',
  holidays: '/ai-examples/reference-theme-holidays.webp',
  school: '/ai-examples/reference-theme-school.webp',
  food: '/ai-examples/reference-theme-food.webp',
  nature: '/ai-examples/reference-theme-nature.webp',
};
const faq = [
  [
    'Is this AI clipart maker free?',
    'Yes. Each visitor can request up to two images per day while the shared daily capacity remains available. One click requests one image. There is no paid fallback. Limits reset at midnight UTC; your local reset time is shown above. Editing and downloading existing work do not use generation capacity.',
  ],
  [
    'Can I edit an AI-generated image?',
    'Open your result in Clipart Studio to recolor selected regions, refine masks, add editable text, arrange layers and create stickers. The generated image starts as one raster image. Select a region and extract it as an independent image layer when you want to move that object separately.',
  ],
  [
    'Will my image have a transparent background?',
    'The model creates a solid-background image. Remove white background clears light pixels connected to its edges and creates real transparency. Fur, pale subjects and complex backgrounds may need manual refinement with Smart Select in Studio. Preview the result before downloading.',
  ],
  [
    'Can I print my clipart or download PDF?',
    'Download a WebP here, or use Studio for a CMYK PDF and page layouts. Images are generated at 1024 × 1024 pixels. At 300 pixels per inch, that supports approximately 3.4 × 3.4 inches of native detail. Enlarging an image does not add detail. Studio checks its PDF size and print settings.',
  ],
  [
    'Where are my prompts and images stored?',
    'Your prompt goes to Cloudflare Workers AI to generate the image. Results and edits are saved only in this browser when local storage is available, for up to seven days and twelve images. They are not automatically published. Download a copy before clearing browser data. Read our privacy policy for request protection and usage records.',
  ],
  [
    'What rights do I have to generated images?',
    'AI output is separate from our catalog artwork license. FLUX.1 schnell uses an Apache 2.0 model license; that does not guarantee exclusive rights or clearance for an output. Cloudflare service terms and third-party rights still apply. Avoid protected characters, logos and private personal information. Review our AI usage terms before publishing.',
  ],
  [
    'How do I get a more accurate result?',
    'Describe the subject first, then the action, number of objects, colors and composition. Use specific visual details and leave space around the subject. The model can misunderstand counting, anatomy or lettering. Add precise wording as an editable text layer in Studio and inspect the image before using it.',
  ],
];
---

<Layout
  title="Free AI Clipart Generator & Editable Clipart Maker"
  description="Describe an idea, generate a clipart illustration with AI, then refine, edit and download it in UltraClipart Studio. Free daily generation capacity available."
  wide
  image="/ai-examples/baby-rabbit-640.webp"
  imageAlt="AI-generated baby rabbit illustration example"
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={structuredData({
        '@context': 'https://schema.org',
        '@type': 'WebApplication',
        name: 'UltraClipart AI Clipart Builder',
        url: 'https://ultraclipart.com/ai-clipart-generator/',
        applicationCategory: 'DesignApplication',
        operatingSystem: 'Web browser',
        description:
          'Generate clipart from a written idea, refine the image, and edit it in Clipart Studio. Limited free daily generation capacity.',
      })}
    />
    <script
      type="application/ld+json"
      set:html={structuredData({
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://ultraclipart.com/' },
          {
            '@type': 'ListItem',
            position: 2,
            name: 'AI Clipart Builder',
            item: 'https://ultraclipart.com/ai-clipart-generator/',
          },
        ],
      })}
    />
  </Fragment>
  <div class="ai-page" data-ai-builder>
    <div class="ai-workspace">
      <section class="ai-prompt-panel" aria-labelledby="ai-prompt-title">
        <div class="breadcrumb">
          <a href="/create/">Create</a>
          <span aria-hidden="true">›</span>
          <span>AI CLIPART BUILDER</span>
        </div>
        <div class="ai-heading">
          <h1>
            Start with an idea.
            <br />
            <span>Make it entirely yours.</span>
          </h1>
          <p>Build original clipart, piece by piece.</p>
        </div>
        <form id="ai-form">
          <h2 id="ai-prompt-title" class="ai-section-heading">
            <span>01</span> / Build your idea
          </h2>
          <label class="ai-field-label" for="ai-prompt">
            What are we making?
          </label>
          <div class="ai-prompt-input">
            <textarea
              id="ai-prompt"
              name="prompt"
              maxlength="1200"
              rows="2"
              required
              aria-describedby="ai-prompt-help"
            >A cozy cabin in the woods</textarea>
            <button
              type="button"
              data-ai-action="improve"
              aria-label="Add clipart details"
              title="Add clipart details"
            >
              <svg
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                aria-hidden="true"
              >
                <path d="m12 3 2.5 6.5L21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5L12 3ZM20 2v5m-2.5-2.5h5" />
              </svg>
            </button>
          </div>
          <div class="ai-input-meta">
            <small id="ai-prompt-help">Describe the subject, its details and your idea.</small>
            <output id="ai-count" for="ai-prompt">
              26 / 1200
            </output>
          </div>
          <div
            class="ai-ingredient-grid"
            role="group"
            aria-label="Build your idea with ingredients"
          >
            {[
              ['cabin', 'Cabin'],
              ['trees', 'Pine trees'],
              ['fox', 'Little fox'],
            ].map(([id, label]) => (
              <button type="button" data-ai-ingredient={id} aria-pressed="false">
                <span class="ai-selected-mark" aria-hidden="true">
                  <svg
                    width="15"
                    height="15"
                    viewBox="0 0 20 20"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.1"
                  >
                    <path d="m4 10 4 4 8-8" />
                  </svg>
                </span>
                <img
                  src={referenceAssets[id as keyof typeof referenceAssets]}
                  width="160"
                  height="130"
                  alt=""
                />
                <span>{label}</span>
              </button>
            ))}
            <button
              type="button"
              data-ai-ingredient="custom"
              class="ai-add-ingredient"
              aria-expanded="false"
              aria-controls="ai-custom-ingredient-panel"
            >
              <span class="ai-add-symbol" aria-hidden="true">
                <svg
                  width="25"
                  height="25"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                >
                  <path d="M12 4v16M4 12h16" />
                </svg>
              </span>
              <span>
                Add
                <br />
                ingredient
              </span>
            </button>
          </div>
          <div id="ai-custom-ingredient-panel" hidden>
            <label for="ai-ingredient-custom">Add a subject or detail</label>
            <div>
              <input
                id="ai-ingredient-custom"
                maxlength="80"
                placeholder="A stone path, a little owl…"
              />
              <button type="button" data-ai-add-ingredient>
                Add
              </button>
            </div>
          </div>
          <div id="ai-custom-ingredients"></div>
          <label class="ai-field-label" for="ai-style">
            Choose a visual language
          </label>
          <div class="ai-visual-styles" role="group" aria-label="Illustration style">
            {[
              ['cut-paper', 'Paper cut', 'paper'],
              ['black-white', 'Vintage ink', 'ink'],
              ['flat', 'Bold flat', 'flat'],
              ['watercolor', 'Soft paint', 'paint'],
            ].map(([id, label, image]) => (
              <button type="button" data-ai-style={id} aria-pressed={id === 'cut-paper'}>
                <span class="ai-selected-mark" aria-hidden="true">
                  <svg
                    width="15"
                    height="15"
                    viewBox="0 0 20 20"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.1"
                  >
                    <path d="m4 10 4 4 8-8" />
                  </svg>
                </span>
                <img
                  src={referenceAssets[image as keyof typeof referenceAssets]}
                  width="160"
                  height="140"
                  alt=""
                />
                <span>{label}</span>
              </button>
            ))}
          </div>
          <span class="ai-field-label">Make it feel…</span>
          <div class="ai-mood-palette">
            <div class="ai-moods" role="group" aria-label="Mood">
              <button type="button" data-ai-mood="cozy" aria-pressed="false">
                <svg width="24" height="24" viewBox="0 0 28 28" fill="none" aria-hidden="true">
                  <path d="M22 4C10 3 4 11 8 20c10 4 16-5 14-16Z" fill="#df8d40" stroke="#a05019" />
                  <path d="m5 25 14-17M9 18l8-1M13 13l-1-6" stroke="#773812" stroke-width="1.4" />
                </svg>
                Warm & cozy
              </button>
              <button type="button" data-ai-mood="minimal" aria-pressed="false">
                <svg
                  width="25"
                  height="25"
                  viewBox="0 0 28 28"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  aria-hidden="true"
                >
                  <path d="m3 23 8-13 6 9 4-6 5 10H3ZM9 13l3 3 2-2" />
                  <circle cx="20" cy="6" r="2" />
                </svg>
                Minimal
              </button>
            </div>
            <div class="ai-swatches" role="group" aria-label="Palette accents">
              {['#164e44', '#e5532f', '#ffe7c9', '#58a6d6', '#f49a28'].map((color, i) => (
                <button
                  type="button"
                  data-ai-swatch={color}
                  aria-label={`Use ${['forest green', 'rust orange', 'warm cream', 'sky blue', 'golden yellow'][i]} palette accent`}
                  aria-pressed="false"
                  style={`--swatch:${color}`}
                ></button>
              ))}
            </div>
          </div>
          <div class="ai-create-row">
            <label class="ai-transparent">
              <input id="ai-transparent" type="checkbox" />
              <span class="ai-alpha-symbol" aria-hidden="true"></span>Transparent background
            </label>
            <button class="primary ai-generate" type="submit" id="ai-generate" disabled>
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path
                  d="m10 2 2.2 6.8L19 11l-6.8 2.2L10 20l-2.2-6.8L1 11l6.8-2.2L10 2Z"
                  fill="currentColor"
                />
                <path d="m20 13 1 3 3 1-3 1-1 3-1-3-3-1 3-1 1-3Z" fill="currentColor" />
              </svg>
              Create my clipart
              <svg
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                aria-hidden="true"
              >
                <path d="M3 12h17m-6-6 6 6-6 6" />
              </svg>
            </button>
          </div>
          <p class="ai-generation-note">
            One image per generation · 1024 × 1024 · Free daily capacity
          </p>
          <div id="ai-turnstile" role="group" aria-label="Security verification"></div>
          <button type="button" id="ai-cancel" hidden>
            Stop waiting
          </button>
          <p id="ai-quota" class="ai-quota">
            Checking today’s free capacity…
          </p>
          <details class="ai-options">
            <summary>Fine-tune your idea & generation settings</summary>
            <div class="ai-options-fields">
              <label for="ai-style">All illustration styles</label>
              <select id="ai-style" name="style">
                {styles.map(([value, label]) => (
                  <option value={value} selected={value === 'cut-paper'}>
                    {label}
                  </option>
                ))}
              </select>
              <p id="ai-style-note" class="ai-style-note">
                Layered paper · subtle depth
              </p>
              <label for="ai-composition">Composition</label>
              <select id="ai-composition">
                <option value="centered">Centered subject</option>
                <option value="full-body">Full subject, nothing cropped</option>
                <option value="balanced">Balanced group</option>
                <option value="negative-space">Room for a caption</option>
              </select>
              <label for="ai-palette">Palette</label>
              <select id="ai-palette">
                <option value="prompt">Follow my description</option>
                <option value="natural">Natural colors</option>
                <option value="pastel">Soft pastels</option>
                <option value="vibrant">Vibrant colors</option>
                <option value="monochrome">Black & white</option>
              </select>
              <label for="ai-detail">Detail</label>
              <select id="ai-detail">
                <option value="detailed">Richly detailed</option>
                <option value="balanced">Balanced</option>
                <option value="simple">Simple</option>
              </select>
              <label for="ai-outline">Outline</label>
              <select id="ai-outline">
                <option value="none">Natural edges</option>
                <option value="fine">Fine outline</option>
                <option value="bold">Bold outline</option>
              </select>
              <label for="ai-margin">Space around the subject</label>
              <select id="ai-margin">
                <option value="standard">Comfortable margin</option>
                <option value="generous">Generous white space</option>
              </select>
              <div class="ai-prompt-tools">
                <button type="button" data-ai-action="random">
                  Surprise me
                </button>
                <button type="button" data-ai-action="copy">
                  Copy prompt
                </button>
                <button type="button" data-ai-action="reset">
                  Reset
                </button>
              </div>
              <p>
                Write in your language. A language model prepares an English description; your
                original is kept. Transparency uses local edge cleanup after generation and may need
                manual refinement.
              </p>
              <button type="button" id="ai-refresh-quota" class="ai-refresh-quota">
                Refresh availability
              </button>
            </div>
          </details>
          <p class="ai-privacy">
            Your prompt is processed by Cloudflare AI. Images aren’t published.{' '}
            <a href="/privacy/#ai-generation-and-protection">Privacy</a> ·{' '}
            <a href="/terms/#ai-clipart-builder">AI terms</a>
          </p>
        </form>
      </section>
      <section class="ai-preview-panel" aria-labelledby="ai-preview-title">
        <div class="ai-stepper" role="group" aria-label="Creative workflow">
          <button type="button" data-ai-step="idea" aria-current="step">
            <span>1</span>Idea
          </button>
          <i aria-hidden="true"></i>
          <button type="button" data-ai-step="make">
            <span>2</span>Make
          </button>
          <i aria-hidden="true"></i>
          <button type="button" data-ai-step="refine" disabled>
            <span>3</span>Refine
          </button>
        </div>
        <div id="ai-concept-board" class="ai-concept-board" data-view="grid">
          <div class="ai-board-heading">
            <div>
              <h2 id="ai-preview-title">
                <span>02</span> / Your first concepts
              </h2>
              <p>Choose a direction, then make it your own.</p>
            </div>
            <div class="ai-board-views">
              <label class="sr-only" for="ai-concept-count">
                Recent concepts to display
              </label>
              <select id="ai-concept-count">
                <option value="2">2 recent concepts</option>
                <option value="4" selected>
                  4 recent concepts
                </option>
                <option value="8">8 recent concepts</option>
              </select>
              <button type="button" data-ai-view="grid" aria-label="Grid view" aria-pressed="true">
                <svg
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <rect x="2" y="2" width="8" height="8" rx="1.5" />
                  <rect x="14" y="2" width="8" height="8" rx="1.5" />
                  <rect x="2" y="14" width="8" height="8" rx="1.5" />
                  <rect x="14" y="14" width="8" height="8" rx="1.5" />
                </svg>
              </button>
              <button type="button" data-ai-view="list" aria-label="List view" aria-pressed="false">
                <svg
                  width="25"
                  height="25"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  aria-hidden="true"
                >
                  <path d="M8 5h13M8 12h13M8 19h13M3 5h.1M3 12h.1M3 19h.1" />
                </svg>
              </button>
            </div>
          </div>
          <p id="ai-status" class="ai-status" role="status" aria-live="polite">
            Try a starting point below, or describe your own idea.
          </p>
          <span id="ai-state" class="ai-state">
            Ready for an idea
          </span>
          <div id="ai-empty" class="ai-empty">
            <div class="ai-concept-grid">
              {[0, 1, 2, 3].map((number) => (
                <button
                  type="button"
                  class:list={['ai-concept', { 'ai-concept-main': number === 0 }]}
                  data-ai-concept={number}
                  aria-label={`Choose example concept ${number + 1}`}
                  aria-pressed={number === 0}
                >
                  <span class="ai-concept-selection">
                    <svg
                      width="17"
                      height="17"
                      viewBox="0 0 20 20"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      aria-hidden="true"
                    >
                      <path d="m4 10 4 4 8-8" />
                    </svg>
                    Catalog example
                  </span>
                  {number === 0 ? (
                    <span
                      class="ai-catalog-scene"
                      role="img"
                      aria-label="Catalog inspiration: a cozy cabin with pine trees and a fox"
                    >
                      <span class="ai-scene-sun"></span>
                      <img
                        class="ai-scene-pines"
                        src={referenceAssets.trees}
                        width="320"
                        height="320"
                        alt=""
                      />
                      <img
                        class="ai-scene-cabin"
                        src={referenceAssets.concept0}
                        width="640"
                        height="640"
                        alt=""
                      />
                      <img
                        class="ai-scene-fox"
                        src={referenceAssets.fox}
                        width="320"
                        height="320"
                        alt=""
                      />
                    </span>
                  ) : (
                    <img
                      src={referenceAssets[`concept${number}` as keyof typeof referenceAssets]}
                      width="640"
                      height="640"
                      alt={`Catalog illustration direction ${number + 1}, example only`}
                    />
                  )}
                </button>
              ))}
            </div>
            <p class="ai-example-note">
              Catalog inspiration, not generated results. Create one new image from your own
              description.
            </p>
          </div>
          <div class="ai-generated-layout">
            <div class="ai-preview" id="ai-preview">
              <canvas
                id="ai-canvas"
                width="1024"
                height="1024"
                aria-label="Your generated artwork preview"
                hidden
              ></canvas>
              <img
                id="ai-before"
                src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs="
                width="1024"
                height="1024"
                alt="Original generated image before local edits"
                hidden
              />
            </div>
            <div id="ai-concepts" class="ai-real-concepts" hidden></div>
          </div>
          <div class="ai-canvas-meta">
            <span id="ai-dimensions">Native output · 1024 × 1024</span>
            <button type="button" data-ai-action="compare" disabled aria-pressed="false">
              Compare original
            </button>
          </div>
          <div class="ai-board-actions">
            <button type="button" data-ai-action="studio" disabled>
              <svg
                width="23"
                height="23"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <path d="M3 6h18M3 12h18M3 18h18M8 3v6m9 0v6M9 15v6" />
              </svg>
              Refine design
            </button>
            <button type="button" data-ai-action="again" disabled>
              <svg
                width="23"
                height="23"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="m12 2 9 5v10l-9 5-9-5V7l9-5Zm0 10 9-5M12 12 3 7m9 5v10M7 5l10 5" />
                <path d="M7 11v3m10-2v3" />
              </svg>
              Make a variation
            </button>
            <button type="button" data-ai-action="download" disabled>
              <svg
                width="23"
                height="23"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <path d="M12 2v13m-5-5 5 5 5-5M3 15v6h18v-6" />
              </svg>
              Download Image
            </button>
            <button type="button" class="primary" data-ai-action="pdf" disabled>
              <svg
                width="23"
                height="23"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <path d="M12 2v13m-5-5 5 5 5-5M3 15v6h18v-6" />
              </svg>
              Download PDF
            </button>
            <button
              type="button"
              class="ai-share-action"
              data-ai-action="share"
              aria-label="Share your creation"
              disabled
            >
              <svg
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
                focusable="false"
              >
                <path
                  d="m8.5 10.5 7-4m-7 7 7 4"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                />
                <circle cx="6" cy="12" r="3.2" fill="#d7e9ff" stroke="#2160b4" stroke-width="1.5" />
                <circle cx="18" cy="5" r="3.2" fill="#a5dfce" stroke="#237768" stroke-width="1.5" />
                <circle
                  cx="18"
                  cy="19"
                  r="3.2"
                  fill="#ffdc9c"
                  stroke="#9b651a"
                  stroke-width="1.5"
                />
              </svg>{' '}
              Share
            </button>
          </div>
          <p class="ai-action-note">
            Refine and download your own result. Variations use one additional generation.
          </p>
        </div>
        <details id="ai-refine-tools" class="ai-refine-tools ai-result-only">
          <summary>Local image tools & project download</summary>
          <fieldset class="ai-pdf-settings">
            <legend>Printable PDF</legend>
            <label for="ai-pdf-paper">Paper size</label>
            <select id="ai-pdf-paper">
              <option value="Letter">US Letter</option>
              <option value="A4">A4</option>
            </select>
            <label class="ai-pdf-large">
              <input type="checkbox" id="ai-pdf-large" />
              Allow a PDF larger than 1 MB
            </label>
            <p>Detailed artwork may need a larger file. The default size guard stays on.</p>
          </fieldset>
          <div class="ai-local-tools ai-result-only" role="group" aria-label="Local image tools">
            <button type="button" data-ai-action="undo" disabled aria-label="Undo image edit">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                aria-hidden="true"
              >
                <path d="M9 4 4 9l5 5M4 9h10a6 6 0 0 1 0 12" />
              </svg>
              <span>Undo</span>
            </button>
            <button type="button" data-ai-action="redo" disabled aria-label="Redo image edit">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                aria-hidden="true"
              >
                <path d="m15 4 5 5-5 5m5-5H10a6 6 0 0 0 0 12" />
              </svg>
              <span>Redo</span>
            </button>
            <button type="button" data-ai-action="rotate" disabled>
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M20 7v6h-6M19 12a7 7 0 1 0-1 6" />
              </svg>
              Rotate 90°
            </button>
            <button type="button" data-ai-action="flip" disabled>
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M12 3v18M3 7h5v10H3zM16 7h5v10h-5z" />
              </svg>
              Flip
            </button>
            <button type="button" data-ai-action="trim" disabled>
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M3 8V3h5m8 0h5v5M3 16v5h5m8 0h5v-5M8 8h8v8H8z" />
              </svg>
              Trim empty edges
            </button>
            <button type="button" data-ai-action="bw" disabled>
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Zm0 0v18" />
              </svg>
              Black & white
            </button>
          </div>
          <details class="ai-local-options ai-result-only">
            <summary>Background, size & print quality</summary>
            <div class="ai-refine-grid">
              <label>
                White-background tolerance{' '}
                <input id="ai-tolerance" type="range" min="10" max="90" value="35" />
                <span>Only light areas touching an image edge are removed.</span>
              </label>
              <button type="button" data-ai-action="cutout" disabled>
                Remove white background
              </button>
              <label>
                Background color <input id="ai-background" type="color" value="#ffffff" />
              </label>
              <button type="button" data-ai-action="background" disabled>
                Apply solid background
              </button>
              <label>
                Width in pixels{' '}
                <input id="ai-resize" type="number" min="64" max="2048" value="1024" step="1" />
              </label>
              <button type="button" data-ai-action="resize" disabled>
                Resize proportionally
              </button>
            </div>
            <fieldset class="ai-crop-fields">
              <legend>Crop to a rectangle</legend>
              <label>
                Left (px)
                <input id="ai-crop-x" type="number" min="0" value="0" />
              </label>
              <label>
                Top (px)
                <input id="ai-crop-y" type="number" min="0" value="0" />
              </label>
              <label>
                Width (px)
                <input id="ai-crop-width" type="number" min="64" value="1024" />
              </label>
              <label>
                Height (px)
                <input id="ai-crop-height" type="number" min="64" value="1024" />
              </label>
              <button type="button" data-ai-action="crop" disabled>
                Apply crop
              </button>
            </fieldset>
            <p id="ai-quality">
              The original image is 1024 px wide: about 3.4 inches at 300 PPI. Downloading at a
              higher size does not create new detail.
            </p>
            <p>
              Fine fur, white subjects and enclosed gaps may need manual mask refinement.{' '}
              <button type="button" data-ai-action="studio" disabled>
                Refine in Studio
              </button>
            </p>
          </details>
          <details id="ai-used-prompt" class="ai-local-options" hidden>
            <summary>See the description used by the model</summary>
            <p id="ai-used-prompt-text"></p>
          </details>
          <button type="button" data-ai-action="project" disabled>
            Save editable project
          </button>
        </details>
        <details class="ai-history-section">
          <summary>
            Your recent images <span>Saved on this device</span>
          </summary>
          <div class="ai-history-heading">
            <h3>On this device</h3>
            <span id="ai-history-count">0 images</span>
          </div>
          <div id="ai-history" class="ai-history">
            <p class="ai-small">Your recent results will appear here.</p>
          </div>
          <p class="ai-small" id="ai-storage-note">
            Up to 12 results · saved for 7 days in this browser. Download a project to keep it
            longer.
          </p>
          <button class="ai-clear" type="button" data-ai-action="clear">
            Clear saved AI images
          </button>
        </details>
        <p class="ai-model-note">
          Images by FLUX.1 schnell. Prompt assistance:{' '}
          <a href="https://huggingface.co/meta-llama/Llama-3.1-8B-Instruct/blob/main/LICENSE">
            Built with Llama
          </a>
          . Local edits use no generation quota.
        </p>
      </section>
    </div>
    <section class="ai-themes" aria-labelledby="ai-themes-title">
      <div>
        <h2 id="ai-themes-title">
          Or begin with a theme <span aria-hidden="true">→</span>
        </h2>
        <p>
          Quick starters to spark
          <br />
          your imagination.
        </p>
      </div>
      <div class="ai-theme-grid">
        {[
          ['animals', 'Animals'],
          ['florals', 'Florals'],
          ['holidays', 'Holidays'],
          ['school', 'School'],
          ['food', 'Food'],
          ['nature', 'Nature'],
        ].map(([id, label]) => (
          <button type="button" data-ai-theme={id}>
            <img
              src={referenceAssets[id as keyof typeof referenceAssets]}
              width="240"
              height="130"
              alt=""
              loading="lazy"
            />
            <span>{label}</span>
          </button>
        ))}
      </div>
    </section>
    <section class="ai-how" aria-labelledby="ai-how-title">
      <p class="ai-eyebrow">From an idea to a finished piece</p>
      <h2 id="ai-how-title">Create clipart with AI. Finish it with care.</h2>
      <div>
        <article>
          <span>1</span>
          <h3>Describe what matters</h3>
          <p>
            Name your subject, its action and the details that make it yours. Choose an illustration
            style and leave a little space around the edges.
          </p>
        </article>
        <article>
          <span>2</span>
          <h3>Inspect and refine</h3>
          <p>
            Check the pose, small details and any lettering. Compare local edits with the original,
            remove a simple white background and keep the version you like.
          </p>
        </article>
        <article>
          <span>3</span>
          <h3>Make something useful</h3>
          <p>
            Open <a href="/create/">Clipart Studio</a> to add editable text, build a sticker or
            arrange a printable page. Our <a href="/guides/">project guides</a> explain the next
            steps.
          </p>
        </article>
      </div>
    </section>
    <section class="ai-faq" aria-labelledby="ai-faq-title">
      <div>
        <p class="ai-eyebrow">A few things to know</p>
        <h2 id="ai-faq-title">An idea is only the beginning.</h2>
        <p>
          Real model generation, practical editing tools and clear limits. You stay in charge of the
          final result.
        </p>
        <a href="/categories/">Explore ready-made clipart →</a>
      </div>
      <div>
        {faq.map(([q, a]) => (
          <details>
            <summary>{q}</summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
  <script>
    import '../ai/client';
  </script>
</Layout>

<style>
  .ai-board-actions .ai-share-action {
    grid-column: 1 / -1;
    justify-content: center;
  }
</style>
