---
import ContentLink from '../components/ContentLink.astro';
import Layout from '../layouts/Layout.astro';
import AiChoicePicker from '../components/AiChoicePicker.astro';
import AiColorSwatches from '../components/AiColorSwatches.astro';
import { structuredData } from '../lib/structured-data';
import { styles } from '../ai/presets';
import { builderColors } from '../ai/colors';
import {
  examples,
  ideaCategories,
  featuredIdeaIds,
  featuredIngredientIds,
  visualStyleReferences,
} from '../ai/ideas';
import { publishedArt } from '../lib/catalog';
import '../styles/ai-builder.css';
import '../styles/ai-ideas.css';
import '../styles/ai-choice-picker.css';
import '../styles/ai-builder-workspace.css';
const quickColors = new Set(['#1769d5', '#164e44', '#e5532f', '#ffe7c9', '#f49a28', '#d94f78']);
const byId = new Map(publishedArt.map((item) => [item.id, item]));
const ideaCards = Array.from(
  {
    length: Math.max(
      ...ideaCategories.map(
        ([category]) => examples.filter((item) => item.category === category).length,
      ),
    ),
  },
  (_, round) =>
    ideaCategories.flatMap(([category]) => {
      const example = examples.filter((item) => item.category === category)[round];
      const artwork = example && byId.get(example.artwork);
      return artwork
        ? [
            {
              ...example,
              image: artwork.thumb,
              imageSrcSet: artwork.thumbSrcSet,
              alt: artwork.alt,
              imageTitle: artwork.title,
            },
          ]
        : [];
    }),
).flat();
const starterCards = featuredIdeaIds.flatMap((id) => {
  const example = ideaCards.find((item) => item.id === id);
  return example ? [example] : [];
});
const styleCards = visualStyleReferences.flatMap((reference) => {
  const artwork = byId.get(reference.artwork);
  return artwork
    ? [
        {
          ...reference,
          image: artwork.thumb,
          imageSrcSet: artwork.thumbSrcSet,
          alt: artwork.alt,
          imageTitle: artwork.title,
        },
      ]
    : [];
});
const categoryLabel = (id: string) => ideaCategories.find(([key]) => key === id)?.[1] || id;
const faq = [
  [
    'Is this AI clipart maker free?',
    'Yes. Each visitor can request up to two images per day while the shared daily capacity remains available. One click requests one image. There is no paid fallback. Limits reset at midnight UTC; your local reset time is shown above. Editing and downloading existing work do not use generation capacity.',
  ],
  [
    'Can I edit the result?',
    'Open your result in Clipart Studio to recolor selected regions, refine masks, add editable text, arrange layers and create stickers. The generated image starts as one raster image. Select a region and extract it as an independent image layer when you want to move that object separately.',
  ],
  [
    'Will my image have a transparent background?',
    'The model creates a solid-background image. Remove white background clears light pixels connected to its edges and creates real transparency. Fur, pale subjects and complex backgrounds may need manual refinement with Smart Select in Studio. Preview the result before downloading.',
  ],
  [
    'Can I print my clipart or download PDF?',
    'Download a WebP here, or use Studio for a CMYK PDF and page layouts. Images are generated at 1024 × 1024 pixels. At 300 pixels per inch, that supports approximately 3.4 × 3.4 inches of native detail. Enlarging an image does not add detail. Studio checks its PDF size and print settings.',
  ],
  [
    'Where are my prompts and images stored?',
    'Your prompt goes to Cloudflare Workers AI to generate the image. Results and edits are saved only in this browser when local storage is available, for up to seven days and twelve images. They are not automatically published. Download a copy before clearing browser data. Read our privacy policy for request protection and usage records.',
  ],
  [
    'What rights do I have to generated images?',
    'AI output is separate from our catalog artwork license. FLUX.1 schnell uses an Apache 2.0 model license; that does not guarantee exclusive rights or clearance for an output. Cloudflare service terms and third-party rights still apply. Avoid protected characters, logos and private personal information. Review our AI usage terms before publishing.',
  ],
  [
    'How do I get a more accurate result?',
    'Describe the subject first, then the action, number of objects, colors and composition. Use specific visual details and leave space around the subject. The model can misunderstand counting, anatomy or lettering. Add precise wording as an editable text layer in Studio and inspect the image before using it.',
  ],
];
---

<Layout
  title="Free AI Clipart Generator & Editable Clipart Maker"
  description="Describe an idea, generate a clipart illustration with AI, then refine, edit and download it in UltraClipart Studio. Free daily generation capacity available."
  wide
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={structuredData({
        '@context': 'https://schema.org',
        '@type': 'WebApplication',
        name: 'UltraClipart AI Clipart Builder',
        url: 'https://ultraclipart.com/ai-clipart-generator/',
        applicationCategory: 'DesignApplication',
        operatingSystem: 'Web browser',
        description:
          'Generate clipart from a written idea, refine the image, and edit it in Clipart Studio. Limited free daily generation capacity.',
      })}
    />
    <script
      type="application/ld+json"
      set:html={structuredData({
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://ultraclipart.com/' },
          {
            '@type': 'ListItem',
            position: 2,
            name: 'AI Clipart Builder',
            item: 'https://ultraclipart.com/ai-clipart-generator/',
          },
        ],
      })}
    />
  </Fragment>
  <div class="ai-page" data-ai-builder>
    <div class="ai-workspace">
      <section class="ai-prompt-panel" aria-labelledby="ai-prompt-title">
        <div class="breadcrumb">
          <a href="/create/">Create</a>
          <span aria-hidden="true">›</span>
          <span>AI Clipart Builder</span>
        </div>
        <div class="ai-heading">
          <h1>
            Create Clipart
            <br />
            <span>From a Description</span>
          </h1>
          <p>Describe an image or choose an example to get started.</p>
        </div>
        <form id="ai-form">
          <h2 id="ai-prompt-title" class="ai-section-heading">
            <span>01</span> / Build Your Idea
          </h2>
          <div class="ai-description-field">
            <label class="ai-field-label ai-description-label" for="ai-prompt">
              <img
                class="ai-field-symbol"
                src="/illustrations/builder/pencil.svg"
                alt=""
                width="30"
                height="30"
              />
              Describe Your Image
            </label>
            <div class="ai-prompt-input">
              <textarea
                id="ai-prompt"
                name="prompt"
                maxlength="1200"
                rows="2"
                required
                aria-describedby="ai-prompt-help"
                placeholder="A child reading a book, a birthday cake, a bunch of sunflowers…"
              ></textarea>
            </div>
            <div class="ai-input-meta">
              <small id="ai-prompt-help">
                Name the subject, what it is doing and a few details.
              </small>
              <output id="ai-count" for="ai-prompt">
                0 / 1200
              </output>
            </div>
            <div class="ai-description-tools">
              <button type="button" data-ai-action="improve" class="ai-description-assist">
                <img src="/illustrations/builder/pencil.svg" alt="" width="28" height="28" />
                Add Clipart Details
              </button>
            </div>
          </div>
          <a class="ai-ideas-jump" href="#ai-idea-library">
            See {ideaCards.length} Example Ideas
          </a>
          <section class="ai-section-card ai-subject-section" aria-label="Subjects and details">
            <div class="ai-ingredient-heading">
              <label class="ai-field-label ai-illustrated-label" for="ai-ingredient-category">
                <img
                  class="ai-field-symbol"
                  src="/illustrations/builder/layers.svg"
                  alt=""
                  width="28"
                  height="28"
                />
                Add a Subject or Detail
              </label>
              <select id="ai-ingredient-category" aria-controls="ai-ingredient-options">
                <option
                  value="featured"
                  data-ai-choice-image={
                    ideaCards.find((idea) => idea.id === featuredIngredientIds[0])?.image
                  }
                  data-ai-choice-alt={
                    ideaCards.find((idea) => idea.id === featuredIngredientIds[0])?.alt
                  }
                  data-ai-choice-title={
                    ideaCards.find((idea) => idea.id === featuredIngredientIds[0])?.imageTitle
                  }
                  data-ai-choice-detail="A Varied Selection to Get Started"
                >
                  Suggested Details
                </option>
                {ideaCategories.map(([id, label]) => (
                  <option
                    value={id}
                    data-ai-choice-image={ideaCards.find((idea) => idea.category === id)?.image}
                    data-ai-choice-alt={ideaCards.find((idea) => idea.category === id)?.alt}
                    data-ai-choice-title={
                      ideaCards.find((idea) => idea.category === id)?.imageTitle
                    }
                    data-ai-choice-detail={ideaCards
                      .filter((idea) => idea.category === id)
                      .slice(0, 2)
                      .map((idea) => idea.label)
                      .join(' · ')}
                  >
                    {label}
                  </option>
                ))}
              </select>
            </div>
            <p class="ai-control-help">
              Optional: choose up to eight details, or write your own below.
            </p>
            <div
              id="ai-ingredient-options"
              class="ai-ingredient-grid"
              role="group"
              aria-label="Add subjects to your description"
            >
              {ideaCards.map((example) => (
                <button
                  type="button"
                  data-ai-ingredient={example.id}
                  data-ai-ingredient-category={example.category}
                  aria-pressed="false"
                  hidden={!featuredIngredientIds.includes(example.id)}
                >
                  <span class="ai-selected-mark" aria-hidden="true">
                    <svg
                      width="15"
                      height="15"
                      viewBox="0 0 20 20"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.1"
                    >
                      <path d="m4 10 4 4 8-8" />
                    </svg>
                  </span>
                  <img
                    src={example.image}
                    srcset={example.imageSrcSet}
                    sizes="(max-width: 540px) 40vw, 180px"
                    title={example.imageTitle}
                    width="160"
                    height="140"
                    alt={example.alt}
                    loading="lazy"
                    decoding="async"
                  />
                  <span>{example.label}</span>
                </button>
              ))}
            </div>
            <div
              id="ai-selected-ingredients"
              class="ai-selected-ingredients"
              aria-label="Selected details"
            ></div>
            <button
              class="ai-custom-toggle"
              type="button"
              data-ai-ingredient="custom"
              aria-expanded="false"
              aria-controls="ai-custom-ingredient-panel"
            >
              + Write Your Own Detail
            </button>
            <div id="ai-custom-ingredient-panel" hidden>
              <label class="sr-only" for="ai-ingredient-custom">
                Your own detail
              </label>
              <div>
                <input
                  id="ai-ingredient-custom"
                  maxlength="80"
                  placeholder="A blue ribbon, a paintbrush, a little cloud…"
                />
                <button type="button" data-ai-add-ingredient>
                  Add Detail
                </button>
              </div>
            </div>
            <p
              id="ai-ingredient-feedback"
              class="ai-control-help"
              role="status"
              aria-live="polite"
            ></p>
          </section>
          <section class="ai-section-card ai-style-section" aria-label="Illustration style choices">
            <label class="ai-field-label ai-illustrated-label" for="ai-style">
              <img
                class="ai-field-symbol"
                src="/illustrations/builder/palette.svg"
                alt=""
                width="28"
                height="28"
              />
              Choose an Illustration Style
            </label>
            <div class="ai-visual-styles" role="group" aria-label="Illustration style">
              {styleCards.slice(0, 4).map((reference) => (
                <button
                  type="button"
                  data-ai-style={reference.id}
                  aria-pressed={reference.id === 'cut-paper'}
                  title={reference.detail}
                >
                  <span class="ai-selected-mark" aria-hidden="true">
                    <svg
                      width="15"
                      height="15"
                      viewBox="0 0 20 20"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.1"
                    >
                      <path d="m4 10 4 4 8-8" />
                    </svg>
                  </span>
                  <img
                    src={reference.image}
                    srcset={reference.imageSrcSet}
                    sizes="96px"
                    width="160"
                    height="140"
                    alt={reference.alt}
                    title={reference.imageTitle}
                    loading="lazy"
                    decoding="async"
                  />
                  <span>
                    {reference.label}
                    <small>{reference.detail}</small>
                  </span>
                </button>
              ))}
            </div>
            <div class="ai-style-choice">
              <span>
                Selected: <strong id="ai-selected-style">Cut paper</strong>
              </span>
              <button type="button" data-ai-show-styles aria-controls="ai-choice-dialog">
                All {styles.length} Styles
              </button>
            </div>
            <p class="ai-control-help">
              Style references show different subjects. Any style works with your own idea.
            </p>
          </section>
          <section class="ai-build-controls" aria-label="Color choices and generation controls">
            <div class="ai-color-station">
              <div class="ai-station-heading">
                <img src="/illustrations/builder/palette.svg" width="44" height="44" alt="" />
                <div>
                  <h2>Mood &amp; Color</h2>
                  <p>Choose accents, or leave the colors to your description.</p>
                </div>
              </div>
              <div class="ai-moods" role="group" aria-label="Mood">
                <button type="button" data-ai-mood="cozy" aria-pressed="false">
                  <img
                    class="ai-mood-object"
                    src="/illustrations/builder/leaf.svg"
                    width="28"
                    height="28"
                    alt=""
                  />
                  Warm & cozy
                </button>
                <button type="button" data-ai-mood="minimal" aria-pressed="false">
                  <img
                    class="ai-mood-object"
                    src="/illustrations/builder/minimal.svg"
                    width="28"
                    height="28"
                    alt=""
                  />
                  Minimal
                </button>
              </div>

              <div class="ai-paint-heading">
                <strong>Color Palette</strong>
                <span id="ai-color-count">0 / 5 selected</span>
                <button type="button" data-ai-clear-colors disabled>
                  Clear
                </button>
              </div>
              <AiColorSwatches colors={builderColors.filter(([color]) => quickColors.has(color))} />
              <details class="ai-more-colors">
                <summary>More Colors &amp; Custom HEX</summary>
                <AiColorSwatches
                  colors={builderColors.filter(([color]) => !quickColors.has(color))}
                />
                <div class="ai-custom-paint">
                  <label for="ai-custom-color-hex">Custom HEX</label>
                  <div class="ai-custom-paint-fields">
                    <input
                      id="ai-custom-color"
                      form="ai-form"
                      type="color"
                      value="#1769d5"
                      aria-label="Pick a custom accent color"
                    />
                    <input
                      id="ai-custom-color-hex"
                      form="ai-form"
                      type="text"
                      value="#1769D5"
                      maxlength="7"
                      spellcheck="false"
                      autocapitalize="characters"
                      autocomplete="off"
                      aria-describedby="ai-color-feedback"
                    />
                    <button type="button" data-ai-add-color>
                      Add Color
                    </button>
                  </div>
                </div>
              </details>
              <div
                id="ai-selected-colors"
                class="ai-selected-colors"
                aria-label="Selected accent colors"
              ></div>
              <p
                id="ai-color-feedback"
                class="ai-color-feedback"
                role="status"
                aria-live="polite"
              ></p>
              <p class="ai-color-note">
                Up to five accents. Colors guide the image; exact shades may vary.
              </p>
            </div>
            <div class="ai-launch-station">
              <div class="ai-create-row">
                <label class="ai-transparent">
                  <input form="ai-form" id="ai-transparent" type="checkbox" />
                  <span class="ai-alpha-symbol" aria-hidden="true"></span>Transparent background
                </label>
                <button
                  class="primary ai-generate"
                  type="submit"
                  form="ai-form"
                  id="ai-generate"
                  disabled
                >
                  <img
                    class="ai-generate-symbol"
                    src="/illustrations/builder/artwork.svg"
                    alt=""
                    width="28"
                    height="28"
                  />
                  <span data-ai-generate-label>Create My Clipart</span>
                  <svg
                    width="22"
                    height="22"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    aria-hidden="true"
                  >
                    <path d="M3 12h17m-6-6 6 6-6 6" />
                  </svg>
                </button>
              </div>
              <p class="ai-generation-note">One Image per Generation · 1024 × 1024</p>
              <div class="ai-form-guidance">
                <p id="ai-form-hint">Start with a description or an example.</p>
                <button type="button" data-ai-show-verification hidden>
                  Security Check
                </button>
              </div>
              <div
                id="ai-turnstile"
                tabindex="-1"
                role="group"
                aria-label="Security verification"
              ></div>

              <button type="button" id="ai-cancel" hidden>
                Stop waiting
              </button>
              <p id="ai-quota" class="ai-quota">
                Checking today’s free capacity…
              </p>
              <ContentLink
                id="ai-live-builder"
                class="button primary"
                href="https://ultraclipart.com/ai-clipart-generator/"
                hidden
              >
                Continue on AI Clipart Builder
              </ContentLink>
              <details id="ai-generation-settings" class="ai-options">
                <summary>Fine-tune your idea & generation settings</summary>
                <div class="ai-options-fields">
                  <label for="ai-style">All illustration styles</label>
                  <select form="ai-form" id="ai-style" name="style">
                    {styles.map(([value, label, detail]) => (
                      <option
                        value={value}
                        selected={value === 'cut-paper'}
                        data-ai-choice-image={
                          styleCards.find((style) => style.id === value)?.image ??
                          ideaCards.find((idea) => idea.style === value)?.image
                        }
                        data-ai-choice-alt={
                          styleCards.find((style) => style.id === value)?.alt ??
                          ideaCards.find((idea) => idea.style === value)?.alt
                        }
                        data-ai-choice-title={
                          styleCards.find((style) => style.id === value)?.imageTitle ??
                          ideaCards.find((idea) => idea.style === value)?.imageTitle
                        }
                        data-ai-choice-detail={detail}
                      >
                        {label}
                      </option>
                    ))}
                  </select>
                  <p id="ai-style-note" class="ai-style-note">
                    Layered paper · subtle depth
                  </p>
                  <label for="ai-composition">Composition</label>
                  <select form="ai-form" id="ai-composition">
                    <option value="centered">Centered subject</option>
                    <option value="full-body">Full subject, nothing cropped</option>
                    <option value="balanced">Balanced group</option>
                    <option value="negative-space">Room for a caption</option>
                  </select>
                  <label for="ai-palette">Palette</label>
                  <select form="ai-form" id="ai-palette">
                    <option value="prompt">Follow my description</option>
                    <option value="natural">Natural colors</option>
                    <option value="pastel">Soft pastels</option>
                    <option value="vibrant">Vibrant colors</option>
                    <option value="monochrome">Black & white</option>
                  </select>
                  <label for="ai-detail">Detail</label>
                  <select form="ai-form" id="ai-detail">
                    <option value="detailed">Richly detailed</option>
                    <option value="balanced">Balanced</option>
                    <option value="simple">Simple</option>
                  </select>
                  <label for="ai-outline">Outline</label>
                  <select form="ai-form" id="ai-outline">
                    <option value="none">Natural edges</option>
                    <option value="fine">Fine outline</option>
                    <option value="bold">Bold outline</option>
                  </select>
                  <label for="ai-margin">Space around the subject</label>
                  <select form="ai-form" id="ai-margin">
                    <option value="standard">Comfortable margin</option>
                    <option value="generous">Generous white space</option>
                  </select>
                  <div class="ai-prompt-tools">
                    <button type="button" data-ai-action="random">
                      Surprise me
                    </button>
                    <button type="button" data-ai-action="copy">
                      Copy prompt
                    </button>
                    <button type="button" data-ai-action="reset">
                      Reset
                    </button>
                  </div>
                  <p>
                    Write in your language. A language model prepares an English description; your
                    original is kept. Transparency uses local edge cleanup after generation and may
                    need manual refinement.
                  </p>
                  <button type="button" id="ai-refresh-quota" class="ai-refresh-quota">
                    Refresh availability
                  </button>
                </div>
              </details>
              <p class="ai-privacy">
                Your prompt is processed by Cloudflare AI. Images aren’t published.{' '}
                <a href="/privacy/#builder">Privacy</a> · <a href="/terms/#builder">AI terms</a>
              </p>
            </div>
          </section>
        </form>
      </section>
      <section class="ai-preview-panel" aria-labelledby="ai-preview-title">
        <div class="ai-stepper" role="group" aria-label="Creative workflow">
          <button type="button" data-ai-step="idea" aria-current="step">
            <span>1</span>Idea
          </button>
          <i aria-hidden="true"></i>
          <button type="button" data-ai-step="make">
            <span>2</span>Make
          </button>
          <i aria-hidden="true"></i>
          <button type="button" data-ai-step="refine" disabled>
            <span>3</span>Refine
          </button>
        </div>
        <div id="ai-concept-board" class="ai-concept-board" data-view="grid">
          <div class="ai-board-heading">
            <div>
              <h2 id="ai-preview-title">
                <span>02</span> / Your Artwork
              </h2>
              <p>Choose an example or describe something of your own.</p>
            </div>
            <div class="ai-board-views">
              <label class="sr-only" for="ai-concept-count">
                Recent concepts to display
              </label>
              <select id="ai-concept-count">
                <option value="2">2 recent concepts</option>
                <option value="4" selected>
                  4 recent concepts
                </option>
                <option value="8">8 recent concepts</option>
              </select>
              <button type="button" data-ai-view="grid" aria-label="Grid view" aria-pressed="true">
                <svg
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <rect x="2" y="2" width="8" height="8" rx="1.5" />
                  <rect x="14" y="2" width="8" height="8" rx="1.5" />
                  <rect x="2" y="14" width="8" height="8" rx="1.5" />
                  <rect x="14" y="14" width="8" height="8" rx="1.5" />
                </svg>
              </button>
              <button type="button" data-ai-view="list" aria-label="List view" aria-pressed="false">
                <svg
                  width="25"
                  height="25"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  aria-hidden="true"
                >
                  <path d="M8 5h13M8 12h13M8 19h13M3 5h.1M3 12h.1M3 19h.1" />
                </svg>
              </button>
            </div>
          </div>
          <p id="ai-status" class="ai-status" role="status" aria-live="polite">
            Try a starting point below, or describe your own idea.
          </p>
          <span id="ai-state" class="ai-state">
            Ready for an idea
          </span>
          <div id="ai-empty" class="ai-empty">
            <div class="ai-concept-grid ai-starter-board">
              {starterCards.map((example) => (
                <button
                  type="button"
                  class="ai-concept"
                  data-ai-example={example.id}
                  aria-pressed="false"
                >
                  <img
                    src={example.image}
                    srcset={example.imageSrcSet}
                    sizes="(max-width: 540px) 40vw, 180px"
                    title={example.imageTitle}
                    width="320"
                    height="320"
                    alt={example.alt}
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="ai-starter-caption">
                    <strong>{example.label}</strong>
                    <span>{categoryLabel(example.category)}</span>
                  </span>
                  <span class="ai-starter-use">Use This Idea</span>
                </button>
              ))}
            </div>
            <p class="ai-example-note">
              Catalog pictures show the subjects. Your new image will be different.{' '}
              <a href="#ai-idea-library">Browse All {ideaCards.length} Ideas</a>
            </p>
          </div>
          <div class="ai-generated-layout">
            <div class="ai-preview" id="ai-preview">
              <canvas
                id="ai-canvas"
                width="1024"
                height="1024"
                aria-label="Your generated artwork preview"
                hidden
              ></canvas>
              <img
                title="Original generated image before local edits"
                id="ai-before"
                src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs="
                width="1024"
                height="1024"
                alt="Original generated image before local edits"
                hidden
              />
            </div>
            <div id="ai-concepts" class="ai-real-concepts" hidden></div>
          </div>
          <div class="ai-canvas-meta">
            <span id="ai-dimensions">Native output · 1024 × 1024</span>
            <button type="button" data-ai-action="compare" disabled aria-pressed="false">
              Compare original
            </button>
          </div>
          <div class="ai-board-actions">
            <button type="button" data-ai-action="studio" disabled>
              <img
                class="ai-action-object"
                src="/illustrations/builder/pencil.svg"
                width="38"
                height="38"
                alt=""
              />
              Refine Design
            </button>
            <button type="button" data-ai-action="again" disabled>
              <img
                class="ai-action-object"
                src="/illustrations/builder/layers.svg"
                width="38"
                height="38"
                alt=""
              />
              Make a Variation
            </button>
            <button type="button" data-ai-action="download" disabled>
              <img
                class="ai-action-object"
                src="/illustrations/builder/artwork.svg"
                width="38"
                height="38"
                alt=""
              />
              Download Image
            </button>
            <button type="button" class="primary" data-ai-action="pdf" disabled>
              <img
                class="ai-action-object"
                src="/illustrations/builder/document.svg"
                width="38"
                height="38"
                alt=""
              />
              Download PDF
            </button>
            <button
              type="button"
              class="ai-share-action"
              data-ai-action="share"
              aria-label="Share your creation"
              disabled
            >
              <img
                class="ai-action-object"
                src="/illustrations/builder/share.svg"
                width="31"
                height="31"
                alt=""
              />{' '}
              Share
            </button>
          </div>
          <p class="ai-action-note">
            Refine and download your own result. Variations use one additional generation.
          </p>
        </div>
        <details id="ai-refine-tools" class="ai-refine-tools ai-result-only">
          <summary>Local image tools & project download</summary>
          <fieldset class="ai-pdf-settings">
            <legend>Printable PDF</legend>
            <label for="ai-pdf-paper">Paper size</label>
            <select id="ai-pdf-paper">
              <option value="letter">US Letter</option>
              <option value="a4">A4</option>
            </select>
            <label class="ai-pdf-large">
              <input type="checkbox" id="ai-pdf-large" />
              Allow a PDF larger than 1 MB
            </label>
            <p>Detailed artwork may need a larger file. The default size guard stays on.</p>
          </fieldset>
          <div class="ai-local-tools ai-result-only" role="group" aria-label="Local image tools">
            <button type="button" data-ai-action="undo" disabled aria-label="Undo image edit">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                aria-hidden="true"
              >
                <path d="M9 4 4 9l5 5M4 9h10a6 6 0 0 1 0 12" />
              </svg>
              <span>Undo</span>
            </button>
            <button type="button" data-ai-action="redo" disabled aria-label="Redo image edit">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                aria-hidden="true"
              >
                <path d="m15 4 5 5-5 5m5-5H10a6 6 0 0 0 0 12" />
              </svg>
              <span>Redo</span>
            </button>
            <button type="button" data-ai-action="rotate" disabled>
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M20 7v6h-6M19 12a7 7 0 1 0-1 6" />
              </svg>
              Rotate 90°
            </button>
            <button type="button" data-ai-action="flip" disabled>
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M12 3v18M3 7h5v10H3zM16 7h5v10h-5z" />
              </svg>
              Flip
            </button>
            <button type="button" data-ai-action="trim" disabled>
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M3 8V3h5m8 0h5v5M3 16v5h5m8 0h5v-5M8 8h8v8H8z" />
              </svg>
              Trim empty edges
            </button>
            <button type="button" data-ai-action="bw" disabled>
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Zm0 0v18" />
              </svg>
              Black & white
            </button>
          </div>
          <details class="ai-local-options ai-result-only">
            <summary>Background, size & print quality</summary>
            <div class="ai-refine-grid">
              <label>
                White-background tolerance{' '}
                <input id="ai-tolerance" type="range" min="10" max="90" value="35" />
                <span>Only light areas touching an image edge are removed.</span>
              </label>
              <button type="button" data-ai-action="cutout" disabled>
                Remove white background
              </button>
              <label>
                Background color <input id="ai-background" type="color" value="#ffffff" />
              </label>
              <button type="button" data-ai-action="background" disabled>
                Apply solid background
              </button>
              <label>
                Width in pixels{' '}
                <input id="ai-resize" type="number" min="64" max="2048" value="1024" step="1" />
              </label>
              <button type="button" data-ai-action="resize" disabled>
                Resize proportionally
              </button>
            </div>
            <fieldset class="ai-crop-fields">
              <legend>Crop to a rectangle</legend>
              <label>
                Left (px)
                <input id="ai-crop-x" type="number" min="0" value="0" />
              </label>
              <label>
                Top (px)
                <input id="ai-crop-y" type="number" min="0" value="0" />
              </label>
              <label>
                Width (px)
                <input id="ai-crop-width" type="number" min="64" value="1024" />
              </label>
              <label>
                Height (px)
                <input id="ai-crop-height" type="number" min="64" value="1024" />
              </label>
              <button type="button" data-ai-action="crop" disabled>
                Apply crop
              </button>
            </fieldset>
            <p id="ai-quality">
              The original image is 1024 px wide: about 3.4 inches at 300 PPI. Downloading at a
              higher size does not create new detail.
            </p>
            <p>
              Fine fur, white subjects and enclosed gaps may need manual mask refinement.{' '}
              <button type="button" data-ai-action="studio" disabled>
                Refine in Studio
              </button>
            </p>
          </details>
          <details id="ai-used-prompt" class="ai-local-options" hidden>
            <summary>See the description used by the model</summary>
            <p id="ai-used-prompt-text"></p>
          </details>
          <button type="button" data-ai-action="project" disabled>
            Save editable project
          </button>
        </details>
        <details class="ai-history-section">
          <summary>
            Your recent images <span>Saved on this device</span>
          </summary>
          <div class="ai-history-heading">
            <h3>On this device</h3>
            <span id="ai-history-count">0 images</span>
          </div>
          <div id="ai-history" class="ai-history">
            <p class="ai-small">Your recent results will appear here.</p>
          </div>
          <p class="ai-small" id="ai-storage-note">
            Up to 12 results · saved for 7 days in this browser. Download a project to keep it
            longer.
          </p>
          <button class="ai-clear" type="button" data-ai-action="clear">
            Clear saved AI images
          </button>
        </details>
        <p class="ai-model-note">
          Images by FLUX.1 schnell. Prompt assistance:{' '}
          <ContentLink href="https://huggingface.co/meta-llama/Llama-3.1-8B-Instruct/blob/main/LICENSE">
            Built with Llama
          </ContentLink>
          . Local edits use no generation quota.
        </p>
      </section>
    </div>
    <section id="ai-idea-library" class="ai-idea-library" aria-labelledby="ai-ideas-title">
      <div class="ai-ideas-heading">
        <div>
          <h2 id="ai-ideas-title">Example Ideas</h2>
          <p>
            Try one of these {ideaCards.length} ideas, then change the colors, details or style. The
            full description goes into the box above.
          </p>
        </div>
        <a href="#ai-form">Back to Your Description</a>
      </div>
      <div class="ai-prompt-recipe" aria-label="How to write a clipart description">
        <strong>A Useful Description Has:</strong>
        <span>
          <b>1</b> A Subject <small>a child</small>
        </span>
        <span>
          <b>2</b> An Action <small>reading a book</small>
        </span>
        <span>
          <b>3</b> A Few Details <small>blue cover, yellow cushion</small>
        </span>
        <span>
          <b>4</b> A Composition <small>full body, space around it</small>
        </span>
      </div>
      <div class="ai-idea-filters" role="group" aria-label="Example subjects">
        <button type="button" data-ai-idea-filter="all" aria-pressed="true">
          All Ideas <span>{ideaCards.length}</span>
        </button>
        {ideaCategories.map(([id, label]) => (
          <button type="button" data-ai-idea-filter={id} aria-pressed="false">
            {label}
            <span>{ideaCards.filter((item) => item.category === id).length}</span>
          </button>
        ))}
      </div>
      <div class="ai-idea-search-row">
        <label for="ai-idea-search">Find an Example</label>
        <input
          id="ai-idea-search"
          type="search"
          maxlength="100"
          placeholder="Try books, flowers or music"
          aria-controls="ai-idea-cards"
        />
        <span id="ai-idea-count" role="status" aria-live="polite">
          1–8 of {ideaCards.length} Ideas
        </span>
      </div>
      <p class="ai-ideas-reference-note">
        Each picture is a catalog reference for the subject. The written idea guides your new image;
        it does not reproduce the reference.
      </p>
      <div id="ai-idea-cards" class="ai-idea-cards">
        {ideaCards.map((example, index) => (
          <article
            class="ai-idea-card"
            data-ai-idea-card={example.id}
            data-category={example.category}
            hidden={index >= 8}
          >
            <div class="ai-idea-picture">
              <img
                title={example.imageTitle}
                src={example.image}
                srcset={example.imageSrcSet}
                sizes="(max-width: 540px) 40vw, 180px"
                width="260"
                height="210"
                alt={example.alt}
                loading="lazy"
                decoding="async"
              />
              <span>Subject Reference</span>
            </div>
            <div class="ai-idea-copy">
              <span class="ai-idea-category">{categoryLabel(example.category)}</span>
              <h3>{example.label}</h3>
              <p>{example.prompt}</p>
              <div class="ai-idea-card-footer">
                <span>{styles.find(([id]) => id === example.style)?.[1]}</span>
                <button
                  type="button"
                  data-ai-example={example.id}
                  aria-pressed="false"
                  aria-label={`Use This Idea: ${example.label}`}
                >
                  Use This Idea
                </button>
              </div>
            </div>
          </article>
        ))}
      </div>
      <p id="ai-idea-empty" class="ai-idea-empty" hidden>
        No examples match. Try a shorter word or choose All Ideas.
      </p>
      <div class="ai-idea-pagination" aria-label="Example pages">
        <button type="button" data-ai-idea-page="previous" disabled>
          Previous
        </button>
        <span id="ai-idea-page-label">Page 1 of {Math.ceil(ideaCards.length / 8)}</span>
        <button type="button" data-ai-idea-page="next">
          Next
        </button>
      </div>
      <p class="ai-control-help">
        Choosing an example only fills your description. It uses no generation allowance until you
        press Create My Clipart.
      </p>
    </section>
    <section class="ai-how" aria-labelledby="ai-how-title">
      <h2 id="ai-how-title">How to Create an Image</h2>
      <div>
        <article>
          <span>1</span>
          <h3>Describe what matters</h3>
          <p>
            Describe the subject, its action and any important details. Choose a style and leave
            space around the subject.
          </p>
        </article>
        <article>
          <span>2</span>
          <h3>Inspect and refine</h3>
          <p>
            Check the pose, small details and any lettering. Compare local edits with the original,
            remove a simple white background and keep the version you like.
          </p>
        </article>
        <article>
          <span>3</span>
          <h3>Continue in Clipart Studio</h3>
          <p>
            Open <a href="/create/">Clipart Studio</a> to add editable text, build a sticker or
            arrange a printable page. Our <a href="/guides/">project guides</a> explain the next
            steps.
          </p>
        </article>
      </div>
    </section>
    <section class="ai-faq" aria-labelledby="ai-faq-title">
      <div>
        <h2 id="ai-faq-title">AI Builder Questions</h2>
        <p>Details about generation limits, editing, downloads and how your work is stored.</p>
        <a href="/categories/">Explore ready-made clipart →</a>
      </div>
      <div>
        {faq.map(([q, a]) => (
          <details>
            <summary>{q}</summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </section>
    <AiChoicePicker />
  </div>
  <script>
    import '../ai/client';
  </script>
</Layout>
