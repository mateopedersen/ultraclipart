---
import { imageObject } from '../../lib/image-schema';
import { structuredData, breadcrumbs } from '../../lib/structured-data';
import collectionCopy from '../../../data/collection-copy.json';
import Layout from '../../layouts/Layout.astro';
import Card from '../../components/Card.astro';
import CollectionGalleryHeading from '../../components/CollectionGalleryHeading.astro';
import RelatedCollections from '../../components/RelatedCollections.astro';
import {
  availableTopics,
  topicArt,
  slugify,
  clustersForTopic,
  reviewedCollectionIntroductions,
} from '../../lib/catalog';
export function getStaticPaths() {
  return availableTopics.map((t) => ({ params: { slug: t.slug }, props: { topic: t } }));
}
const { topic } = Astro.props;
const copy = collectionCopy[topic.slug as keyof typeof collectionCopy];
const reviewedIntro = reviewedCollectionIntroductions.get(topic.slug);
const featured = new Map(copy?.featured.map((id, index) => [id, index]));
const items = topicArt(topic.slug).sort(
  (a, b) => (featured.get(a.id) ?? 999) - (featured.get(b.id) ?? 999),
);
const topicReady = items.length >= 50 && items.every((item) => item.indexable && item.published);
const title = topic.keyword.replace('clipart', 'Clipart');
const description = reviewedIntro;
if (!description) throw new Error(`Missing topic introduction: ${topic.slug}`);
---

<Layout
  title={title}
  description={description}
  image={items[0]?.webp}
  imageAlt={items[0]?.alt}
  imageWidth={items[0]?.width}
  imageHeight={items[0]?.height}
  noindex={!topicReady}
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={structuredData(
      breadcrumbs([
        { name: 'Home', path: '/' },
        { name: 'Categories', path: '/categories/' },
        { name: title, path: `/clipart/${topic.slug}/` },
      ]),
    )}
  />
  {topicReady && items.length > 0 && (
    <script
      slot="head"
      type="application/ld+json"
      set:html={structuredData({
        '@context': 'https://schema.org',
        '@type': 'CollectionPage',
        name: title,
        url: `https://ultraclipart.com/clipart/${topic.slug}/`,
        description,
        mainEntity: {
          '@type': 'ItemList',
          numberOfItems: items.length,
          itemListElement: items.map((item, index) => ({
            '@type': 'ListItem',
            position: index + 1,
            url: `https://ultraclipart.com/art/${item.id}/`,
            name: item.title,
            item: imageObject(item),
          })),
        },
      })}
    />
  )}
  <section class="hero">
    <div class="breadcrumb">
      <a href="/">Home</a> / <a href="/categories/">Categories</a> /{' '}
      <a href={`/collection/${slugify(topic.cluster)}/`}>{topic.cluster}</a>
    </div>
    <h1>{title}</h1>
    <p data-collection-summary>{description}</p>
    <div class="chips">
      {clustersForTopic(topic)
        .filter((cluster) => cluster !== topic.cluster)
        .map((cluster) => (
          <a href={`/collection/${slugify(cluster)}/`}>{cluster}</a>
        ))}
    </div>
  </section>
  <CollectionGalleryHeading topic={topic.slug} />
  {items.length ? (
    <div class="gallery">
      {items.map((item) => (
        <Card item={item} />
      ))}
    </div>
  ) : (
    <div class="empty">
      <h2>No Artwork Available Yet</h2>
      <p>No artwork has been released for this topic yet.</p>
      <a class="button primary" href="/new/">
        Explore available artwork
      </a>
    </div>
  )}
  <RelatedCollections topic={topic.slug} />
  <nav class="collection-help" aria-label="Artwork help">
    <a href="/guides/webp-pdf-and-editable-projects/">Image &amp; PDF guide</a>
    <a href="/print-size/">Check print size</a>
    <a href="/license/">Usage license</a>
  </nav>
</Layout>

<style>
  .collection-help {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    padding-block: 1.5rem;
    border-top: 1px solid #d5e3f7;
    font-weight: 600;
  }
  .collection-help a {
    padding-block: 0.5rem;
  }
</style>
