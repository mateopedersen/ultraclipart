---
import { structuredData, breadcrumbs } from '../../lib/structured-data';
import collectionCopy from '../../../data/collection-copy.json';
import Layout from '../../layouts/Layout.astro';
import Card from '../../components/Card.astro';
import { availableTopics, topicArt, slugify } from '../../lib/catalog';
export function getStaticPaths() {
  return availableTopics.map((t) => ({ params: { slug: t.slug }, props: { topic: t } }));
}
const { topic } = Astro.props;
const items = topicArt(topic.slug);
const copy = collectionCopy[topic.slug as keyof typeof collectionCopy];
const topicReady = items.length === 50 && items.every((item) => item.indexable && item.published);
const related = availableTopics
  .filter(
    (t) => t.slug !== topic.slug && (t.cluster === topic.cluster || copy?.related.includes(t.slug)),
  )
  .slice(0, 8);
const title = topic.keyword.replace('clipart', 'Clipart');
const isVolleyball = topic.slug === 'volleyball';
const hasEditable = items.some((item) => item.layered);
const description =
  copy?.description ??
  (isVolleyball
    ? 'Download 50 volleyball illustrations: players, beach scenes, balls, team celebrations and black-and-white designs. Transparent WebP and CMYK PDF files.'
    : `Explore ${items.length} ${topic.keyword.toLowerCase()} illustrations for personal and educational projects. Download WebP and PDF files${hasEditable ? ' or customize layered artwork' : ''}.`);
---

<Layout
  title={topicReady ? `${title}: ${items.length} Free WebP & PDF Downloads` : title}
  description={description}
  image={items[0]?.webp}
  imageAlt={items[0]?.alt}
  noindex={!topicReady}
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={structuredData(
      breadcrumbs([
        { name: 'Home', path: '/' },
        { name: 'Categories', path: '/categories/' },
        { name: title, path: `/clipart/${topic.slug}/` },
      ]),
    )}
  />
  {items.length > 0 && (
    <script
      slot="head"
      type="application/ld+json"
      set:html={structuredData({
        '@context': 'https://schema.org',
        '@type': 'CollectionPage',
        name: title,
        url: `https://ultraclipart.com/clipart/${topic.slug}/`,
        description,
        mainEntity: {
          '@type': 'ItemList',
          numberOfItems: items.length,
          itemListElement: items.map((item, index) => ({
            '@type': 'ListItem',
            position: index + 1,
            url: `https://ultraclipart.com/art/${item.id}/`,
            name: item.title,
            item: {
              '@type': 'ImageObject',
              name: item.title,
              description: item.alt,
              contentUrl: new URL(item.webp, 'https://ultraclipart.com').href,
              thumbnailUrl: new URL(item.thumb, 'https://ultraclipart.com').href,
              encodingFormat: 'image/webp',
              width: item.width,
              height: item.height,
              license: 'https://ultraclipart.com/license/',
              acquireLicensePage: 'https://ultraclipart.com/license/',
              creditText: 'UltraClipart',
            },
          })),
        },
      })}
    />
  )}
  <section class="hero">
    <div class="breadcrumb">
      <a href="/">Home</a> / <a href="/categories/">Categories</a> /{' '}
      <a href={`/collection/${slugify(topic.cluster)}/`}>{topic.cluster}</a>
    </div>
    <h1>{title}</h1>
    <p class="lead">
      {copy?.lead ??
        (isVolleyball
          ? 'A little team spirit for your next project.'
          : 'Little details for your next creative project.')}
    </p>
    <p>
      {copy?.intro ??
        (isVolleyball
          ? 'Explore 50 volleyball illustrations, from beach-side rallies and player poses to cheerful mascots, trophies and black-and-white drawings. Choose a design for personal team journals, PE worksheets, classroom activities or sports-themed crafts.'
          : items.length
            ? items
                .slice(0, 3)
                .map((a) => a.description)
                .join(' ')
            : `Our ${topic.keyword.toLowerCase()} collection is in preparation. Explore the related subjects below while original illustrations are developed and checked.`)}
    </p>
    <div class="chips">
      {copy?.chips.map((chip) => (
        <a href={`/search/?q=${encodeURIComponent(chip.query)}`}>{chip.label}</a>
      ))}
      {isVolleyball && (
        <>
          <a href="/search/?q=volleyball+player">Players & teamwork</a>
          <a href="/search/?q=beach+volleyball">Beach volleyball</a>
          <a href="/search/?q=volleyball&color=black">Black & white</a>
        </>
      )}
      {related.map((t) => (
        <a href={`/clipart/${t.slug}/`}>{t.keyword}</a>
      ))}
    </div>
  </section>
  <div class="section-head">
    <h2>
      {items.length} {items.length === 1 ? 'illustration' : 'illustrations'}
    </h2>
    <a href="/license/">Personal & educational use</a>
  </div>
  {items.length ? (
    <div class="gallery">
      {items.map((item) => (
        <Card item={item} />
      ))}
    </div>
  ) : (
    <div class="empty">
      <h2>Good things take a little drawing.</h2>
      <p>No artwork has been released for this topic yet.</p>
      <a class="button primary" href="/new/">
        Explore available artwork
      </a>
    </div>
  )}
  <section class="prose">
    {copy && (
      <>
        <h2>{copy.heading}</h2>
        {copy.paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </>
    )}
    {isVolleyball && (
      <>
        <h2>Choose a volleyball illustration for your project</h2>
        <p>
          For a PE worksheet, start with a clear player pose: serving, setting, passing, blocking or
          making a save. Leave room beside the player for a question or a practice goal. A simple
          isolated volleyball works well on small labels, while a court or beach scene makes a more
          detailed page header.
        </p>
        <p>
          For personal cards and journals, try the floral wreath, folded heart, knitted ball or
          watercolor design. Team huddles and high fives work well with messages about cooperation.
          The open outline drawings offer more space for coloring than the shaded charcoal, stippled
          and engraved designs.
        </p>
      </>
    )}
    <h2>From screen to paper</h2>
    <p>
      {copy?.print ??
        (isVolleyball
          ? 'Each design has a transparent 1,382 × 1,382 WebP for digital layouts and a matching CMYK PDF. Select View to see a larger preview, then choose the download format you need. The PDF page is approximately 4.61 inches square, giving the image 300 pixels per inch at its native size. Print at actual size for that scale, or use your printer’s placement settings to position it on a larger sheet.'
          : 'Use WebP for transparent digital layouts. Layered illustrations can be opened in the editor to change colors, add a caption or make an outline version. Standard PDF downloads are prepared for printing. Review your printer’s settings and print at the intended paper size.')}
    </p>
    {(isVolleyball || copy) && (
      <p>
        Keep the transparent WebP over a light or colored background when arranging a digital page.
        For printing, check the actual size and contrast before making multiple copies. Our{' '}
        <a href="/print-size/">print size calculator</a> helps you choose a suitable raster size;
        the <a href="/guides/webp-pdf-and-editable-projects/">file format guide</a> explains when to
        use WebP or PDF.
      </p>
    )}
    <h2>Keep creating</h2>
    <p>
      Personal and educational projects are welcome. Commercial use and resale as clipart are not
      permitted. <a href="/license/">Read the usage license</a>.
    </p>
  </section>
</Layout>
