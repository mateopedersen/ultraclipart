---
import Layout from '../layouts/Layout.astro';
import DiscoveryIcon from '../components/DiscoveryIcon.astro';
import { categoryCollections, categorySubjects } from '../lib/category-directory';
import { breadcrumbs, structuredData } from '../lib/structured-data';
import '../styles/categories.css';
const total = categorySubjects.reduce((sum, subject) => sum + subject.count, 0);
const letters = [...new Set(categorySubjects.map((topic) => topic.name[0].toUpperCase()))].sort();
const heroSubjects = ['fox', 'baby', 'butterfly', 'heart']
  .map((slug) => categorySubjects.find((s) => s.slug === slug))
  .filter((s) => s !== undefined);
const title = 'Clipart Categories: Animals, Holidays, Baby & More';
const description = `Explore ${categorySubjects.length} clipart topics and ${total.toLocaleString('en-US')} illustrations. Browse visual collections, find a subject, and download images or printable PDFs.`;
const pageUrl = 'https://ultraclipart.com/categories/';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': pageUrl + '#page',
  url: pageUrl,
  name: title,
  description,
  inLanguage: 'en-US',
  breadcrumb: breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Clipart categories', path: '/categories/' },
  ]),
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: categorySubjects.length,
    itemListElement: categorySubjects.map((subject, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: subject.keyword,
      url: `https://ultraclipart.com/clipart/${subject.slug}/`,
    })),
  },
};
---

<Layout
  title={title}
  description={description}
  image={heroSubjects[0]?.sample.thumb}
  imageAlt="Explore illustrated clipart categories on UltraClipart"
>
  <script slot="head" type="application/ld+json" set:html={structuredData(schema)} />
  <div class="category-discovery">
    <nav class="discovery-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Clipart categories</span>
    </nav>
    <section class="discovery-hero" aria-labelledby="discovery-title">
      <div class="discovery-intro">
        <h1 id="discovery-title">
          Great clipart.
          <br />
          <span>Endless ideas.</span>
        </h1>
        <p class="discovery-lead">
          Find the perfect animals, celebrations and everyday favorites for your next personal or
          classroom project.
        </p>
        <form
          class="discovery-search"
          id="hero-topic-search"
          role="search"
          aria-label="Find clipart subjects"
          action="/search/"
        >
          <label class="discovery-sr" for="hero-topic-query">
            Search clipart subjects
          </label>
          <input
            id="hero-topic-query"
            name="q"
            type="search"
            placeholder="Find a subject…"
            maxlength="160"
          />
          <button type="submit" aria-label="Search subjects" class="discovery-primary-control">
            <span class="action-glyph">
              <DiscoveryIcon name="find" size={24} />
            </span>
            <span>Search</span>
            <kbd aria-hidden="true">↵</kbd>
          </button>
        </form>
        <div class="discovery-shortcuts">
          <a href="#topic-directory">
            Browse all subjects <DiscoveryIcon name="arrow" size={22} />
          </a>
          <a href="/new/">See what's new</a>
        </div>
        <p class="discovery-stats">
          <strong>{total.toLocaleString('en-US')}</strong> illustrations{' '}
          <span aria-hidden="true">·</span> <strong>{categorySubjects.length}</strong> subjects{' '}
        </p>
      </div>
      <div class="discovery-moodboard" aria-label="A few ideas to get you started">
        {heroSubjects.map((subject, index) => (
          <a
            href={`/clipart/${subject.slug}/`}
            class={`moodboard-piece moodboard-piece-${index + 1} tone-${subject.color}`}
            aria-label={`Explore ${subject.keyword}`}
          >
            <img
              src={subject.sample.thumb}
              alt=""
              width="240"
              height="240"
              loading={index === 0 ? 'eager' : 'lazy'}
              fetchpriority={index === 0 ? 'high' : 'auto'}
              decoding="async"
            />
            <span>
              {subject.name}
              <DiscoveryIcon name="arrow" size={22} />
            </span>
          </a>
        ))}
      </div>
    </section>

    <section class="discovery-collections" aria-labelledby="collections-title">
      <div class="discovery-section-heading">
        <div>
          <h2 id="collections-title">Explore by collection</h2>
        </div>
        <a href="#topic-directory">
          All {categorySubjects.length} subjects <DiscoveryIcon name="library" size={24} />
        </a>
      </div>
      <div class="discovery-collection-grid">
        {categoryCollections.map((collection, index) => (
          <a
            class:list={[
              'discovery-collection',
              `tone-${collection.color}`,
              { 'discovery-collection-wide': index === 0 },
            ]}
            href={`/collection/${collection.slug}/`}
          >
            <div class="collection-art" aria-hidden="true">
              {collection.previews.map((item) => (
                <img
                  src={item.thumb}
                  alt=""
                  width="180"
                  height="180"
                  loading="lazy"
                  decoding="async"
                />
              ))}
            </div>
            <div class="collection-label">
              <div class="collection-heading">
                <DiscoveryIcon name={collection.slug} size={36} />
                <h3>{collection.title}</h3>
              </div>
              <p>
                {collection.subjects.length}{' '}
                {collection.subjects.length === 1 ? 'subject' : 'subjects'}{' '}
                <span aria-hidden="true">·</span> {collection.count.toLocaleString('en-US')}{' '}
                illustrations
              </p>
              <span class="collection-cta">
                <span class="action-glyph">
                  <DiscoveryIcon name="folder" size={25} />
                </span>
                <span>Explore collection</span>
              </span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section
      id="topic-directory"
      class="discovery-directory"
      aria-labelledby="topic-directory-heading"
      tabindex="-1"
    >
      <div class="discovery-section-heading">
        <div>
          <h2 id="topic-directory-heading">Browse all subjects</h2>
        </div>
        <p>Your next idea is a search away.</p>
      </div>
      <div class="discovery-controls" id="discovery-controls" hidden>
        <div class="discovery-filter-row">
          <div class="directory-query">
            <label for="topic-filter">Search subjects</label>
            <div>
              <DiscoveryIcon name="search" size={26} />
              <input
                id="topic-filter"
                type="search"
                placeholder="Search animals, seasons and more…"
                aria-controls="subject-grid"
                maxlength="160"
              />
            </div>
          </div>
          <div>
            <label for="category-group">Collection</label>
            <select id="category-group" aria-controls="subject-grid">
              <option value="">All collections</option>
              {categoryCollections.map((collection) => (
                <option value={collection.slug}>{collection.title}</option>
              ))}
            </select>
          </div>
          <div>
            <label for="category-sort">Sort by</label>
            <select id="category-sort" aria-controls="subject-grid">
              <option value="name">Name: A–Z</option>
              <option value="count">Most artwork</option>
            </select>
          </div>
        </div>
        <details class="discovery-alphabet">
          <summary>
            Browse by letter <span aria-hidden="true">A–Z</span>
          </summary>
          <div class="discovery-letters" role="group" aria-label="Filter topics by first letter">
            <button data-letter="" aria-pressed="true">
              All
            </button>
            {letters.map((letter) => (
              <button
                data-letter={letter}
                aria-pressed="false"
                aria-label={`Topics beginning with ${letter}`}
              >
                {letter}
              </button>
            ))}
          </div>
        </details>
      </div>
      <div class="discovery-result-row">
        <p id="topic-result-count" role="status" aria-live="polite">
          {categorySubjects.length} subjects to explore
        </p>
        <button id="reset-subjects" type="button" hidden>
          Clear filters <span aria-hidden="true">×</span>
        </button>
      </div>
      <ul class="discovery-subject-grid" id="subject-grid">
        {categorySubjects.map((subject) => (
          <li
            class="discovery-subject"
            data-topic={subject.keyword.toLowerCase()}
            data-group={subject.group}
            data-groups={subject.groups.join(' ')}
            data-name={subject.name}
            data-count={subject.count}
            data-letter-value={subject.name[0].toUpperCase()}
            data-keywords={`${subject.keyword} ${subject.cluster} ${subject.groups.join(' ')} ${subject.slug}`.toLowerCase()}
          >
            <a href={`/clipart/${subject.slug}/`}>
              <div class={`subject-art tone-${subject.color}`}>
                <img
                  src={subject.sample.thumb}
                  alt={`${subject.name} clipart preview`}
                  width="240"
                  height="200"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="subject-label">
                <div>
                  <h3>{subject.name}</h3>
                  <span class="subject-count">{subject.count} illustrations</span>
                </div>
                <DiscoveryIcon name="arrow" size={26} />
              </div>
            </a>
          </li>
        ))}
      </ul>
      <div id="no-topics" class="discovery-empty" hidden>
        <DiscoveryIcon name="search" size={48} />
        <h3>No matching subjects</h3>
        <p>No subjects match these filters. Try a shorter search or explore another collection.</p>
        <button id="clear-topic-filter" type="button">
          Show all subjects <DiscoveryIcon name="arrow" size={24} />
        </button>
      </div>
      <div class="discovery-more" id="discovery-more" hidden>
        <p id="subject-progress"></p>
        <button id="show-more-subjects" type="button">
          Show more subjects <DiscoveryIcon name="library" size={24} />
        </button>
      </div>
      <noscript>
        <p>All available subjects are listed above. Choose a preview to explore its artwork.</p>
      </noscript>
    </section>

    <section class="discovery-create" aria-labelledby="discovery-create-title">
      <div class="create-symbol">
        <DiscoveryIcon name="studio" size={40} />
      </div>
      <div>
        <h2 id="discovery-create-title">Make something uniquely yours.</h2>
        <p>
          Choose a subject, personalize your artwork in the editor, then download an image or
          printable PDF for your personal or classroom project.
        </p>
      </div>
      <a href="/create/">
        Open creative studio <DiscoveryIcon name="arrow" size={24} />
      </a>
    </section>
  </div>
  <script>
    import '../scripts/category-directory';
  </script>
</Layout>
