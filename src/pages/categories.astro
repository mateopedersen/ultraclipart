---
import Layout from '../layouts/Layout.astro';
import CatalogCount from '../components/CatalogCount.astro';
import { catalogStatistics } from '../lib/catalog-statistics';
import DiscoveryIcon from '../components/DiscoveryIcon.astro';
import { categoryCollections, categorySubjects } from '../lib/category-directory';
import { categorySearchUrl } from '../lib/category-search-index';
import { breadcrumbs, structuredData } from '../lib/structured-data';
import '../styles/categories.css';
const total = catalogStatistics.totals.artworks;
const letters = [...new Set(categorySubjects.map((topic) => topic.name[0].toUpperCase()))].sort();
const heroSubjects = ['fox', 'strawberry', 'school', 'butterfly']
  .map((slug) => categorySubjects.find((s) => s.slug === slug))
  .filter((s) => s !== undefined)
  .slice(0, 4);
const title = 'Clipart Categories: Animals, Holidays, Baby & More';
const description = `Explore ${categorySubjects.length} clipart topics and ${total.toLocaleString('en-US')} illustrations. Browse visual collections, find a subject, and download images or printable PDFs.`;
const pageUrl = 'https://ultraclipart.com/categories/';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': pageUrl + '#page',
  url: pageUrl,
  name: title,
  description,
  inLanguage: 'en-US',
  breadcrumb: breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Clipart categories', path: '/categories/' },
  ]),
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: categorySubjects.length,
    itemListElement: categorySubjects.map((subject, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: subject.keyword,
      url: `https://ultraclipart.com/clipart/${subject.slug}/`,
    })),
  },
};
---

<Layout title={title} description={description}>
  <script slot="head" type="application/ld+json" set:html={structuredData(schema)} />
  <div class="category-discovery">
    <nav class="discovery-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Categories</span>
    </nav>
    <header class="discovery-hero">
      <div class="discovery-hero-copy">
        <p class="discovery-eyebrow">
          <img src="/illustrations/footer/explore.svg" width="44" height="44" alt="" />{' '}
          <span>The Clipart Library</span>
        </p>
        <h1>
          Explore clipart.
          <br />
          <span>Find your next idea.</span>
        </h1>
        <p class="discovery-lead">
          From playful animals to everyday essentials, discover artwork for whatever you’re making.
        </p>
        <div class="discovery-hero-bottom">
          <dl class="discovery-stats">
            <div>
              <dt>Subjects to explore</dt>
              <dd>
                <CatalogCount kind="subjects" />
              </dd>
            </div>
            <div>
              <dt>Illustrations</dt>
              <dd>
                <CatalogCount kind="artworks" />
              </dd>
            </div>
          </dl>
          <a class="discovery-collections-link" href="/collections/">
            Explore collections <DiscoveryIcon name="arrow" size={21} />
          </a>
        </div>
      </div>
      <div class="discovery-moodboard" aria-label="A few ideas to explore">
        <span class="discovery-scene-orbit" aria-hidden="true"></span>
        {heroSubjects.map((subject, index) => (
          <a
            class={`discovery-scene-card discovery-scene-card-${index + 1}`}
            href={`/clipart/${subject.slug}/`}
            aria-label={`Explore ${subject.name}`}
          >
            <img
              src={subject.sample.thumb}
              srcset={subject.sample.thumbSrcSet}
              sizes="(max-width: 700px) 100px, 155px"
              alt={subject.sample.alt}
              title={subject.sample.title}
              width="155"
              height="140"
              decoding="async"
            />
            <span>{subject.name}</span>
          </a>
        ))}
      </div>
    </header>

    <div class="discovery-layout">
      <aside class="discovery-sidebar" aria-label="Subject filters">
        <details id="discovery-controls" class="discovery-controls" open>
          <summary>
            <span class="filter-heading">
              <span class="filter-heading-icon">
                <img src="/illustrations/footer/explore.svg" width="38" height="38" alt="" />
              </span>
              <span>
                <small>Explore the library</small>
                <strong>Find your inspiration</strong>
              </span>
            </span>
            <span class="filter-toggle" aria-hidden="true">
              ⌄
            </span>
          </summary>
          <div class="discovery-filter-body">
            <form
              id="hero-topic-search"
              class="directory-query"
              action="/search/"
              role="search"
              aria-label="Find clipart subjects"
            >
              <label for="topic-filter">What would you like to create?</label>
              <div class="directory-query-input">
                <input
                  id="topic-filter"
                  name="q"
                  type="search"
                  placeholder="Animals, flowers…"
                  maxlength="160"
                  autocomplete="off"
                  aria-controls="subject-grid"
                />
                <button class="discovery-search-submit" type="submit" aria-label="Search subjects">
                  <DiscoveryIcon name="search" size={23} />
                </button>
              </div>
            </form>
            <div id="category-filters" hidden>
              <fieldset class="collection-filter">
                <legend>
                  Browse by collection{' '}
                  <span class="collection-total">{categoryCollections.length}</span>
                </legend>
                <input type="hidden" id="category-group" value="" />
                <div class="collection-filter-options">
                  <label class="collection-filter-option">
                    <input
                      type="radio"
                      name="collection-filter"
                      value=""
                      checked
                      aria-controls="subject-grid"
                    />
                    <span class="collection-filter-art all-collections-art">
                      <img src="/illustrations/footer/explore.svg" width="38" height="38" alt="" />
                    </span>
                    <span class="collection-filter-copy">
                      <span class="collection-filter-title">All collections</span>
                      <span class="collection-filter-count">
                        <CatalogCount kind="subjects" unit="subject" />
                      </span>
                    </span>
                    <span class="collection-selection" aria-hidden="true">
                      ✓
                    </span>
                  </label>
                  {categoryCollections.map((collection) => (
                    <label class="collection-filter-option">
                      <input
                        type="radio"
                        name="collection-filter"
                        value={collection.slug}
                        aria-controls="subject-grid"
                      />
                      <span class={`collection-filter-art tone-${collection.color}`}>
                        <img
                          src={collection.previews[0].thumb}
                          srcset={collection.previews[0].thumbSrcSet}
                          sizes="52px"
                          width="52"
                          height="52"
                          loading="lazy"
                          decoding="async"
                          alt=""
                          title={collection.previews[0].title}
                        />
                      </span>
                      <span class="collection-filter-copy">
                        <span class="collection-filter-title">{collection.title}</span>
                        <span class="collection-filter-count">
                          {collection.subjects.length}{' '}
                          {collection.subjects.length === 1 ? 'Subject' : 'Subjects'}
                        </span>
                      </span>
                      <span class="collection-selection" aria-hidden="true">
                        ✓
                      </span>
                    </label>
                  ))}
                </div>
              </fieldset>
              <details class="discovery-alphabet">
                <summary>
                  <span class="alphabet-symbol" aria-hidden="true">
                    Aa
                  </span>
                  <span class="alphabet-copy">
                    Browse A–Z<small>Jump to a first letter</small>
                  </span>
                  <span class="alphabet-chevron" aria-hidden="true">
                    ⌄
                  </span>
                </summary>
                <div
                  class="discovery-letters"
                  role="group"
                  aria-label="Filter subjects by first letter"
                >
                  <button type="button" data-letter="" aria-pressed="true">
                    All
                  </button>
                  {letters.map((letter) => (
                    <button
                      type="button"
                      data-letter={letter}
                      aria-pressed="false"
                      aria-label={`Subjects beginning with ${letter}`}
                    >
                      {letter}
                    </button>
                  ))}
                </div>
              </details>
            </div>
          </div>
        </details>
      </aside>

      <section
        id="topic-directory"
        class="discovery-directory"
        aria-labelledby="topic-directory-heading"
        tabindex="-1"
      >
        <div class="discovery-results-heading">
          <div>
            <h2 id="topic-directory-heading">Explore Clipart</h2>
            <p id="topic-result-count" role="status" aria-live="polite">
              {categorySubjects.length} subjects to explore
            </p>
          </div>
          <div class="directory-sort" data-directory-tools hidden>
            <label for="category-sort">Sort by</label>
            <select id="category-sort" aria-controls="subject-grid">
              <option value="name">Name: A–Z</option>
              <option value="count">Most artwork</option>
            </select>
          </div>
        </div>
        <div class="discovery-active-filters" id="active-topic-filters" hidden>
          <p id="active-topic-summary"></p>
          <button id="reset-subjects" type="button">
            Clear filters <span aria-hidden="true">×</span>
          </button>
        </div>
        <ul class="discovery-subject-grid" id="subject-grid" data-search-index={categorySearchUrl}>
          {categorySubjects.map((subject, index) => (
            <li
              class="discovery-subject"
              hidden={index >= 12}
              data-topic={subject.keyword.toLowerCase()}
              data-slug={subject.slug}
              data-group={subject.group}
              data-groups={subject.groups.join(' ')}
              data-name={subject.name}
              data-count={subject.count}
              data-letter-value={subject.name[0].toUpperCase()}
              data-keywords={`${subject.keyword} ${subject.cluster} ${subject.groups.join(' ')} ${subject.slug}`.toLowerCase()}
            >
              <a href={`/clipart/${subject.slug}/`}>
                <div class={`subject-art tone-${subject.color}`}>
                  <img
                    title={subject.sample.title}
                    src={subject.sample.thumb}
                    srcset={subject.sample.thumbSrcSet}
                    sizes="(max-width: 520px) 44vw, (max-width: 979px) 28vw, 240px"
                    alt={subject.sample.alt}
                    width="240"
                    height="190"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="subject-label">
                  <div>
                    <h3>{subject.name}</h3>
                    <span class="subject-count">
                      <CatalogCount kind="topic" countKey={subject.slug} unit="illustration" />
                    </span>
                  </div>
                  <DiscoveryIcon name="arrow" size={22} />
                </div>
              </a>
            </li>
          ))}
        </ul>
        <div id="no-topics" class="discovery-empty" hidden>
          <DiscoveryIcon name="search" size={38} />
          <h3>No matching subjects</h3>
          <p>Try a shorter search or choose another collection.</p>
          <button id="clear-topic-filter" type="button">
            Show all subjects
          </button>
        </div>
        <div class="discovery-more" id="discovery-more" hidden>
          <p id="subject-progress"></p>
          <button id="show-more-subjects" type="button">
            Show more subjects <DiscoveryIcon name="library" size={22} />
          </button>
        </div>
        <noscript>
          <style>
            #subject-grid > li[hidden] {
              display: list-item !important;
            }
          </style>
          <p class="directory-no-script">
            All available subjects are listed here. The search opens the full clipart search.
          </p>
        </noscript>
      </section>
    </div>
  </div>
  <script>
    import '../scripts/category-directory';
  </script>
</Layout>
