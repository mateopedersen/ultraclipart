---
import Layout from '../layouts/Layout.astro';
import { topics, availableTopics, availableClusters, art, slugify } from '../lib/catalog';
const sortedTopics = [...topics].sort((a, b) => a.keyword.localeCompare(b.keyword, 'en'));
const letters = [...new Set(sortedTopics.map((topic) => topic.keyword[0].toUpperCase()))].sort();
---

<Layout title="Browse Clipart Categories">
  <section class="hero category-hero">
    <p class="eyebrow">The subject directory</p>
    <h1>Find a little inspiration.</h1>
    <p class="lead">Find a subject for your next personal or classroom project.</p>
    <label for="topic-filter">Find a subject</label>
    <input
      id="topic-filter"
      type="search"
      placeholder="Try pumpkin, ghost or snowman"
      aria-controls="topic-directory"
    />
    <label class="print-check">
      <input id="include-planned" type="checkbox" /> Include planned subjects without artwork
    </label>
  </section>
  <div class="section-head">
    <h2>Explore the collections</h2>
    <a href="/new/">See available artwork →</a>
  </div>
  <div class="category-grid">
    {availableClusters.map((cluster) => {
      const members = topics.filter((topic) => topic.cluster === cluster);
      const available = art.filter((item) => members.some((topic) => topic.slug === item.topic));
      const first = available[0];
      return (
        <a class="category-card" href={`/collection/${slugify(cluster)}/`}>
          <div class:list={['category-visual', { 'category-planned': !first }]}>
            {first ? (
              <img src={first.thumb} alt="" width="200" height="155" loading="lazy" />
            ) : (
              <>
                <svg
                  class="category-symbol"
                  viewBox="0 0 64 64"
                  width="64"
                  height="64"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M10 18a5 5 0 0 1 5-5h13l6 7h15a5 5 0 0 1 5 5v23a5 5 0 0 1-5 5H15a5 5 0 0 1-5-5Z" />
                  <path d="M10 27h44M25 40h14M32 33v14" />
                </svg>
                <span class="planned-label">In preparation</span>
              </>
            )}
          </div>
          <div class="category-copy">
            <h3>
              {cluster}
              <span aria-hidden="true">↗</span>
            </h3>
            <p>
              {members.length} topics ·{' '}
              {available.length
                ? `${available.length} illustration${available.length === 1 ? '' : 's'}`
                : 'Artwork coming later'}
            </p>
          </div>
        </a>
      );
    })}
  </div>
  <section id="topic-directory" class="topic-directory" aria-labelledby="topic-directory-heading">
    <div class="section-head">
      <h2 id="topic-directory-heading">Every topic, A–Z</h2>
      <p id="topic-result-count" role="status" aria-live="polite">
        {availableTopics.length} available topics
      </p>
    </div>
    <p class="directory-intro">
      The complete subject plan is listed here. Only subjects with downloadable artwork have a link;
      planned subjects are clearly labeled.
    </p>
    <div class="az-nav" role="group" aria-label="Filter topics by first letter">
      <button data-letter="" aria-pressed="true">
        All
      </button>
      {letters.map((letter) => (
        <button
          data-letter={letter}
          aria-pressed="false"
          aria-label={`Topics beginning with ${letter}`}
        >
          {letter}
        </button>
      ))}
    </div>
    <div class="topic-groups">
      {letters.map((letter) => (
        <section
          class="topic-letter-group"
          data-topic-group={letter}
          hidden={!availableTopics.some((topic) => topic.keyword[0].toUpperCase() === letter)}
          aria-labelledby={`letter-${letter}`}
        >
          <h3 id={`letter-${letter}`}>{letter}</h3>
          <div class="topic-links">
            {sortedTopics
              .filter((topic) => topic.keyword[0].toUpperCase() === letter)
              .map((topic) =>
                art.some((item) => item.topic === topic.slug) ? (
                  <a data-topic={topic.keyword.toLowerCase()} href={`/clipart/${topic.slug}/`}>
                    <span>{topic.keyword}</span>
                    <span aria-hidden="true">→</span>
                  </a>
                ) : (
                  <span hidden class="topic-planned" data-topic={topic.keyword.toLowerCase()}>
                    <span>{topic.keyword}</span>
                    <small>Planned</small>
                  </span>
                ),
              )}
          </div>
        </section>
      ))}
    </div>
    <div id="no-topics" class="empty" hidden>
      <h3>No matching topics yet</h3>
      <p>Try a shorter search or choose another letter.</p>
      <button id="clear-topic-filter">Show all topics</button>
    </div>
  </section>
  <script>
    const input = document.querySelector<HTMLInputElement>('#topic-filter')!;
    const planned = document.querySelector<HTMLInputElement>('#include-planned')!;
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-letter]');
    let letter = '';
    function filter() {
      const query = input.value.normalize('NFKC').trim().toLowerCase();
      let count = 0;
      document.querySelectorAll<HTMLElement>('[data-topic]').forEach((link) => {
        const subject = link.dataset.topic!;
        link.hidden = !(
          (planned.checked || !link.classList.contains('topic-planned')) &&
          subject.includes(query) &&
          (!letter || subject.startsWith(letter.toLowerCase()))
        );
        if (!link.hidden) count++;
      });
      document.querySelectorAll<HTMLElement>('[data-topic-group]').forEach((group) => {
        group.hidden = !group.querySelector('[data-topic]:not([hidden])');
      });
      buttons.forEach((button) =>
        button.setAttribute('aria-pressed', String(button.dataset.letter === letter)),
      );
      document.querySelector<HTMLElement>('#no-topics')!.hidden = count > 0;
      document.querySelector<HTMLElement>('#topic-result-count')!.textContent =
        `${count} topic${count === 1 ? '' : 's'}`;
    }
    planned.addEventListener('change', () => {
      letter = '';
      filter();
    });
    input.addEventListener('input', filter);
    buttons.forEach((button) =>
      button.addEventListener('click', () => {
        letter = button.dataset.letter!;
        filter();
      }),
    );
    filter();
    document.querySelector('#clear-topic-filter')!.addEventListener('click', () => {
      input.value = '';
      letter = '';
      filter();
      input.focus();
    });
  </script>
</Layout>
