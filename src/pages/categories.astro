---
import Layout from '../layouts/Layout.astro';import {topics,clusters,art,slugify} from '../lib/catalog';
---
<Layout title="Browse Clipart Categories"><section class="hero"><h1>Find a little inspiration.</h1><p class="lead">Seasonal collections and everyday moments, all in one place.</p><label for="topic-filter">Search 110 planned topics</label><input id="topic-filter" type="search" placeholder="Try pumpkin, flowers or winter" style="display:block;width:100%;margin-top:10px"/></section><div class="category-grid">{clusters.map(c=>{const ts=topics.filter(t=>t.cluster===c);const a=art.find(a=>ts.some(t=>t.slug===a.topic));return <a class="category-card" href={`/collection/${slugify(c)}/`}><div class="category-visual">{a?<img src={a.thumb} alt="" width="200" height="155"/>:<span>{c.charAt(0)}</span>}</div><div><h3>{c} →</h3><p>{ts.length} topics · {a?'Explore pilot artwork':'Artwork in preparation'}</p></div></a>})}</div><div class="section-head"><h2>Browse A–Z</h2></div><div class="az-nav"><button data-letter="">All</button>{'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789'.split('').map(c=><button data-letter={c}>{c}</button>)}</div><div class="topic-links">{topics.map(t=><a data-topic={t.keyword.toLowerCase()} href={`/clipart/${t.slug}/`}>{t.keyword} →</a>)}</div><p id="no-topics" hidden>No topics match. Try another letter or search.</p><script>const input=document.querySelector<HTMLInputElement>('#topic-filter')!;let letter='';const filter=()=>{let n=0;document.querySelectorAll<HTMLElement>('[data-topic]').forEach(el=>{const s=el.dataset.topic!;el.hidden=!(s.includes(input.value.toLowerCase())&&(!letter||s.startsWith(letter.toLowerCase())));if(!el.hidden)n++;});document.querySelector<HTMLElement>('#no-topics')!.hidden=n>0;};input.addEventListener('input',filter);document.querySelectorAll<HTMLButtonElement>('[data-letter]').forEach(b=>b.addEventListener('click',()=>{letter=b.dataset.letter!;document.querySelectorAll('[data-letter]').forEach(el=>el.setAttribute('aria-pressed',String(el===b)));filter();}));</script></Layout>
