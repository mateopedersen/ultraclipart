---
import { imageObject } from '../../lib/image-schema';
import { downloadDetails } from '../../lib/download-data';
import { structuredData, breadcrumbs } from '../../lib/structured-data';
import Layout from '../../layouts/Layout.astro';
import RelatedArtwork from '../../components/RelatedArtwork.astro';
import Icon from '../../components/Icon.astro';
import ShareButton from '../../components/ShareButton.astro';
import ArtworkFacts from '../../components/ArtworkFacts.astro';
import ArtworkSymbol from '../../components/ArtworkSymbol.astro';
import NavigationArrow from '../../components/NavigationArrow.astro';
import { artworkDetails, formatFileSize } from '../../lib/artwork-details';
import '../../styles/artwork-detail.css';
import notes from '../../../data/artwork-notes.json';
import { art, topics } from '../../lib/catalog';
export function getStaticPaths() {
  return art.map((a) => ({ params: { id: a.id }, props: { item: a } }));
}
const { item } = Astro.props;
const note = (
  notes as Record<string, { layers: string[]; use: string; edit: string; guide: string }>
)[item.id];
if (item.layered && !note) throw new Error(`Missing source layers for ${item.id}`);
const layers = note?.layers ?? [];
const previewSrcSet = item.layered ? undefined : item.previewSrcSet;
// The image is contained in 90% of a 1.15-ratio frame. Size the actual artwork,
// including portrait letterboxing, rather than assuming the whole column is image.
const visibleFraction = 0.9 * Math.min(1, item.width / item.height / 1.15);
const previewSizes = `(max-width: 580px) calc((100vw - 34px) * ${visibleFraction}), (max-width: 1100px) 50vw, 600px`;
const topic = topics.find((t) => t.slug === item.topic)!;
const facts = artworkDetails(item);
const downloadRecord = {
  id: item.id,
  title: item.title,
  alt: item.alt,
  thumb: item.thumb,
  webp: item.webp,
  ...(item.pdf ? { pdf: item.pdf } : {}),
  download: downloadDetails(item),
};
---

<Layout
  title={/\bclipart$/i.test(item.title.trim()) ? item.title : item.title + ' Clipart'}
  description={item.description}
  noindex={!item.indexable}
  image={item.webp}
  imageAlt={item.alt}
  imageWidth={item.width}
  imageHeight={item.height}
>
  <Fragment slot="head">
    {!item.layered && (
      <link
        rel="preload"
        as="image"
        href={item.preview}
        imagesrcset={previewSrcSet}
        imagesizes={previewSizes}
        fetchpriority="high"
      />
    )}
    {item.published && item.indexable && (
      <script
        type="application/ld+json"
        set:html={structuredData(imageObject(item, { context: true, primary: true }))}
      />
    )}
    <script
      type="application/ld+json"
      set:html={structuredData(
        breadcrumbs([
          { name: 'Home', path: '/' },
          { name: topic.keyword, path: `/clipart/${topic.slug}/` },
          { name: item.title, path: `/art/${item.id}/` },
        ]),
      )}
    />
  </Fragment>
  <div class="breadcrumb">
    <a href="/">Home</a> / <a href={`/clipart/${item.topic}/`}>{topic.keyword}</a> / {item.title}
  </div>
  <div class="detail art-detail">
    <div>
      <div class="preview" id="art-preview">
        <img
          title={item.title}
          src={item.layered ? item.svg! : item.preview}
          srcset={previewSrcSet}
          sizes={previewSizes}
          alt={item.alt}
          width={item.width}
          height={item.height}
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <fieldset class="swatches art-preview-controls">
        <legend>
          Preview background <span>Find the right contrast</span>
        </legend>
        <div class="art-background-toolbar">
          <button type="button" data-bg="transparent" aria-pressed="true">
            <ArtworkSymbol name="transparent" id="backdrop-transparent" size={62} />
            <span>Transparent</span>
          </button>
          <button type="button" data-bg="#ffffff" aria-pressed="false">
            <ArtworkSymbol name="white" id="backdrop-white" size={62} />
            <span>White</span>
          </button>
          <button type="button" data-bg="#b8d8ff" aria-pressed="false">
            <ArtworkSymbol name="blue" id="backdrop-blue" size={62} />
            <span>Blue</span>
          </button>
          <button type="button" data-bg="#23344d" aria-pressed="false">
            <ArtworkSymbol name="dark" id="backdrop-dark" size={62} />
            <span>Dark</span>
          </button>
          <div class="art-custom-color" data-selected="false" data-picked="false">
            <label for="preview-color">
              <span class="art-custom-symbol" aria-hidden="true">
                <ArtworkSymbol name="palette" id="backdrop-palette" size={44} />
              </span>
              <span class="art-custom-copy">
                <strong>Custom color</strong>
                <span data-custom-label>Choose your own shade</span>
              </span>
              <span class="art-color-picker-hint" aria-hidden="true">
                Pick a shade <span>↗</span>
              </span>
              <input id="preview-color" type="color" value="#ffffff" />
            </label>
            <button type="button" data-apply-custom aria-pressed="false" hidden>
              Use color
            </button>
          </div>
        </div>
        <p>
          <span aria-hidden="true">◉</span> Preview only. Your download stays unchanged.
        </p>
      </fieldset>
    </div>
    <section>
      <p class="eyebrow">{item.layered ? 'Original illustration' : topic.keyword}</p>
      <h1>{item.title}</h1>
      <div class="art-detail-badges">
        {item.alpha && (
          <span class="art-alpha-badge">
            <ArtworkSymbol name="transparent" id="badge-alpha" size={32} />
            Transparent background
          </span>
        )}
      </div>
      <p class="art-detail-description">{item.description}</p>
      <dl class="art-detail-overview">
        <div class="art-fact art-fact-subject">
          <dt>
            <ArtworkSymbol name="subject" id="fact-subject" size={54} />
            <span>Collection</span>
          </dt>
          <dd>
            <a class="art-collection-link" href={`/clipart/${item.topic}/`}>
              <span class="art-collection-name">{topic.keyword}</span>
              <span class="art-collection-arrow" aria-hidden="true">
                <NavigationArrow size={22} variant="collection" />
              </span>
            </a>
            <small>More artwork on this subject</small>
          </dd>
        </div>
        <div class="art-fact art-fact-style">
          <dt>
            <ArtworkSymbol name="style" id="fact-style" size={54} />
            <span>Visual style</span>
          </dt>
          <dd>{facts.style}</dd>
        </div>
        <div class="art-fact art-fact-resolution">
          <dt>
            <ArtworkSymbol name="dimensions" id="fact-dimensions" size={54} />
            <span>Original resolution</span>
          </dt>
          <dd>
            <span class="art-resolution-number">
              {item.width.toLocaleString('en-US')} × {item.height.toLocaleString('en-US')}{' '}
              <span>px</span>
            </span>
            <small>Width × height · original image</small>
          </dd>
        </div>
        <div class="art-fact art-fact-formats">
          <dt>
            <ArtworkSymbol name="formats" id="fact-formats" size={54} />
            <span>Included files</span>
          </dt>
          <dd>
            <span class="art-file-types">
              <span>WebP</span>
              {item.pdf && (
                <>
                  <span class="art-file-plus">+</span>
                  <span>PDF</span>
                </>
              )}
            </span>
            <small>
              {item.pdf
                ? `${item.alpha ? 'Transparent' : 'Digital'} image + printable document. Choose either file below.`
                : 'Image for your digital projects.'}
            </small>
          </dd>
        </div>
      </dl>
      <script
        type="application/json"
        data-download-record
        data-download-id={item.id}
        set:html={structuredData(downloadRecord)}
      />
      <div class="detail-actions">
        {item.editable && (
          <a class="button primary" href={`/edit/${item.id}/`}>
            <Icon name="edit" size={18} />
            <span>Edit Clipart</span>
          </a>
        )}
        <a
          class="button download-option"
          href={item.webp}
          download={`${item.id}.webp`}
          data-download-open={item.id}
          data-download-format="webp"
          aria-expanded="false"
          aria-controls="download-dialog"
        >
          <span class="download-symbol">
            <Icon name="image" size={22} />
          </span>
          <span class="download-copy">
            <strong>Download Image</strong>
            <small>
              {item.alpha ? 'Transparent image for digital projects' : 'Image for digital projects'}
            </small>
          </span>
          <span
            class="download-size"
            title={`${item.files.webp.bytes.toLocaleString('en-US')} bytes`}
          >
            <small>File size: </small>
            <strong>{formatFileSize(item.files.webp.bytes)}</strong>
          </span>
          <Icon name="download" size={18} />
        </a>
        {item.pdf && (
          <a
            class="button download-option"
            href={item.pdf}
            download={`${item.id}.pdf`}
            data-download-open={item.id}
            data-download-format="pdf"
            aria-expanded="false"
            aria-controls="download-dialog"
          >
            <span class="download-symbol">
              <Icon name="document" size={22} />
            </span>
            <span class="download-copy">
              <strong>Download PDF</strong>
              <small>Printable document · {item.pdfPage}</small>
            </span>
            <span
              class="download-size"
              title={`${item.files.pdf.bytes.toLocaleString('en-US')} bytes`}
            >
              <small>File size: </small>
              <strong>{formatFileSize(item.files.pdf.bytes)}</strong>
            </span>
            <Icon name="download" size={18} />
          </a>
        )}
      </div>
      <button
        data-favorite={item.id}
        data-favorite-title={item.title}
        data-favorite-thumb={item.thumb}
        aria-pressed="false"
        style="width:100%"
      >
        ♡ Add to Favorites
      </button>
      <p id="favorite-status" role="status" aria-live="polite" hidden></p>
      <ShareButton item={item} />
      <p class="notice">
        Free for personal and educational use. No commercial use or resale as clipart.{' '}
        <a href="/license/">License details →</a>
        <span class="art-image-credit">
          Published by UltraClipart. Rights in protectable contributions reserved; third-party
          rights remain with their owners.
        </span>
      </p>
      {item.layered && (
        <p class="notice">
          Changing the preview background does not change the original download; use the editor to
          export your changes.
        </p>
      )}
    </section>
  </div>
  <RelatedArtwork sourceId={item.id} />
  <ArtworkFacts item={item} layers={layers} />
  <script>
    import { initArtDetail } from '../../scripts/art-detail';
    initArtDetail();
  </script>
</Layout>
