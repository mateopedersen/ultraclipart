---
import { structuredData, breadcrumbs } from '../../lib/structured-data';
import Layout from '../../layouts/Layout.astro';
import Card from '../../components/Card.astro';
import Icon from '../../components/Icon.astro';
import notes from '../../../data/artwork-notes.json';
import { art, topics } from '../../lib/catalog';
export function getStaticPaths() {
  return art.map((a) => ({ params: { id: a.id }, props: { item: a } }));
}
const { item } = Astro.props;
const note = (
  notes as Record<string, { layers: string[]; use: string; edit: string; guide: string }>
)[item.id];
if (item.layered && !note) throw new Error(`Missing source layers for ${item.id}`);
const layers = note?.layers ?? [];
const topic = topics.find((t) => t.slug === item.topic)!;
---

<Layout
  title={item.title + ' Clipart'}
  description={item.description}
  noindex={!item.indexable}
  image={item.webp}
  imageAlt={item.alt}
>
  <Fragment slot="head">
    {item.published && item.indexable && (
      <script
        type="application/ld+json"
        set:html={structuredData({
          '@context': 'https://schema.org',
          '@type': 'ImageObject',
          name: item.title,
          description: item.description,
          contentUrl: new URL(item.webp, 'https://ultraclipart.com').href,
          thumbnailUrl: new URL(item.thumb, 'https://ultraclipart.com').href,
          encodingFormat: 'image/webp',
          width: item.width,
          height: item.height,
          license: 'https://ultraclipart.com/license/',
          acquireLicensePage: 'https://ultraclipart.com/license/',
          creditText: 'UltraClipart',
        })}
      />
    )}
    <script
      type="application/ld+json"
      set:html={structuredData(
        breadcrumbs([
          { name: 'Home', path: '/' },
          { name: topic.keyword, path: `/clipart/${topic.slug}/` },
          { name: item.title, path: `/art/${item.id}/` },
        ]),
      )}
    />
  </Fragment>
  <div class="breadcrumb">
    <a href="/">Home</a> / <a href={`/clipart/${item.topic}/`}>{topic.keyword}</a> / {item.title}
  </div>
  <div class="detail">
    <div>
      <div class="preview" id="art-preview">
        <img
          src={item.layered ? item.svg! : item.webp}
          alt={item.alt}
          width={item.width}
          height={item.height}
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <div class="swatches" aria-label="Preview background">
        <button data-bg="transparent">▦ Transparent</button>
        <button data-bg="#ffffff">White</button>
        <button data-bg="#e6eff9">Soft blue</button>
        <label>
          Custom{' '}
          <input
            aria-label="Custom preview background"
            id="preview-color"
            type="color"
            value="#f0f5f1"
          />
        </label>
      </div>
    </div>
    <section>
      <p class="eyebrow">{item.layered ? 'Original illustration' : topic.keyword}</p>
      <h1>{item.title}</h1>
      <p>{item.description}</p>
      <div class="metadata">
        <div>
          <small>Topic</small>
          <a href={`/clipart/${item.topic}/`}>{topic.keyword}</a>
        </div>
        <div>
          <small>Style</small>
          {item.style}
        </div>
        <div>
          <small>WebP dimensions</small>
          {item.width} × {item.height}
        </div>
        <div>
          <small>{item.layered ? 'Source' : 'Downloads'}</small>
          {item.layered ? 'Editable layered vector' : 'Editable image layer'}
        </div>
      </div>
      <div class="detail-actions">
        {item.editable && (
          <a class="button primary" href={`/edit/${item.id}/`}>
            <Icon name="edit" size={18} />
            <span>Edit Clipart</span>
          </a>
        )}
        <a class="button download-option" href={item.webp} download={`${item.id}.webp`}>
          <span class="download-symbol">
            <Icon name="image" size={22} />
          </span>
          <span class="download-copy">
            <strong>Download Image</strong>
            <small>Transparent background</small>
          </span>
          <Icon name="download" size={18} />
        </a>
        {item.pdf && (
          <a class="button download-option" href={item.pdf} download={`${item.id}.pdf`}>
            <span class="download-symbol">
              <Icon name="document" size={22} />
            </span>
            <span class="download-copy">
              <strong>Download PDF</strong>
              <small>Print-ready file</small>
            </span>
            <Icon name="download" size={18} />
          </a>
        )}
      </div>
      <button data-favorite={item.id} aria-pressed="false" style="width:100%">
        ♡ Add to Favorites
      </button>
      <p id="favorite-status" role="status" aria-live="polite" hidden></p>
      <p class="notice">
        Free for personal and educational use. No commercial use or resale as clipart.{' '}
        <a href="/license/">License details →</a>
      </p>
      {item.layered && (
        <p class="notice">
          Changing the preview background does not change the original download; use the editor to
          export your changes.
        </p>
      )}
    </section>
  </div>
  <section class="asset-facts" aria-label="Download details">
    <h2>Inside this download</h2>
    <dl>
      {item.layered && (
        <>
          <dt>Editable source</dt>
          <dd>{layers.length} named layers</dd>
        </>
      )}
      <dt>WebP</dt>
      <dd>
        {item.width.toLocaleString('en-US')} × {item.height.toLocaleString('en-US')} pixels ·{' '}
        {item.files.webp.bytes.toLocaleString('en-US')} bytes
      </dd>
      <dt>PDF</dt>
      <dd>
        {item.pdfPage} · {item.pdfColorSpace} · {item.files.pdf.bytes.toLocaleString('en-US')} bytes
      </dd>
      <dt>Print color</dt>
      <dd>{item.printProfile}</dd>
    </dl>
    {item.layered && (
      <details>
        <summary>See the editable layers</summary>
        <ul>
          {layers.map((layer) => (
            <li>{layer}</li>
          ))}
        </ul>
      </details>
    )}
    <p>
      <a href="/print-size/">Check a raster print size</a> or{' '}
      <a href="/guides/webp-pdf-and-editable-projects/">compare the file formats</a>.
    </p>
  </section>
  <div class="section-head">
    <h2>A little more inspiration</h2>
    <a href="/new/">Explore all →</a>
  </div>
  <div class="gallery">
    {art
      .filter((a) => a.id !== item.id)
      .sort((a, b) => Number(b.topic === item.topic) - Number(a.topic === item.topic))
      .slice(0, 5)
      .map((item) => (
        <Card item={item} />
      ))}
  </div>
  <script>
    import { initArtDetail } from '../../scripts/art-detail';
    initArtDetail();
  </script>
</Layout>
