---
import Layout from '../../layouts/Layout.astro';import Card from '../../components/Card.astro';import {art,topics} from '../../lib/catalog';
export function getStaticPaths(){return art.map(a=>({params:{id:a.id},props:{item:a}}));}const {item}=Astro.props;const topic=topics.find(t=>t.slug===item.topic)!;
---
<Layout title={item.title+' Clipart'} description={item.description} noindex={true}><div class="breadcrumb"><a href="/">Home</a> / <a href={`/clipart/${item.topic}/`}>{topic.keyword}</a> / {item.title}</div><div class="detail"><div><div class="preview" id="art-preview"><img src={item.webp} alt={item.alt} width={item.width} height={item.height}/></div><div class="swatches" aria-label="Preview background"><button data-bg="transparent">▦ Transparent</button><button data-bg="#ffffff">White</button><button data-bg="#e6eff9">Soft blue</button><label>Custom <input aria-label="Custom preview background" id="preview-color" type="color" value="#f0f5f1"/></label></div></div><section><p class="eyebrow">Original pilot illustration</p><h1>{item.title}</h1><p>{item.description}</p><div class="metadata"><div><small>Topic</small><a href={`/clipart/${item.topic}/`}>{topic.keyword}</a></div><div><small>Style</small>{item.style}</div><div><small>WebP dimensions</small>{item.width} × {item.height}</div><div><small>Source</small>Editable layered vector</div></div><div class="detail-actions"><a class="button primary" href={`/edit/${item.id}/`}>✎ Edit Clipart</a><a class="button" href={item.webp} download>↓ Download WebP</a>{item.pdf&&<a class="button" href={item.pdf} download>↓ Download PDF</a>}</div><button data-favorite={item.id} aria-pressed="false" style="width:100%">♡ Add to Favorites</button><p class="notice">Free for personal and educational use. No commercial use or resale as clipart. <a href="/license/">License details →</a></p><small>{item.provenance}</small><p class="notice">Pilot artwork: visual quality review is ongoing. Changing the preview background does not change the original download; use the editor to export your changes.</p></section></div><div class="section-head"><h2>A little more inspiration</h2><a href="/new/">Explore all →</a></div><div class="gallery">{art.filter(a=>a.id!==item.id).slice(0,5).map(item=><Card item={item}/>)}</div><script>const p=document.querySelector<HTMLElement>('#art-preview')!;const bg=(c:string)=>{p.style.background=c==='transparent'?'':c;};document.querySelectorAll<HTMLButtonElement>('[data-bg]').forEach(b=>b.addEventListener('click',()=>bg(b.dataset.bg!)));document.querySelector<HTMLInputElement>('#preview-color')?.addEventListener('input',e=>bg((e.target as HTMLInputElement).value));const b=document.querySelector<HTMLButtonElement>('[data-favorite]')!;let list:string[]=[];try{list=JSON.parse(localStorage.getItem('ultraclipart-favorites')||'[]');}catch{}const render=()=>{const yes=list.includes(b.dataset.favorite!);b.setAttribute('aria-pressed',String(yes));b.textContent=yes?'♥ Saved to Favorites':'♡ Add to Favorites';};render();b.addEventListener('click',()=>{const id=b.dataset.favorite!;list=list.includes(id)?list.filter(x=>x!==id):[...list,id];try{localStorage.setItem('ultraclipart-favorites',JSON.stringify(list));}catch{}render();});</script></Layout>
