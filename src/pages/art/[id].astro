---
import { structuredData, breadcrumbs } from '../../lib/structured-data';
import Layout from '../../layouts/Layout.astro';
import Card from '../../components/Card.astro';
import Icon from '../../components/Icon.astro';
import ShareButton from '../../components/ShareButton.astro';
import ArtworkFacts from '../../components/ArtworkFacts.astro';
import { artworkDetails, formatFileSize } from '../../lib/artwork-details';
import '../../styles/artwork-detail.css';
import notes from '../../../data/artwork-notes.json';
import { art, topics } from '../../lib/catalog';
export function getStaticPaths() {
  return art.map((a) => ({ params: { id: a.id }, props: { item: a } }));
}
const { item } = Astro.props;
const note = (
  notes as Record<string, { layers: string[]; use: string; edit: string; guide: string }>
)[item.id];
if (item.layered && !note) throw new Error(`Missing source layers for ${item.id}`);
const layers = note?.layers ?? [];
const topic = topics.find((t) => t.slug === item.topic)!;
const facts = artworkDetails(item);
---

<Layout
  title={item.title + ' Clipart'}
  description={item.description}
  noindex={!item.indexable}
  image={item.webp}
  imageAlt={item.alt}
>
  <Fragment slot="head">
    {item.published && item.indexable && (
      <script
        type="application/ld+json"
        set:html={structuredData({
          '@context': 'https://schema.org',
          '@type': 'ImageObject',
          name: item.title,
          description: item.description,
          contentUrl: new URL(item.webp, 'https://ultraclipart.com').href,
          thumbnailUrl: new URL(item.thumb, 'https://ultraclipart.com').href,
          encodingFormat: 'image/webp',
          width: item.width,
          height: item.height,
          license: 'https://ultraclipart.com/license/',
          acquireLicensePage: 'https://ultraclipart.com/license/',
          creditText: 'UltraClipart',
        })}
      />
    )}
    <script
      type="application/ld+json"
      set:html={structuredData(
        breadcrumbs([
          { name: 'Home', path: '/' },
          { name: topic.keyword, path: `/clipart/${topic.slug}/` },
          { name: item.title, path: `/art/${item.id}/` },
        ]),
      )}
    />
  </Fragment>
  <div class="breadcrumb">
    <a href="/">Home</a> / <a href={`/clipart/${item.topic}/`}>{topic.keyword}</a> / {item.title}
  </div>
  <div class="detail art-detail">
    <div>
      <div class="preview" id="art-preview">
        <img
          src={item.layered ? item.svg! : item.webp}
          alt={item.alt}
          width={item.width}
          height={item.height}
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <fieldset class="swatches art-preview-controls">
        <legend>Preview background</legend>
        <button type="button" data-bg="transparent" aria-pressed="true">
          <span class="art-color-chip art-checker" aria-hidden="true"></span>Transparent
        </button>
        <button type="button" data-bg="#ffffff" aria-pressed="false">
          <span class="art-color-chip art-white" aria-hidden="true"></span>White
        </button>
        <button type="button" data-bg="#e6eff9" aria-pressed="false">
          <span class="art-color-chip art-blue" aria-hidden="true"></span>Soft blue
        </button>
        <label class="art-custom-color" data-selected="false">
          <input
            aria-label="Custom preview background"
            id="preview-color"
            type="color"
            value="#f0f5f1"
          />
          <span>Custom</span>
        </label>
        <p>Preview only — your download stays unchanged.</p>
      </fieldset>
    </div>
    <section>
      <p class="eyebrow">{item.layered ? 'Original illustration' : topic.keyword}</p>
      <h1>{item.title}</h1>
      <div class="art-detail-badges">
        {item.alpha && (
          <span>
            <Icon name="background" size={15} />
            Transparent background
          </span>
        )}
        {facts.aiGenerated && (
          <span class="art-ai-badge">
            <Icon name="image" size={15} />
            AI-generated artwork
          </span>
        )}
      </div>
      <p class="art-detail-description">{item.description}</p>
      <dl class="art-detail-overview">
        <div>
          <dt>Explore the subject</dt>
          <dd>
            <a href={`/clipart/${item.topic}/`}>{topic.keyword}</a>
          </dd>
        </div>
        <div>
          <dt>Illustration style</dt>
          <dd>{facts.style}</dd>
        </div>
        <div>
          <dt>Image resolution</dt>
          <dd>
            {item.width.toLocaleString('en-US')} × {item.height.toLocaleString('en-US')} px
          </dd>
        </div>
        <div>
          <dt>Included files</dt>
          <dd>{item.pdf ? 'WebP image + printable PDF' : 'WebP image'}</dd>
        </div>
      </dl>
      <div class="detail-actions">
        {item.editable && (
          <a class="button primary" href={`/edit/${item.id}/`}>
            <Icon name="edit" size={18} />
            <span>Edit Clipart</span>
          </a>
        )}
        <a class="button download-option" href={item.webp} download={`${item.id}.webp`}>
          <span class="download-symbol">
            <Icon name="image" size={22} />
          </span>
          <span class="download-copy">
            <strong>Download WebP</strong>
            <small>
              {item.alpha ? 'Transparent image' : 'Image file'} ·{' '}
              {formatFileSize(item.files.webp.bytes)}
            </small>
          </span>
          <Icon name="download" size={18} />
        </a>
        {item.pdf && (
          <a class="button download-option" href={item.pdf} download={`${item.id}.pdf`}>
            <span class="download-symbol">
              <Icon name="document" size={22} />
            </span>
            <span class="download-copy">
              <strong>Download PDF</strong>
              <small>
                {item.pdfPage} · {formatFileSize(item.files.pdf.bytes)}
              </small>
            </span>
            <Icon name="download" size={18} />
          </a>
        )}
      </div>
      <button data-favorite={item.id} aria-pressed="false" style="width:100%">
        ♡ Add to Favorites
      </button>
      <p id="favorite-status" role="status" aria-live="polite" hidden></p>
      <ShareButton item={item} />
      <p class="notice">
        Free for personal and educational use. No commercial use or resale as clipart.{' '}
        <a href="/license/">License details →</a>
      </p>
      {item.layered && (
        <p class="notice">
          Changing the preview background does not change the original download; use the editor to
          export your changes.
        </p>
      )}
    </section>
  </div>
  <ArtworkFacts item={item} layers={layers} />
  <div class="section-head">
    <h2>A little more inspiration</h2>
    <a href="/new/">Explore all →</a>
  </div>
  <div class="gallery">
    {art
      .filter((a) => a.id !== item.id)
      .sort((a, b) => Number(b.topic === item.topic) - Number(a.topic === item.topic))
      .slice(0, 5)
      .map((item) => (
        <Card item={item} />
      ))}
  </div>
  <script>
    import { initArtDetail } from '../../scripts/art-detail';
    initArtDetail();
  </script>
</Layout>
