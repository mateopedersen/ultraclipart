---
import Layout from '../../layouts/Layout.astro';
import Editor from '../../components/Editor.astro';
import { art } from '../../lib/catalog';
export function getStaticPaths() {
  return art.map((item) => ({ params: { id: item.id }, props: { item } }));
}
const { item } = Astro.props;
---

<Layout
  title={`Edit ${item.title}`}
  noindex={true}
  wide={true}
  image={item.webp}
  imageAlt={item.alt}
  imageWidth={item.width}
  imageHeight={item.height}
>
  <Fragment slot="head">
    {item.sourceType === 'raster' && item.preview?.startsWith('/previews/') && (
      <link rel="preload" as="image" href={item.preview} fetchpriority="high" />
    )}
    {item.sourceType === 'raster' && (
      <script
        id="editor-original-source"
        type="application/json"
        set:html={JSON.stringify({ url: item.webp, ...item.files.webp }).replaceAll('<', '\\u003c')}
      />
    )}
    <script>
      import { prefetchVerified } from '../../editor/verified-fetch';
      import { editorPreviewReady } from '../../editor/preview-ready';
      const record = document.getElementById('editor-original-source');
      if (record?.textContent) {
        try {
          prefetchVerified(
            JSON.parse(record.textContent),
            'webp',
            location.origin,
            editorPreviewReady(),
          );
        } catch {
          /* The editor repeats source validation and shows the error. */
        }
      }
    </script>
  </Fragment>
  <Editor art={item} />
</Layout>
