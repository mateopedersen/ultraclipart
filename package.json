    "astro": "7.4.2",
    "jspdf": "4.2.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "sharp": "0.35.5",
    "typescript": "6.0.2",
    "wrangler": "4.151.3"
  },
  "packageManager": "pnpm@11.25.0"
}
