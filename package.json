{
  "name": "ultraclipart",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "content:audit": "node scripts/artwork-editorial.mjs",
    "dev": "astro dev --host 127.0.0.1",
    "build": "node scripts/restore-assets.mjs && node scripts/verify-social-images.mjs && astro build && node scripts/security-headers.mjs",
    "social:build": "node scripts/build-social-images.mjs",
    "social:check": "node scripts/verify-social-images.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check": "node scripts/restore-assets.mjs && astro check",
    "test": "node --test tests/*.mjs",
    "test:release": "node --test --test-concurrency=2 tests/catalog.mjs tests/csp.mjs tests/publication.mjs tests/retired-routes.mjs",
    "deploy": "node scripts/deploy.mjs",
    "format": "prettier --write \"src/**/*.{astro,ts,css}\" \"tests/**/*.mjs\" \"scripts/**/*.mjs\" \"server/**/*.mjs\" astro.config.mjs",
    "format:check": "prettier --check \"src/**/*.{astro,ts,css}\" \"tests/**/*.mjs\" \"scripts/**/*.mjs\" \"server/**/*.mjs\" astro.config.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.8",
    "@jsquash/webp": "1.5.0",
    "astro": "7.4.2",
    "jspdf": "4.2.1",
    "pako": "2.2.0",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/pako": "2.0.4",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "sharp": "0.35.5",
    "typescript": "6.0.2",
    "wrangler": "4.151.3"
  },
  "packageManager": "pnpm@11.25.0"
}
