{
  "name": "ultraclipart",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "content:audit": "node scripts/reviewed-imports.mjs",
    "content:review": "node scripts/prepare-editorial-review.mjs",
    "content:apply": "node scripts/apply-editorial-review.mjs",
    "dev": "astro dev --host 127.0.0.1",
    "build": "node scripts/seo/check-catalog.mjs && node scripts/restore-assets.mjs && node scripts/verify-social-images.mjs && astro build && node scripts/seo/audit-image-metadata.mjs && node scripts/security-headers.mjs",
    "social:build": "node scripts/build-social-images.mjs",
    "social:check": "node scripts/verify-social-images.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check": "node scripts/restore-assets.mjs && astro check",
    "test": "node --test tests/*.mjs",
    "test:release": "node --test --test-concurrency=2 tests/catalog.mjs tests/csp.mjs tests/publication.mjs tests/retired-routes.mjs",
    "deploy": "node scripts/deploy.mjs",
    "format": "prettier --write \"src/**/*.{astro,ts,css}\" \"tests/**/*.mjs\" \"scripts/**/*.mjs\" \"server/**/*.mjs\" astro.config.mjs",
    "format:check": "prettier --check \"src/**/*.{astro,ts,css}\" \"tests/**/*.mjs\" \"scripts/**/*.mjs\" \"server/**/*.mjs\" astro.config.mjs",
    "test:layout": "node tests/e2e/layout-audit.mjs",
    "test:layout:states": "node tests/e2e/layout-states.mjs",
    "test:layout:regressions": "node tests/e2e/layout-regressions.mjs",
    "test:responsive:controls": "node tests/e2e/responsive-controls.mjs",
    "test:responsive:search": "node tests/e2e/mobile-search-navigation.mjs",
    "test:responsive:categories": "node tests/e2e/category-collections.mjs",
    "test:favorites:workspace": "node --test tests/favorite-boards.mjs tests/favorites-workspace.mjs",
    "test:e2e:favorites-workspace": "node tests/e2e/favorites-workspace.mjs",
    "test:e2e:brand-accents": "node tests/e2e/brand-accents.mjs",
    "seo:assets:prepare": "node scripts/seo/prepare-assets-robots.mjs",
    "seo:assets:audit": "node scripts/seo/audit-assets-indexing.mjs",
    "test:collection-navigation": "node --test tests/collection-navigation.mjs",
    "test:e2e:collection-navigation": "node tests/e2e/collection-navigation.mjs",
    "test:e2e:image-metadata": "node tests/e2e/image-metadata.mjs",
    "seo:catalog:check": "node scripts/seo/check-catalog.mjs",
    "seo:images:audit": "node scripts/seo/audit-image-metadata.mjs",
    "test:e2e:library-index": "node tests/e2e/library-index.mjs",
    "test:e2e:editorial": "node tests/e2e/editorial-process.mjs",
    "test:e2e:not-found": "node tests/e2e/not-found.mjs",
    "test:e2e:contact": "node tests/e2e/contact.mjs",
    "test:e2e:image-information": "node tests/e2e/image-information.mjs",
    "performance:build": "node scripts/performance/build.mjs",
    "performance:serve": "node scripts/performance/serve.mjs",
    "performance:audit": "node scripts/performance/audit-built.mjs",
    "performance:lighthouse": "node scripts/performance/lighthouse.mjs",
    "test:performance": "node --test tests/preview-assets.mjs tests/screen-previews.mjs tests/verified-fetch.mjs tests/cookie-startup.mjs",
    "test:performance:browser": "node tests/e2e/performance-regressions.mjs && node tests/e2e/performance-layout.mjs && node tests/e2e/mobile-performance.mjs",
    "seo:images:full": "node scripts/seo/audit-image-seo.mjs",
    "test:e2e:image-seo": "node tests/e2e/image-seo.mjs",
    "test:e2e:spacing": "node tests/e2e/spacing.mjs",
    "test:spacing:built": "node scripts/seo/audit-spacing-build.mjs",
    "seo:links:audit": "node scripts/seo/audit-link-graph.mjs",
    "seo:links:external": "node scripts/seo/audit-external-links.mjs",
    "test:e2e:linking": "node tests/e2e/linking.mjs",
    "test:e2e:collection-arrows": "node tests/e2e/collection-arrows.mjs",
    "test:collection-layout:built": "node scripts/seo/audit-collection-layout.mjs",
    "test:e2e:related-rows": "node tests/e2e/related-rows.mjs",
    "icons:build": "node scripts/build-site-icons.mjs",
    "seo:core:audit": "node scripts/seo/audit-core-seo.mjs",
    "seo:core:report": "node scripts/seo/report-core-seo.mjs",
    "test:e2e:seo-core": "node tests/e2e/core-seo.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.8",
    "@jsquash/webp": "1.5.0",
    "astro": "7.4.2",
    "jspdf": "4.2.1",
    "pako": "2.2.0",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/pako": "2.0.4",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "sharp": "0.35.5",
    "typescript": "6.0.2",
    "wrangler": "4.151.3"
  },
  "packageManager": "pnpm@11.25.0"
}
